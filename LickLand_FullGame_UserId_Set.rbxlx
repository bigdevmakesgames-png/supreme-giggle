<?xml version='1.0' encoding='utf-8'?>
<roblox version="4">
  <External null="true" />
  <External null="true" />
  <Item class="DataModel" referent="RBX0">
    <Item class="Workspace" referent="RBX1">
      <Properties>
        <string name="Name">Workspace</string>
      </Properties>
    </Item>
    <Item class="ReplicatedStorage" referent="RBX2">
      <Properties>
        <string name="Name">ReplicatedStorage</string>
      </Properties>
    </Item>
    <Item class="ServerScriptService" referent="RBX3">
      <Properties>
        <string name="Name">ServerScriptService</string>
      </Properties>
      <Item class="Script" referent="RBX10">
        <Properties>
          <string name="Name">LickMain</string>
          <ProtectedString name="Source">-- LICK MAIN (server Script)  Location: ServerScriptService &gt; LickMain
-- THE MASTER SCRIPT. It starts first and builds everything the other scripts wait for:
--   ReplicatedStorage &gt; LickRemotes (all remotes),  LickBootLog,  ServerStorage &gt; LickBus (internal events).
-- About 10 seconds after Play it also CHECKS that every other Lick script is installed correctly and shows you a report
-- on screen and in Output. (The other scripts are safe too: if this one is missing, LickData builds the same things.)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local StarterPlayer = game:GetService("StarterPlayer")

local function ensure(parent, class, name)
	local o = parent:FindFirstChild(name)
	if not o then
		o = Instance.new(class)
		o.Name = name
		o.Parent = parent
	end
	return o
end

ensure(ReplicatedStorage, "StringValue", "LickBootLog")
local remotes = ensure(ReplicatedStorage, "Folder", "LickRemotes")
for _, n in ipairs({ "Notify", "Eat", "LickFx", "Celebrate", "Reveal", "BuyTongue", "BuyUpgrade", "BuySkin", "Rebirth", "Free", "OpenShop", "ToggleAuto", "Teleport", "EquipCosmetic", "TutorialAction", "QuestClaim", "ClaimLogin", "SaveSettings", "LickNearest" }) do
	ensure(remotes, "RemoteEvent", n)
end
for _, n in ipairs({ "RedeemCode", "BoardData", "BuyGooPass", "AdminAction", "AdminInfo" }) do
	ensure(remotes, "RemoteFunction", n)
end
local bus = ensure(ServerStorage, "Folder", "LickBus")
for _, n in ipairs({ "Stat", "Grant", "Spent" }) do ensure(bus, "BindableEvent", n) end
ensure(bus, "BindableFunction", "SaveNow")
print("[LickMain] remotes and bus are ready")

-- ===== install check =====
local SERVER = { "LickData", "LickConfig", "LickCore", "LickItems", "LickWorld", "LickProgress", "LickShop", "LickRewards", "LickPasses", "LickQuests", "LickBoards", "LickAdmin", "LickStands" }
local CLIENT = { "LickAudio", "LickUI", "LickControls", "LickTongue", "LickFood", "LickCelebrate", "LickRoll", "LickPanels", "LickPassUI", "LickQuestUI", "LickMenus", "LickAdminUI", "LickTutorial", "LickAmbient" }

task.wait(10)
local problems = {}
for _, n in ipairs(SERVER) do
	local s = ServerScriptService:FindFirstChild(n)
	if not s then
		problems[#problems + 1] = n .. " is MISSING from ServerScriptService"
	elseif not s:IsA("Script") then
		problems[#problems + 1] = n .. " must be a Script (it is a " .. s.ClassName .. ")"
	elseif s.Disabled then
		problems[#problems + 1] = n .. " is DISABLED"
	end
end
local sps = StarterPlayer:FindFirstChild("StarterPlayerScripts")
for _, n in ipairs(CLIENT) do
	local s = sps and sps:FindFirstChild(n)
	if not s then
		problems[#problems + 1] = n .. " is MISSING from StarterPlayer &gt; StarterPlayerScripts"
	elseif not s:IsA("LocalScript") then
		problems[#problems + 1] = n .. " must be a LocalScript (it is a " .. s.ClassName .. ")"
	end
end
if not ReplicatedStorage:FindFirstChild("LickConfig") then problems[#problems + 1] = "LickConfig did not run (no economy numbers). Read the first RED error in Output." end
local w = workspace:FindFirstChild("LickWorld")
if not w or not w:FindFirstChild("Lickables") then problems[#problems + 1] = "The world/food was not built. Check LickWorld and LickItems in Output." end
local log = ReplicatedStorage:FindFirstChild("LickBootLog")
if log and log.Value ~= "" then problems[#problems + 1] = "Server warning: " .. string.sub(log.Value, 1, 120) end

local report = #problems == 0 and "ALL OK: every Lick script is installed and the game started." or table.concat(problems, "\n")
print("[LickMain] CHECK\n" .. report)

local function show(plr)
	local g = Instance.new("ScreenGui")
	g.Name = "LickMainReport"
	g.ResetOnSpawn = false
	g.DisplayOrder = 400
	g.Parent = plr:WaitForChild("PlayerGui")
	local t = Instance.new("TextButton")
	t.Size = UDim2.new(0.86, 0, 0.6, 0)
	t.Position = UDim2.new(0.07, 0, 0.2, 0)
	t.BackgroundColor3 = #problems == 0 and Color3.fromRGB(20, 110, 50) or Color3.fromRGB(130, 20, 20)
	t.TextColor3 = Color3.new(1, 1, 1)
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.TextWrapped = true
	t.Text = "LICK MAIN REPORT (tap to close)\n" .. report
	t.Parent = g
	t.Activated:Connect(function() g:Destroy() end)
	if #problems == 0 then task.delay(6, function() if g.Parent then g:Destroy() end end) end
end
for _, p in ipairs(Players:GetPlayers()) do task.spawn(show, p) end
Players.PlayerAdded:Connect(show)
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX11">
        <Properties>
          <string name="Name">LickData</string>
          <ProtectedString name="Source">-- LICK DATA (server Script)  Location: ServerScriptService &gt; LickData
-- The foundation: creates the remotes, player values, and SAVES / LOADS everything safely.
-- Safe loading: if your data cannot be loaded the player is kicked (so empty data never overwrites real data).
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local PhysicsService = game:GetService("PhysicsService")

local STORE_NAME = "LickLandData_v1"
local AUTOSAVE_SECONDS = 70

local function ensure(parent, class, name)
	local o = parent:FindFirstChild(name)
	if not o then
		o = Instance.new(class)
		o.Name = name
		o.Parent = parent
	end
	return o
end
local bootLog = ensure(ReplicatedStorage, "StringValue", "LickBootLog")
local remotes = ensure(ReplicatedStorage, "Folder", "LickRemotes")
for _, n in ipairs({ "Notify", "Eat", "LickFx", "Celebrate", "Reveal", "BuyTongue", "BuyUpgrade", "BuySkin", "Rebirth", "Free", "OpenShop", "ToggleAuto", "Teleport", "EquipCosmetic", "TutorialAction", "QuestClaim", "ClaimLogin", "SaveSettings", "LickNearest" }) do
	ensure(remotes, "RemoteEvent", n)
end
for _, n in ipairs({ "RedeemCode", "BoardData", "BuyGooPass", "AdminAction", "AdminInfo" }) do
	ensure(remotes, "RemoteFunction", n)
end
local bus = ensure(ServerStorage, "Folder", "LickBus")
for _, n in ipairs({ "Stat", "Grant", "Spent" }) do ensure(bus, "BindableEvent", n) end
local saveNow = ensure(bus, "BindableFunction", "SaveNow")

-- zone lock player groups (walls are made by LickWorld)
for t = 1, 8 do
	pcall(function() PhysicsService:RegisterCollisionGroup("Tier_" .. t) end)
	pcall(function() PhysicsService:RegisterCollisionGroup("Barrier_" .. t) end)
end
for t = 2, 8 do
	for k = 1, 8 do
		pcall(function() PhysicsService:CollisionGroupSetCollidable("Barrier_" .. t, "Tier_" .. k, k &lt; t) end)
	end
end

local store = DataStoreService:GetDataStore(STORE_NAME)
local SESSION = game.JobId
if SESSION == "" then SESSION = "studio" .. tostring(math.random(1, 1000000)) end

-- attributes that are saved (name -&gt; kind)
local ATTRS = { SpeedLvl = "n", LickSpeedLvl = "n", LuckyLvl = "n", FreeRolls = "n", BoostUntil = "n", TongueColor = "c", Century = "b", CosTrail = "s", CosAura = "s", CosTitle = "s", CosBurst = "s", CosGlow = "s", CosSkin = "s" }

local function serialize(plr)
	local d = { v = 1, t = os.time(), stats = {}, st = {}, at = {} }
	local ls = plr:FindFirstChild("leaderstats")
	if ls then
		for _, c in ipairs(ls:GetChildren()) do d.stats[c.Name] = c.Value end
	end
	local sf = plr:FindFirstChild("LickState")
	if sf then
		for _, c in ipairs(sf:GetChildren()) do d.st[c.Name] = { c.ClassName, c.Value } end
	end
	for name, kind in pairs(ATTRS) do
		local v = plr:GetAttribute(name)
		if v ~= nil then
			if kind == "c" then d.at[name] = { v.R, v.G, v.B } else d.at[name] = v end
		end
	end
	return d
end

local function stateFolder(plr)
	local f = plr:FindFirstChild("LickState")
	if not f then
		f = Instance.new("Folder")
		f.Name = "LickState"
		f.Parent = plr
	end
	return f
end

local function setup(plr)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	ls.Parent = plr
	for _, info in ipairs({ { "Goo", "NumberValue", 0 }, { "Licks", "IntValue", 0 }, { "Tongue", "IntValue", 1 }, { "Flavors", "IntValue", 0 }, { "Rebirths", "IntValue", 0 } }) do
		local v = Instance.new(info[2])
		v.Name = info[1]
		v.Value = info[3]
		v.Parent = ls
	end
	local sf = stateFolder(plr)
	for _, info in ipairs({ { "TotalGoo", "NumberValue", 0 }, { "BestLevel", "IntValue", 1 }, { "QuestsDone", "IntValue", 0 }, { "RunMile", "IntValue", 0 } }) do
		local v = Instance.new(info[2])
		v.Name = info[1]
		v.Value = info[3]
		v.Parent = sf
	end
end

local function apply(plr, d)
	local ls = plr:FindFirstChild("leaderstats")
	local sf = stateFolder(plr)
	for name, val in pairs(d.stats or {}) do
		local c = ls and ls:FindFirstChild(name)
		if c and type(val) == "number" then c.Value = val end
	end
	local okClass = { IntValue = true, NumberValue = true, StringValue = true, BoolValue = true }
	for name, pair in pairs(d.st or {}) do
		if type(pair) == "table" and okClass[pair[1]] then
			local v = sf:FindFirstChild(name)
			if not v then
				v = Instance.new(pair[1])
				v.Name = name
				v.Parent = sf
			end
			v.Value = pair[2]
		end
	end
	for name, val in pairs(d.at or {}) do
		local kind = ATTRS[name]
		if kind == "c" and type(val) == "table" then
			plr:SetAttribute(name, Color3.new(val[1] or 1, val[2] or 1, val[3] or 1))
		elseif kind then
			plr:SetAttribute(name, val)
		end
	end
	local best = sf:FindFirstChild("BestLevel")
	if best and ls and ls.Tongue.Value &gt; best.Value then best.Value = ls.Tongue.Value end
end

local function load(plr)
	local key = "p_" .. plr.UserId
	for attempt = 1, 5 do
		if not plr.Parent then return false end
		local ok, res = pcall(function()
			return store:UpdateAsync(key, function(old)
				old = old or {}
				if old.lock and old.lock.job ~= SESSION and os.time() - (old.lock.t or 0) &lt; 100 then return nil end
				old.lock = { job = SESSION, t = os.time() }
				return old
			end)
		end)
		if ok and res and res.lock and res.lock.job == SESSION then
			return true, res
		end
		task.wait(attempt * 3)
	end
	return false
end

local function save(plr, release)
	if not plr:GetAttribute("DataReady") or plr:GetAttribute("DataFailed") then return false end
	local d = serialize(plr)
	if release then d.lock = nil else d.lock = { job = SESSION, t = os.time() } end
	local key = "p_" .. plr.UserId
	for attempt = 1, 3 do
		local ok = pcall(function()
			store:UpdateAsync(key, function(old)
				if old and old.lock and old.lock.job ~= SESSION and os.time() - (old.lock.t or 0) &lt; 100 then return nil end
				return d
			end)
		end)
		if ok then
			plr:SetAttribute("LastSave", os.time())
			plr:SetAttribute("SaveOk", true)
			return true
		end
		task.wait(attempt * 2)
	end
	plr:SetAttribute("SaveOk", false)
	return false
end

saveNow.OnInvoke = function(plr)
	return save(plr, false)
end

local function onJoin(plr)
	setup(plr)
	local ok, res = load(plr)
	if not plr.Parent then return end
	if not ok then
		plr:SetAttribute("DataFailed", true)
		plr:Kick("We could not load your progress safely, so nothing was changed. Please rejoin in a minute.")
		return
	end
	if res.v then
		apply(plr, res)
		plr:SetAttribute("NewPlayer", false)
	else
		plr:SetAttribute("NewPlayer", true)
	end
	plr:SetAttribute("LastSave", os.time())
	plr:SetAttribute("SaveOk", true)
	plr:SetAttribute("DataReady", true)
	print("[LickData] loaded " .. plr.Name)
end

Players.PlayerAdded:Connect(function(plr) task.spawn(onJoin, plr) end)
for _, plr in ipairs(Players:GetPlayers()) do task.spawn(onJoin, plr) end

Players.PlayerRemoving:Connect(function(plr) save(plr, true) end)

task.spawn(function()
	while true do
		task.wait(AUTOSAVE_SECONDS)
		for _, plr in ipairs(Players:GetPlayers()) do
			task.spawn(save, plr, false)
			task.wait(0.4)
		end
	end
end)

game:BindToClose(function()
	local pending = 0
	for _, plr in ipairs(Players:GetPlayers()) do
		pending = pending + 1
		task.spawn(function()
			save(plr, true)
			pending = pending - 1
		end)
	end
	local t = 0
	while pending &gt; 0 and t &lt; 25 do
		task.wait(0.25)
		t = t + 0.25
	end
end)
print("[LickData] ready")
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX12">
        <Properties>
          <string name="Name">LickConfig</string>
          <ProtectedString name="Source">-- LICK CONFIG (server Script)  Location: ServerScriptService &gt; LickConfig
-- Publishes the economy + world numbers so every other script reads the SAME values.
-- ADD A NEW WORLD: add one entry to WORLDS below (8 zone names + 8 values + colors), raise nothing else here,
-- then add its 8 foods in LickItems and its look in LickWorld. Everything else adapts by itself.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BASE_LEVELS = { 1, 10, 25, 45, 70, 100, 140, 180 } -- agreed unlock levels (world 1). Each next world adds 200.
local LPM = 150 -- licks per minute the economy is balanced around
local REGROW_SECONDS = 6 -- how long a finished food takes to grow back for that player

local WORLDS = {
	{
		name = "CANDY WORLD",
		zones = { "DONUT ZONE", "ICE CREAM ZONE", "CUPCAKE ZONE", "LOLLIPOP ZONE", "GUMBALL ZONE", "GOLDEN CAKE ZONE", "GALAXY ZONE", "MYTHIC ZONE" },
		values = { 1, 3, 9, 27, 80, 240, 720, 2200 },
		colors = { "e8b878", "9fd4ff", "ff8fb8", "7dffc8", "ff7bff", "ffd84a", "9a7bff", "7dff6a" },
	},
	{
		name = "SNACK CITY",
		zones = { "PIZZA ZONE", "TACO ZONE", "FRIES ZONE", "HOT DOG ZONE", "POPCORN ZONE", "BOBA ZONE", "SUSHI ZONE", "FEAST ZONE" },
		values = { 4400, 13000, 40000, 120000, 360000, 1100000, 3200000, 9700000 },
		colors = { "ff8a4a", "ffd84a", "ffc23a", "ff6b5a", "fff2b8", "c79bff", "5fe8d0", "ff7bc8" },
	},
}

local zl, zv, zn, zc, wn = {}, {}, {}, {}, {}
for w, world in ipairs(WORLDS) do
	wn[#wn + 1] = world.name
	for k = 1, 8 do
		zl[#zl + 1] = BASE_LEVELS[k] + 200 * (w - 1)
		zv[#zv + 1] = world.values[k]
		zn[#zn + 1] = world.zones[k]
		zc[#zc + 1] = world.colors[k]
	end
end
local MAX_LEVEL = 200 * #WORLDS -- levels 201+ are the Legend levels (world 2 and beyond)

local f = Instance.new("Folder")
f.Name = "LickConfig"
f.Parent = ReplicatedStorage
local function sv(name, value)
	local s = Instance.new("StringValue")
	s.Name = name
	s.Value = value
	s.Parent = f
end

local function zoneOf(level)
	local z = 1
	for i = 1, #zl do
		if level &gt;= zl[i] then z = i end
	end
	return z
end

-- goo needed to go from level L to L+1 = (minutes of play for that level) x income per minute in that zone
local costs = {}
for L = 1, MAX_LEVEL - 1 do
	local minutes = 0.04 * L ^ 1.2
	costs[L] = math.max(5, math.floor(minutes * LPM * zv[zoneOf(L)] + 0.5))
end

sv("LevelCosts", table.concat(costs, ","))
sv("ZoneLevels", table.concat(zl, ","))
sv("ZoneValues", table.concat(zv, ","))
sv("ZoneNames", table.concat(zn, "|"))
sv("ZoneColors", table.concat(zc, ","))
sv("WorldNames", table.concat(wn, "|"))
f:SetAttribute("MaxLevel", MAX_LEVEL)
f:SetAttribute("LPM", LPM)
f:SetAttribute("RegrowSeconds", REGROW_SECONDS)
f:SetAttribute("RebirthStart", 100)
f:SetAttribute("RebirthStep", 10)
f:SetAttribute("Worlds", #WORLDS)
print("[LickConfig] ready, worlds: " .. #WORLDS)
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX13">
        <Properties>
          <string name="Name">LickCore</string>
          <ProtectedString name="Source">-- LICK CORE (server Script)  Location: ServerScriptService &gt; LickCore
-- Licking + eating (bites per player), goo payouts, zone locks, Auto Lick.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local HttpService = game:GetService("HttpService")
local remotes = ReplicatedStorage:WaitForChild("LickRemotes")
local bus = ServerStorage:WaitForChild("LickBus")
local function notify(plr, text, sfx) remotes.Notify:FireClient(plr, text, sfx) end
local function jdec(s)
	local ok, t = pcall(function() return HttpService:JSONDecode(s) end)
	if ok and type(t) == "table" then return t end
	return {}
end
local function jenc(t) return HttpService:JSONEncode(t) end
local function ready(plr)
	while plr.Parent and not plr:GetAttribute("DataReady") do task.wait(0.25) end
	return plr.Parent ~= nil
end
local function state(plr, name, class, default)
	local f = plr:FindFirstChild("LickState")
	if not f then
		f = Instance.new("Folder")
		f.Name = "LickState"
		f.Parent = plr
	end
	local v = f:FindFirstChild(name)
	if not v then
		v = Instance.new(class)
		v.Name = name
		v.Value = default
		v.Parent = f
	end
	return v
end
local rateT = {}
local function rate(plr, key, gap)
	local k = plr.UserId .. key
	local now = os.clock()
	if rateT[k] and now - rateT[k] &lt; gap then return false end
	rateT[k] = now
	return true
end
local function stat(plr, key, n) bus.Stat:Fire(plr, key, n or 1) end
local function grant(plr, reward, why) bus.Grant:Fire(plr, reward, why) end

local CFGF = ReplicatedStorage:WaitForChild("LickConfig")
local function csv(name)
	local t = {}
	for n in string.gmatch(CFGF:WaitForChild(name).Value, "[^,]+") do t[#t + 1] = tonumber(n) end
	return t
end
local COSTS, ZL, ZV = csv("LevelCosts"), csv("ZoneLevels"), csv("ZoneValues")
local ZN, WN = {}, {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
for n in string.gmatch(CFGF:WaitForChild("WorldNames").Value, "[^|]+") do WN[#WN + 1] = n end
local NW = #WN
local ZN = {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
local MAXLV = CFGF:GetAttribute("MaxLevel") or 400
local LPM = CFGF:GetAttribute("LPM") or 150
local function zoneOf(level)
	local z = 1
	for i = 1, #ZL do
		if level &gt;= ZL[i] then z = i end
	end
	return z
end
local function minutesGoo(level, minutes) return math.floor(minutes * LPM * ZV[zoneOf(level)]) end
local function worldOf(x) return math.clamp(math.floor((x + 1000) / 2000) + 1, 1, NW) end
local function zoneCenter(g)
	local w, k = math.floor((g - 1) / 8) + 1, (g - 1) % 8 + 1
	local col, z = k - 1, -160
	if k &gt; 4 then
		col = 8 - k
		z = 160
	end
	return -480 + 320 * col + (w - 1) * 2000, z
end
local function gatePos(g)
	local w, k = math.floor((g - 1) / 8) + 1, (g - 1) % 8 + 1
	local ox = (w - 1) * 2000
	if k &lt;= 3 then return -320 + 320 * (k - 1) + ox, -160 end
	if k == 4 then return 480 + ox, 0 end
	if k &lt; 8 then return -320 + 320 * (7 - k) + ox, 160 end
	return nil
end
local function zoneAt(x, z)
	local w = worldOf(x)
	local col = math.clamp(math.floor((x - (w - 1) * 2000 + 640) / 320), 0, 3)
	local k = 8 - col
	if z &lt; 0 then k = col + 1 end
	return (w - 1) * 8 + k
end

local rng = Random.new()
local BASE_CD = 0.35
local REGROW = CFGF:GetAttribute("RegrowSeconds") or 6
local PER_BITE = 2 / 3 -- of the zone value; the finish bonus makes a full food worth about its zone value x bites
local FINISH_BONUS = 0.5

local function reachFor(lvl) return 10 + math.floor(20 * (1 - math.exp(-lvl / 70))) end

local lastLick, bites, regrow, lastFx = {}, {}, {}, {}

local function allowedZone(plr)
	return zoneOf(state(plr, "BestLevel", "IntValue", 1).Value)
end

local function lick(plr, model)
	if not plr:GetAttribute("DataReady") then return end
	local stats = plr:FindFirstChild("leaderstats")
	local char = plr.Character
	local head = char and char:FindFirstChild("Head")
	local center = model:GetAttribute("Center")
	local zone = model:GetAttribute("Zone")
	if not (stats and head and center and zone) then return end
	local now = os.clock()
	local cd = math.max(0.06, (BASE_CD - 0.02 * (plr:GetAttribute("LickSpeedLvl") or 0)) * (plr:GetAttribute("LickCooldownMult") or 1))
	if lastLick[plr] and now - lastLick[plr] &lt; cd then return end
	lastLick[plr] = now
	if allowedZone(plr) &lt; zone then
		if rate(plr, "lockmsg", 1.5) then notify(plr, ZN[zone] .. " unlocks at Level " .. ZL[zone], "error") end
		return
	end
	local level = stats.Tongue.Value
	local reach = reachFor(level) + (plr:GetAttribute("ReachBonus") or 0)
	if (center - head.Position).Magnitude - (model:GetAttribute("Radius") or 3) &gt; reach then
		if rate(plr, "farmsg", 1.2) then notify(plr, "Too far! Walk closer to lick it.", "error") end
		return
	end
	local bp = bites[plr]
	if not bp then
		bp = {}
		bites[plr] = bp
	end
	local rg = regrow[plr]
	if not rg then
		rg = {}
		regrow[plr] = rg
	end
	if rg[model] and now &lt; rg[model] then
		if rate(plr, "regmsg", 1.5) then notify(plr, "Still growing back...", "error") end
		return
	end

	local totalBites = model:GetAttribute("Bites") or 3
	local b = (bp[model] or 0) + 1
	local finished = b &gt;= totalBites

	-- payout: the food pays at most what your CURRENT level's zone pays (so high-zone access after a rebirth cannot be farmed)
	local perBite = math.min(ZV[zone], ZV[zoneOf(level)]) * PER_BITE
	local boost = 1
	if (plr:GetAttribute("BoostUntil") or 0) &gt; os.time() then boost = 2 end
	local mult = (1 + stats.Rebirths.Value * (plr:GetAttribute("RebirthBonus") or 0.5)) * (plr:GetAttribute("PassMult") or 1) * boost * (plr:GetAttribute("Comeback") or 1)
	local gain = perBite * mult
	local lucky = false
	if rng:NextNumber() &lt; 0.05 * (plr:GetAttribute("LuckyLvl") or 0) + (plr:GetAttribute("LuckBonus") or 0) then
		gain = gain * 2
		lucky = true
	end
	if finished then gain = gain + perBite * mult * totalBites * FINISH_BONUS end
	gain = math.max(1, math.floor(gain + 0.5))

	stats.Goo.Value = stats.Goo.Value + gain
	local tg = state(plr, "TotalGoo", "NumberValue", 0)
	tg.Value = tg.Value + gain
	stats.Licks.Value = stats.Licks.Value + 1
	stat(plr, "licks", 1)
	stat(plr, "goo", gain)

	if finished then
		rg[model] = now + REGROW
		bp[model] = nil
		stat(plr, "foods", 1)
		stat(plr, "zf" .. zone, 1)
	else
		bp[model] = b
	end

	-- food index (discovered + times finished)
	local name = model:GetAttribute("FlavorName") or "Snack"
	local idxV = state(plr, "Index", "StringValue", "{}")
	local idx = jdec(idxV.Value)
	local changed = false
	if idx[name] == nil then
		idx[name] = 0
		changed = true
	end
	if finished then
		idx[name] = idx[name] + 1
		changed = true
	end
	if changed then
		idxV.Value = jenc(idx)
		local n = 0
		for _ in pairs(idx) do n = n + 1 end
		if stats.Flavors.Value ~= n then
			stats.Flavors.Value = n
			remotes.Celebrate:FireClient(plr, "flavor", name)
			stat(plr, "index", 1)
		end
	end

	remotes.Eat:FireClient(plr, model, finished and totalBites or b, totalBites, finished, gain, lucky)

	-- other players close by get a light-weight effect (throttled)
	if not lastFx[plr] or now - lastFx[plr] &gt; 0.2 then
		lastFx[plr] = now
		for _, other in ipairs(Players:GetPlayers()) do
			if other ~= plr and other.Character and other.Character:FindFirstChild("HumanoidRootPart") then
				if (other.Character.HumanoidRootPart.Position - center).Magnitude &lt; 70 then
					remotes.LickFx:FireClient(other, plr.UserId, center, finished)
				end
			end
		end
	end
end

-- hook every lickable that LickItems makes
task.spawn(function()
	local lickables = workspace:WaitForChild("LickWorld"):WaitForChild("Lickables")
	local function hook(model)
		local cd = model:FindFirstChildOfClass("ClickDetector")
		if not cd then cd = model:WaitForChild("ClickDetector", 5) end
		if cd then
			cd.MouseClick:Connect(function(plr) lick(plr, model) end)
		end
	end
	for _, m in ipairs(lickables:GetChildren()) do task.spawn(hook, m) end
	lickables.ChildAdded:Connect(function(m) task.spawn(hook, m) end)
end)

-- Auto Lick pass: licks the nearest snack in reach while the toggle is on
task.spawn(function()
	local lickables = workspace:WaitForChild("LickWorld"):WaitForChild("Lickables")
	while true do
		task.wait(0.3)
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr:GetAttribute("AutoLick") and plr:GetAttribute("DataReady") then
				local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
				local stats = plr:FindFirstChild("leaderstats")
				if root and stats then
					local reach = reachFor(stats.Tongue.Value) + (plr:GetAttribute("ReachBonus") or 0)
					local az = allowedZone(plr)
					local now = os.clock()
					local best, bestD = nil, 1000000
					for _, m in ipairs(lickables:GetChildren()) do
						local c = m:GetAttribute("Center")
						local z = m:GetAttribute("Zone")
						local rg = regrow[plr]
						if c and z and z &lt;= az and not (rg and rg[m] and now &lt; rg[m]) then
							local d = (c - root.Position).Magnitude - (m:GetAttribute("Radius") or 3)
							if d &lt;= reach - 3 and d &lt; bestD then
								best = m
								bestD = d
							end
						end
					end
					if best then lick(plr, best) end
				end
			end
		end
	end
end)

-- the on-screen LICK button / E key: licks the nearest food you can reach
local lickF
task.spawn(function() lickF = workspace:WaitForChild("LickWorld"):WaitForChild("Lickables") end)
remotes.LickNearest.OnServerEvent:Connect(function(plr)
	if not lickF or not plr:GetAttribute("DataReady") then return end
	local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
	local stats = plr:FindFirstChild("leaderstats")
	if not root or not stats then return end
	if not rate(plr, "lickbtn", 0.05) then return end
	local reach = reachFor(stats.Tongue.Value) + (plr:GetAttribute("ReachBonus") or 0)
	local az = allowedZone(plr)
	local now = os.clock()
	local best, bestD = nil, 1000000
	for _, m in ipairs(lickF:GetChildren()) do
		local c, z = m:GetAttribute("Center"), m:GetAttribute("Zone")
		local rg = regrow[plr]
		if c and z and z &lt;= az and not (rg and rg[m] and now &lt; rg[m]) then
			local d = (c - root.Position).Magnitude - (m:GetAttribute("Radius") or 3)
			if d &lt;= reach and d &lt; bestD then
				best = m
				bestD = d
			end
		end
	end
	if best then
		lick(plr, best)
	elseif rate(plr, "nonear", 1.5) then
		notify(plr, "Nothing to lick in reach. Walk closer to some food!", "error")
	end
end)

-- player groups (zone walls) + walk speed
local function groupFor(plr, x)
	local w = worldOf(x or 0)
	return "Tier_" .. math.clamp(allowedZone(plr) - (w - 1) * 8, 1, 8)
end

local function applyGroup(plr)
	local char = plr.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local g = groupFor(plr, root.Position.X)
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") and d.CollisionGroup ~= g then
			pcall(function() d.CollisionGroup = g end)
		end
	end
end

local function applySpeed(plr)
	local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
	if hum then hum.WalkSpeed = 16 + 2 * (plr:GetAttribute("SpeedLvl") or 0) + (plr:GetAttribute("SpeedBonus") or 0) end
end

-- a safe place inside the last zone the player has unlocked
local function safeSpot(az)
	local gx, gz = gatePos(az)
	local cx, cz = zoneCenter(az)
	if not gx then return cx, cz end
	local dx, dz = cx - gx, cz - gz
	local len = math.sqrt(dx * dx + dz * dz)
	return gx + dx / len * 16, gz + dz / len * 16
end

-- safety net: put anyone back who got into a zone they have not unlocked
task.spawn(function()
	while true do
		task.wait(0.5)
		for _, plr in ipairs(Players:GetPlayers()) do
			local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
			if root and plr:GetAttribute("DataReady") then
				applyGroup(plr)
				local az = allowedZone(plr)
				local p = root.Position
				local w = worldOf(p.X)
				if math.abs(p.X - (w - 1) * 2000) &lt; 660 and math.abs(p.Z) &lt; 340 and p.Y &lt; 400 then
					local z = zoneAt(p.X, p.Z)
					if z &gt; az then
						local sx, sz = safeSpot(az)
						plr.Character:PivotTo(CFrame.new(sx, p.Y + 3, sz))
						notify(plr, ZN[z] .. " unlocks at Level " .. ZL[z], "error")
					end
				end
			end
		end
	end
end)

local function setupPlayer(plr)
	local function onChar(char)
		char.DescendantAdded:Connect(function(d)
			if d:IsA("BasePart") then pcall(function() d.CollisionGroup = groupFor(plr, char.PrimaryPart and char.PrimaryPart.Position.X or 0) end) end
		end)
		applyGroup(plr)
		local hum = char:WaitForChild("Humanoid", 10)
		if hum then applySpeed(plr) end
	end
	plr.CharacterAdded:Connect(onChar)
	if plr.Character then task.spawn(onChar, plr.Character) end
	for _, a in ipairs({ "SpeedLvl", "SpeedBonus" }) do
		plr:GetAttributeChangedSignal(a):Connect(function() applySpeed(plr) end)
	end
	task.spawn(function()
		if ready(plr) then
			state(plr, "BestLevel", "IntValue", 1).Changed:Connect(function() applyGroup(plr) end)
			applySpeed(plr)
		end
	end)
end
Players.PlayerAdded:Connect(setupPlayer)
for _, plr in ipairs(Players:GetPlayers()) do setupPlayer(plr) end
Players.PlayerRemoving:Connect(function(plr)
	lastLick[plr] = nil
	bites[plr] = nil
	regrow[plr] = nil
	lastFx[plr] = nil
end)
print("[LickCore] ready")
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX14">
        <Properties>
          <string name="Name">LickItems</string>
          <ProtectedString name="Source">-- LICK ITEMS (server Script)  Location: ServerScriptService &gt; LickItems
-- Builds every food (16 foods, one per zone of both worlds) and the giant landmarks. Parts only, no assets.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local HttpService = game:GetService("HttpService")
local remotes = ReplicatedStorage:WaitForChild("LickRemotes")
local bus = ServerStorage:WaitForChild("LickBus")
local function notify(plr, text, sfx) remotes.Notify:FireClient(plr, text, sfx) end
local function jdec(s)
	local ok, t = pcall(function() return HttpService:JSONDecode(s) end)
	if ok and type(t) == "table" then return t end
	return {}
end
local function jenc(t) return HttpService:JSONEncode(t) end
local function ready(plr)
	while plr.Parent and not plr:GetAttribute("DataReady") do task.wait(0.25) end
	return plr.Parent ~= nil
end
local function state(plr, name, class, default)
	local f = plr:FindFirstChild("LickState")
	if not f then
		f = Instance.new("Folder")
		f.Name = "LickState"
		f.Parent = plr
	end
	local v = f:FindFirstChild(name)
	if not v then
		v = Instance.new(class)
		v.Name = name
		v.Value = default
		v.Parent = f
	end
	return v
end
local rateT = {}
local function rate(plr, key, gap)
	local k = plr.UserId .. key
	local now = os.clock()
	if rateT[k] and now - rateT[k] &lt; gap then return false end
	rateT[k] = now
	return true
end
local function stat(plr, key, n) bus.Stat:Fire(plr, key, n or 1) end
local function grant(plr, reward, why) bus.Grant:Fire(plr, reward, why) end

local CFGF = ReplicatedStorage:WaitForChild("LickConfig")
local function csv(name)
	local t = {}
	for n in string.gmatch(CFGF:WaitForChild(name).Value, "[^,]+") do t[#t + 1] = tonumber(n) end
	return t
end
local COSTS, ZL, ZV = csv("LevelCosts"), csv("ZoneLevels"), csv("ZoneValues")
local ZN, WN = {}, {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
for n in string.gmatch(CFGF:WaitForChild("WorldNames").Value, "[^|]+") do WN[#WN + 1] = n end
local NW = #WN
local ZN = {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
local MAXLV = CFGF:GetAttribute("MaxLevel") or 400
local LPM = CFGF:GetAttribute("LPM") or 150
local function zoneOf(level)
	local z = 1
	for i = 1, #ZL do
		if level &gt;= ZL[i] then z = i end
	end
	return z
end
local function minutesGoo(level, minutes) return math.floor(minutes * LPM * ZV[zoneOf(level)]) end
local function worldOf(x) return math.clamp(math.floor((x + 1000) / 2000) + 1, 1, NW) end
local function zoneCenter(g)
	local w, k = math.floor((g - 1) / 8) + 1, (g - 1) % 8 + 1
	local col, z = k - 1, -160
	if k &gt; 4 then
		col = 8 - k
		z = 160
	end
	return -480 + 320 * col + (w - 1) * 2000, z
end
local function gatePos(g)
	local w, k = math.floor((g - 1) / 8) + 1, (g - 1) % 8 + 1
	local ox = (w - 1) * 2000
	if k &lt;= 3 then return -320 + 320 * (k - 1) + ox, -160 end
	if k == 4 then return 480 + ox, 0 end
	if k &lt; 8 then return -320 + 320 * (7 - k) + ox, 160 end
	return nil
end
local function zoneAt(x, z)
	local w = worldOf(x)
	local col = math.clamp(math.floor((x - (w - 1) * 2000 + 640) / 320), 0, 3)
	local k = 8 - col
	if z &lt; 0 then k = col + 1 end
	return (w - 1) * 8 + k
end

local rng = Random.new(77)
local BALL, CYL = Enum.PartType.Ball, Enum.PartType.Cylinder
local K = 1
local WHITE = Color3.new(1, 1, 1)
local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

local world = workspace:FindFirstChild("LickWorld")
if not world then
	world = Instance.new("Folder")
	world.Name = "LickWorld"
	world.Parent = workspace
end
local itemsFolder = Instance.new("Folder")
itemsFolder.Name = "Lickables"
itemsFolder.Parent = world
local landFolder = Instance.new("Folder")
landFolder.Name = "Landmarks"
landFolder.Parent = world

local function mk(m, shape, size, cf, color, mat, tr)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	if shape then p.Shape = shape end
	p.Transparency = tr or 0
	p.CastShadow = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = m
	return p
end
local function ball(m, d, x, y, z, c, mat, tr) return mk(m, BALL, Vector3.new(d, d, d) * K, CFrame.new(x * K, y * K, z * K), c, mat, tr) end
local function vcyl(m, h, d, x, y, z, c, mat) return mk(m, CYL, Vector3.new(h, d, d) * K, CFrame.new(x * K, y * K, z * K) * CFrame.Angles(0, 0, math.rad(90)), c, mat) end
local function hcyl(m, len, d, x, y, z, c, mat) return mk(m, CYL, Vector3.new(len, d, d) * K, CFrame.new(x * K, y * K, z * K), c, mat) end
local function blk(m, w, h, d, x, y, z, c, mat, ry, rz) return mk(m, nil, Vector3.new(w, h, d) * K, CFrame.new(x * K, y * K, z * K) * CFrame.Angles(0, math.rad(ry or 0), math.rad(rz or 0)), c, mat) end

local B = {}
B[1] = function(m) -- Sad Donut
	for i = 1, 10 do
		local a = i / 10 * math.pi * 2
		ball(m, 1.5, math.cos(a) * 1.7, 0.75, math.sin(a) * 1.7, rgb(235, 185, 110))
		ball(m, 1.2, math.cos(a) * 1.7, 1.35, math.sin(a) * 1.7, rgb(255, 120, 190))
	end
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2 + 0.3
		ball(m, 0.4, math.cos(a) * 1.7, 2.0, math.sin(a) * 1.7, Color3.fromHSV(i / 6, 0.7, 1), Enum.Material.Neon)
	end
end
B[2] = function(m) -- Ice Cream Cone
	for i = 1, 4 do vcyl(m, 0.65, 0.5 * i, 0, 0.35 + (i - 1) * 0.65, 0, i % 2 == 0 and rgb(200, 140, 70) or rgb(225, 170, 90)) end
	ball(m, 2.6, 0, 3.4, 0, rgb(255, 150, 200))
	ball(m, 2.1, 0, 4.9, 0, rgb(255, 245, 210))
	ball(m, 0.7, 0, 6.1, 0, rgb(255, 40, 60))
end
B[3] = function(m) -- Cherry Cupcake
	vcyl(m, 1.2, 2.4, 0, 0.6, 0, rgb(255, 120, 170))
	vcyl(m, 0.6, 3.0, 0, 1.5, 0, WHITE)
	ball(m, 3.0, 0, 2.5, 0, rgb(255, 190, 220))
	ball(m, 2.2, 0, 3.6, 0, rgb(255, 160, 205))
	ball(m, 1.4, 0, 4.5, 0, rgb(255, 190, 220))
	ball(m, 1.0, 0, 5.2, 0, rgb(230, 20, 50))
end
B[4] = function(m) -- Rainbow Lollipop
	vcyl(m, 3.2, 0.5, 0, 1.6, 0, WHITE)
	ball(m, 4, 0, 5, 0, rgb(255, 90, 160))
	vcyl(m, 0.4, 4.15, 0, 5, 0, rgb(255, 240, 80))
	vcyl(m, 0.4, 3.5, 0, 6.1, 0, rgb(80, 200, 255))
	vcyl(m, 0.4, 3.5, 0, 3.9, 0, rgb(120, 255, 120))
end
B[5] = function(m) -- Gumball Machine
	vcyl(m, 1.4, 3.2, 0, 0.7, 0, rgb(230, 50, 60))
	ball(m, 4, 0, 3.4, 0, rgb(210, 240, 255), Enum.Material.Glass, 0.5)
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2
		ball(m, 0.9, math.cos(a), 2.7 + (i % 3) * 0.6, math.sin(a), Color3.fromHSV(i / 8, 0.8, 1))
	end
	vcyl(m, 0.5, 2.2, 0, 5.6, 0, rgb(255, 210, 40))
end
B[6] = function(m) -- Golden Cake
	vcyl(m, 0.3, 5.2, 0, 0.15, 0, WHITE)
	vcyl(m, 1.6, 4.6, 0, 1.1, 0, rgb(255, 200, 40), Enum.Material.Foil)
	vcyl(m, 1.4, 3.4, 0, 2.6, 0, rgb(255, 235, 150))
	vcyl(m, 1.2, 2.2, 0, 3.9, 0, rgb(255, 200, 40), Enum.Material.Foil)
	for i = 1, 3 do
		local a = i / 3 * math.pi * 2
		vcyl(m, 1.1, 0.25, math.cos(a) * 0.7, 5.05, math.sin(a) * 0.7, rgb(255, 70, 90))
		local fl = ball(m, 0.5, math.cos(a) * 0.7, 5.8, math.sin(a) * 0.7, rgb(255, 230, 90), Enum.Material.Neon)
		fl:SetAttribute("Flicker", true)
	end
end
B[7] = function(m) -- Galaxy Jelly
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2
		vcyl(m, 3.2, 0.35, math.cos(a) * 1.2, 1.6, math.sin(a) * 1.2, rgb(255, 120, 230), Enum.Material.Neon)
	end
	ball(m, 4.2, 0, 4, 0, rgb(150, 80, 255), Enum.Material.Neon, 0.35)
	ball(m, 2.0, 0, 4, 0, rgb(255, 200, 255), Enum.Material.Neon, 0.1)
	for i = 1, 4 do
		local a = i / 4 * math.pi * 2
		ball(m, 0.4, math.cos(a) * 2.8, 5 + (i % 2), math.sin(a) * 2.8, rgb(255, 255, 150), Enum.Material.Neon)
	end
end
B[8] = function(m) -- Mythic Burger
	vcyl(m, 1, 4.2, 0, 0.5, 0, rgb(230, 170, 90))
	vcyl(m, 0.9, 4.4, 0, 1.45, 0, rgb(100, 55, 30))
	blk(m, 4.6, 0.25, 4.6, 0, 2.05, 0, rgb(255, 210, 40), nil, 45)
	vcyl(m, 0.35, 4.7, 0, 2.4, 0, rgb(80, 200, 80))
	vcyl(m, 0.4, 4.3, 0, 2.75, 0, rgb(230, 50, 50))
	vcyl(m, 0.9, 4.4, 0, 3.4, 0, rgb(100, 55, 30))
	ball(m, 4.6, 0, 4.0, 0, rgb(235, 175, 95))
	for i = 1, 5 do
		local a = i / 5 * math.pi * 2
		ball(m, 0.45, math.cos(a) * 1.2, 5.9, math.sin(a) * 1.2, Color3.new(1, 1, 0.9))
	end
end
B[9] = function(m) -- Pizza
	vcyl(m, 0.9, 1.2, 0, 0.45, 0, rgb(120, 120, 130))
	vcyl(m, 0.5, 5.4, 0, 1.15, 0, rgb(225, 170, 90))
	vcyl(m, 0.25, 4.6, 0, 1.5, 0, rgb(215, 50, 40))
	vcyl(m, 0.2, 4.4, 0, 1.7, 0, rgb(255, 220, 90))
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2
		vcyl(m, 0.25, 0.95, math.cos(a) * 1.6, 1.95, math.sin(a) * 1.6, rgb(170, 40, 40))
	end
	vcyl(m, 0.25, 0.95, 0, 1.95, 0, rgb(170, 40, 40))
	for i = 1, 3 do ball(m, 0.5, math.cos(i * 2.1) * 0.9, 2.05, math.sin(i * 2.1) * 0.9, rgb(60, 170, 60)) end
end
B[10] = function(m) -- Taco
	blk(m, 0.6, 3.6, 4.2, -1.1, 1.9, 0, rgb(255, 205, 70), nil, 0, 22)
	blk(m, 0.6, 3.6, 4.2, 1.1, 1.9, 0, rgb(255, 205, 70), nil, 0, -22)
	blk(m, 2.2, 0.5, 4, 0, 0.3, 0, rgb(255, 205, 70))
	for i = 1, 5 do ball(m, 1.1, 0, 2.2 + (i % 2) * 0.3, -1.7 + i * 0.7, i % 2 == 0 and rgb(80, 200, 80) or rgb(235, 60, 50)) end
	ball(m, 1.0, 0.2, 3.1, 0, rgb(255, 220, 90))
end
B[11] = function(m) -- Fries
	blk(m, 3.4, 2.6, 1.6, 0, 1.3, 0, rgb(225, 40, 40))
	for i = 1, 9 do blk(m, 0.55, 2.4 + (i % 3) * 0.6, 0.55, -1.4 + (i - 1) * 0.35, 3.0 + (i % 3) * 0.3, -0.35 + (i % 2) * 0.7, rgb(255, 205, 60), nil, i * 17, (i % 3 - 1) * 6) end
end
B[12] = function(m) -- Hot Dog
	hcyl(m, 5, 1.9, 0, 0.95, 0, rgb(235, 190, 120))
	hcyl(m, 5.6, 1.15, 0, 1.75, 0, rgb(190, 70, 50))
	ball(m, 1.15, 2.8, 1.75, 0, rgb(190, 70, 50))
	ball(m, 1.15, -2.8, 1.75, 0, rgb(190, 70, 50))
	for i = 1, 7 do ball(m, 0.4, -2.1 + i * 0.6, 2.4, (i % 2 - 0.5) * 0.4, rgb(255, 215, 40)) end
end
B[13] = function(m) -- Popcorn
	vcyl(m, 3.2, 3.5, 0, 1.6, 0, rgb(235, 235, 235))
	for i = 1, 4 do vcyl(m, 3.2, 0.5, math.cos(i * 1.57) * 1.6, 1.6, math.sin(i * 1.57) * 1.6, rgb(225, 40, 50)) end
	for i = 1, 11 do ball(m, 1.0, math.cos(i * 2.4) * 1.1, 3.5 + (i % 3) * 0.7, math.sin(i * 2.4) * 1.1, rgb(255, 245, 210)) end
end
B[14] = function(m) -- Boba Tea
	vcyl(m, 4, 2.6, 0, 2, 0, rgb(225, 205, 255), Enum.Material.Glass, 0.4)
	vcyl(m, 3, 2.3, 0, 1.6, 0, rgb(170, 120, 80))
	for i = 1, 7 do ball(m, 0.5, math.cos(i * 2.6) * 0.8, 0.55, math.sin(i * 2.6) * 0.8, rgb(30, 20, 25)) end
	vcyl(m, 0.3, 2.8, 0, 4.1, 0, rgb(255, 130, 190))
	vcyl(m, 5.5, 0.3, 0.4, 3.9, 0, rgb(255, 90, 160))
end
B[15] = function(m) -- Sushi
	vcyl(m, 0.3, 5.4, 0, 0.15, 0, WHITE)
	for i = 1, 3 do
		local x = -1.7 + (i - 1) * 1.7
		vcyl(m, 1.3, 1.5, x, 0.95, 0, rgb(250, 250, 245))
		vcyl(m, 0.7, 1.58, x, 0.95, 0, rgb(25, 70, 40))
		ball(m, 1.0, x, 1.8, 0, i == 2 and rgb(255, 130, 60) or rgb(255, 90, 100))
	end
end
B[16] = function(m) -- Mega Feast
	vcyl(m, 0.4, 6.2, 0, 0.2, 0, rgb(255, 215, 80), Enum.Material.Foil)
	vcyl(m, 1.1, 4.8, 0, 0.95, 0, rgb(225, 170, 90))
	vcyl(m, 0.9, 5.0, 0, 2.0, 0, rgb(120, 60, 35))
	vcyl(m, 0.6, 5.2, 0, 2.75, 0, rgb(255, 215, 50))
	vcyl(m, 1.0, 3.8, 0, 3.6, 0, rgb(255, 120, 170))
	ball(m, 3.4, 0, 5.0, 0, rgb(235, 175, 95))
	ball(m, 1.0, 0, 7.1, 0, rgb(255, 230, 90), Enum.Material.Neon)
end

local BITES = { 3, 3, 4, 4, 5, 6, 7, 8 }
local NAMES = { "Sad Donut", "Ice Cream Cone", "Cherry Cupcake", "Rainbow Lollipop", "Gumball Machine", "Golden Cake", "Galaxy Jelly", "Mythic Burger", "Pizza Slice", "Crunchy Taco", "Golden Fries", "Hot Dog", "Popcorn Bucket", "Boba Tea", "Sushi Platter", "Mega Feast" }

local function makeFood(g, x, z, yaw, scaleK, landmark)
	local m = Instance.new("Model")
	m.Name = NAMES[g]
	K = scaleK
	local root = mk(m, nil, Vector3.new(0.4, 0.4, 0.4), CFrame.new(), WHITE)
	root.Transparency = 1
	root.CanCollide = false
	root.CanQuery = false
	m.PrimaryPart = root
	B[g](m)
	m:PivotTo(CFrame.new(x, 0.2, z) * CFrame.Angles(0, yaw, 0))
	if landmark then
		m:SetAttribute("Landmark", true)
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("BasePart") then
				d.CanCollide = false
				d.CanQuery = false
			end
		end
		m.Parent = landFolder
		return m
	end
	local bcf, bsize = m:GetBoundingBox()
	m:SetAttribute("FlavorName", NAMES[g])
	m:SetAttribute("Zone", g)
	m:SetAttribute("Bites", BITES[(g - 1) % 8 + 1])
	m:SetAttribute("Center", bcf.Position)
	m:SetAttribute("Radius", math.max(bsize.X, bsize.Z) / 2)
	local cd = Instance.new("ClickDetector")
	cd.MaxActivationDistance = 120
	cd.Parent = m
	m.Parent = itemsFolder
	return m
end

local ITEMS_PER_ZONE = 12
local placed = {}
local function free(x, z, r)
	for _, p in ipairs(placed) do
		if (p[1] - x) ^ 2 + (p[2] - z) ^ 2 &lt; (p[3] + r) ^ 2 then return false end
	end
	return true
end

for g = 1, #ZN do
	local cx, cz = zoneCenter(g)
	local k = (g - 1) % 8 + 1
	local gates = {}
	local gx, gz = gatePos(g)
	if gx then gates[#gates + 1] = { gx, gz } end
	if k &gt; 1 then
		local px, pz = gatePos(g - 1)
		if px then gates[#gates + 1] = { px, pz } end
	end
	-- giant landmark in the corner that is farthest from the gates
	local lx, lz = cx + (k % 2 == 0 and 105 or -105), cz + (cz &lt; 0 and -105 or 105)
	pcall(function() makeFood(g, lx, lz, rng:NextNumber(0, 6.28), 7.5, true) end)
	placed[#placed + 1] = { lx, lz, 46 }
	if k == 1 then
		placed[#placed + 1] = { cx, cz, 60 } -- hub plaza (spawn, shops, portal)
		pcall(function() makeFood(g, cx + 34, cz - 8, 0.6, 1.0 + k * 0.1, false):SetAttribute("Starter", true) end)
		placed[#placed + 1] = { cx + 34, cz - 8, 8 }
	end
	local count, tries = ITEMS_PER_ZONE - (k == 1 and 1 or 0), 0
	while count &gt; 0 and tries &lt; 600 do
		tries = tries + 1
		local x, z = cx + rng:NextNumber(-112, 112), cz + rng:NextNumber(-112, 112)
		local ok = free(x, z, 9)
		for _, gt in ipairs(gates) do
			if (gt[1] - x) ^ 2 + (gt[2] - z) ^ 2 &lt; 38 ^ 2 then ok = false end
		end
		if ok then
			placed[#placed + 1] = { x, z, 3 }
			pcall(function() makeFood(g, x, z, rng:NextNumber(0, 6.28), 0.9 + k * 0.1, false) end)
			count = count - 1
		end
	end
end
print("[LickItems] ready: " .. #itemsFolder:GetChildren() .. " foods")
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX15">
        <Properties>
          <string name="Name">LickWorld</string>
          <ProtectedString name="Source">-- LICK WORLD (server Script)  Location: ServerScriptService &gt; LickWorld
-- Builds both worlds: classic studded floors, paths, walls, zone gates, hubs, portals, decorations and lighting.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local HttpService = game:GetService("HttpService")
local remotes = ReplicatedStorage:WaitForChild("LickRemotes")
local bus = ServerStorage:WaitForChild("LickBus")
local function notify(plr, text, sfx) remotes.Notify:FireClient(plr, text, sfx) end
local function jdec(s)
	local ok, t = pcall(function() return HttpService:JSONDecode(s) end)
	if ok and type(t) == "table" then return t end
	return {}
end
local function jenc(t) return HttpService:JSONEncode(t) end
local function ready(plr)
	while plr.Parent and not plr:GetAttribute("DataReady") do task.wait(0.25) end
	return plr.Parent ~= nil
end
local function state(plr, name, class, default)
	local f = plr:FindFirstChild("LickState")
	if not f then
		f = Instance.new("Folder")
		f.Name = "LickState"
		f.Parent = plr
	end
	local v = f:FindFirstChild(name)
	if not v then
		v = Instance.new(class)
		v.Name = name
		v.Value = default
		v.Parent = f
	end
	return v
end
local rateT = {}
local function rate(plr, key, gap)
	local k = plr.UserId .. key
	local now = os.clock()
	if rateT[k] and now - rateT[k] &lt; gap then return false end
	rateT[k] = now
	return true
end
local function stat(plr, key, n) bus.Stat:Fire(plr, key, n or 1) end
local function grant(plr, reward, why) bus.Grant:Fire(plr, reward, why) end

local CFGF = ReplicatedStorage:WaitForChild("LickConfig")
local function csv(name)
	local t = {}
	for n in string.gmatch(CFGF:WaitForChild(name).Value, "[^,]+") do t[#t + 1] = tonumber(n) end
	return t
end
local COSTS, ZL, ZV = csv("LevelCosts"), csv("ZoneLevels"), csv("ZoneValues")
local ZN, WN = {}, {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
for n in string.gmatch(CFGF:WaitForChild("WorldNames").Value, "[^|]+") do WN[#WN + 1] = n end
local NW = #WN
local ZN = {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
local MAXLV = CFGF:GetAttribute("MaxLevel") or 400
local LPM = CFGF:GetAttribute("LPM") or 150
local function zoneOf(level)
	local z = 1
	for i = 1, #ZL do
		if level &gt;= ZL[i] then z = i end
	end
	return z
end
local function minutesGoo(level, minutes) return math.floor(minutes * LPM * ZV[zoneOf(level)]) end
local function worldOf(x) return math.clamp(math.floor((x + 1000) / 2000) + 1, 1, NW) end
local function zoneCenter(g)
	local w, k = math.floor((g - 1) / 8) + 1, (g - 1) % 8 + 1
	local col, z = k - 1, -160
	if k &gt; 4 then
		col = 8 - k
		z = 160
	end
	return -480 + 320 * col + (w - 1) * 2000, z
end
local function gatePos(g)
	local w, k = math.floor((g - 1) / 8) + 1, (g - 1) % 8 + 1
	local ox = (w - 1) * 2000
	if k &lt;= 3 then return -320 + 320 * (k - 1) + ox, -160 end
	if k == 4 then return 480 + ox, 0 end
	if k &lt; 8 then return -320 + 320 * (7 - k) + ox, 160 end
	return nil
end
local function zoneAt(x, z)
	local w = worldOf(x)
	local col = math.clamp(math.floor((x - (w - 1) * 2000 + 640) / 320), 0, 3)
	local k = 8 - col
	if z &lt; 0 then k = col + 1 end
	return (w - 1) * 8 + k
end

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local rng = Random.new(5)
local STUD, SMOOTH = Enum.SurfaceType.Studs, Enum.SurfaceType.Smooth
local world = workspace:FindFirstChild("LickWorld")
if not world then
	world = Instance.new("Folder")
	world.Name = "LickWorld"
	world.Parent = workspace
end
local function folder(name)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = world
	return f
end
local floors, walls, gatesF, decor, hubs = folder("Floors"), folder("Walls"), folder("Gates"), folder("Decor"), folder("Hubs")

local ZC = {}
for h in string.gmatch(CFGF:WaitForChild("ZoneColors").Value, "[^,]+") do ZC[#ZC + 1] = Color3.fromHex(h) end
local function mix(a, b, t) return a:Lerp(b, t) end
local WHITE, DARK = Color3.new(1, 1, 1), Color3.fromRGB(40, 36, 70)

-- classic Roblox studs: studs = "top" (studs on top) or "all" (studs on every visible face)
local function P(parent, size, pos, color, studs, mat, shape)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	if typeof(pos) == "Vector3" then p.Position = pos else p.CFrame = pos end
	p.Color = color
	p.Material = mat or Enum.Material.Plastic
	if shape then p.Shape = shape end
	p.CastShadow = false
	local face = studs == "all" and STUD or SMOOTH
	p.TopSurface = studs and STUD or SMOOTH
	p.FrontSurface, p.BackSurface, p.LeftSurface, p.RightSurface = face, face, face, face
	p.BottomSurface = SMOOTH
	p.Parent = parent
	return p
end
local function deco(p)
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end
local function strip(parent, x1, z1, x2, z2, width, color)
	local a, b = Vector3.new(x1, 0.3, z1), Vector3.new(x2, 0.3, z2)
	local len = (b - a).Magnitude
	if len &lt; 1 then return end
	local mid = (a + b) / 2
	P(parent, Vector3.new(width, 0.6, len), CFrame.lookAt(mid, b), color, "top")
end

local function lightRing(parent, cx, cz, color)
	for i = 1, 12 do
		local a = i / 12 * math.pi * 2
		local p = P(parent, Vector3.new(2, 2, 2), Vector3.new(cx + math.cos(a) * 36, 1.3, cz + math.sin(a) * 36), color, nil, Enum.Material.Neon)
		deco(p)
		p.CanCollide = false
	end
end

for w = 1, NW do
	local ox = (w - 1) * 2000
	local city = w == 2
	local wallA = city and Color3.fromRGB(70, 70, 95) or WHITE
	local wallB = city and Color3.fromRGB(255, 190, 60) or Color3.fromRGB(255, 150, 200)

	-- floors, paths
	for k = 1, 8 do
		local g = (w - 1) * 8 + k
		local cx, cz = zoneCenter(g)
		local base = ZC[g]
		local fc = city and mix(base, Color3.fromRGB(60, 62, 82), 0.6) or mix(base, WHITE, 0.25)
		P(floors, Vector3.new(320, 2, 320), Vector3.new(cx, -1, cz), fc, "top")
		local pc = city and Color3.fromRGB(255, 210, 90) or mix(base, WHITE, 0.7)
		local gx, gz = gatePos(g)
		if gx then strip(floors, cx, cz, gx, gz, 24, pc) end
		if k &gt; 1 then
			local px, pz = gatePos(g - 1)
			if px then strip(floors, cx, cz, px, pz, 24, pc) end
		end
		-- landmark pedestal
		local lx, lz = cx + (k % 2 == 0 and 105 or -105), cz + (cz &lt; 0 and -105 or 105)
		P(floors, Vector3.new(74, 1, 74), Vector3.new(lx, 0.5, lz), mix(base, DARK, 0.25), "top")
		P(floors, Vector3.new(60, 1, 60), Vector3.new(lx, 1.1, lz), mix(base, WHITE, 0.45), "top")
	end

	-- hub plaza + spawn
	local hx, hz = zoneCenter((w - 1) * 8 + 1)
	P(hubs, Vector3.new(80, 0.8, 80), Vector3.new(hx, 0.4, hz), city and Color3.fromRGB(255, 200, 70) or Color3.fromRGB(255, 225, 245), "top")
	P(hubs, Vector3.new(60, 0.8, 60), Vector3.new(hx, 0.9, hz), city and Color3.fromRGB(90, 90, 120) or Color3.fromRGB(255, 130, 200), "top")
	lightRing(hubs, hx, hz, city and Color3.fromRGB(255, 220, 80) or Color3.fromRGB(255, 120, 220))
	if w == 1 then
		local sp = Instance.new("SpawnLocation")
		sp.Anchored = true
		sp.Neutral = true
		sp.Size = Vector3.new(14, 1, 14)
		sp.Position = Vector3.new(hx, 1.3, hz)
		sp.Color = Color3.fromRGB(255, 255, 255)
		sp.Material = Enum.Material.Plastic
		sp.TopSurface = STUD
		sp.Parent = hubs
	else
		P(hubs, Vector3.new(14, 1, 14), Vector3.new(hx, 1.3, hz), Color3.fromRGB(255, 255, 255), "top")
	end

	-- walls (studs on every face)
	local function wall(x1, z1, x2, z2, h, color)
		local a, b = Vector3.new(x1 + ox, h / 2, z1), Vector3.new(x2 + ox, h / 2, z2)
		local len = (b - a).Magnitude
		P(walls, Vector3.new(6, h, len), CFrame.lookAt((a + b) / 2, b), color, "all")
	end
	for i, x in ipairs({ -320, 0, 320 }) do
		local c = i % 2 == 0 and wallA or wallB
		wall(x, -320, x, -182, 28, c)
		wall(x, -138, x, 138, 28, c)
		wall(x, 182, x, 320, 28, c)
	end
	wall(-640, 0, 458, 0, 28, wallA)
	wall(502, 0, 640, 0, 28, wallA)
	local rim = city and Color3.fromRGB(45, 45, 70) or Color3.fromRGB(150, 90, 230)
	wall(-640, -323, 640, -323, 40, rim)
	wall(-640, 323, 640, 323, 40, rim)
	wall(-643, -320, -643, 320, 40, rim)
	wall(643, -320, 643, 320, 40, rim)

	-- gates between zones (the glowing barrier only opens for players with the level)
	for k = 1, 7 do
		local g = (w - 1) * 8 + k
		local gx, gz = gatePos(g)
		local horiz = k == 4
		local pc = ZC[g + 1]
		local function off(d) if horiz then return Vector3.new(gx + d, 0, gz) end return Vector3.new(gx, 0, gz + d) end
		for _, d in ipairs({ -24, 24 }) do
			local p = P(gatesF, Vector3.new(7, 36, 7), off(d) + Vector3.new(0, 18, 0), mix(pc, WHITE, 0.2), "all")
		end
		local lintel = P(gatesF, horiz and Vector3.new(60, 7, 7) or Vector3.new(7, 7, 60), off(0) + Vector3.new(0, 39, 0), mix(pc, WHITE, 0.1), "all")
		local barrier = P(gatesF, horiz and Vector3.new(41, 32, 3) or Vector3.new(3, 32, 41), off(0) + Vector3.new(0, 16, 0), pc, nil, Enum.Material.Neon)
		barrier.Transparency = 0.55
		barrier.CanQuery = false
		barrier.CollisionGroup = "Barrier_" .. (k + 1)
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.new(0, 240, 0, 60)
		gui.StudsOffset = Vector3.new(0, 6, 0)
		gui.MaxDistance = 140
		gui.LightInfluence = 0
		gui.Parent = lintel
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(1, 0, 1, 0)
		l.BackgroundTransparency = 1
		l.TextScaled = true
		l.Font = Enum.Font.FredokaOne
		l.TextColor3 = WHITE
		l.TextStrokeTransparency = 0
		l.Text = ZN[g + 1] .. "\nLevel " .. ZL[g + 1]
		l.Parent = gui
		CollectionService:AddTag(barrier, "LickPulse")
	end

	-- decorations in the outer band of each zone (the middle stays free for food)
	for k = 1, 8 do
		local g = (w - 1) * 8 + k
		local cx, cz = zoneCenter(g)
		local base = ZC[g]
		local lx, lz = cx + (k % 2 == 0 and 105 or -105), cz + (cz &lt; 0 and -105 or 105)
		local gp = {}
		local a, b = gatePos(g), nil
		local gx1, gz1 = gatePos(g)
		if gx1 then gp[#gp + 1] = { gx1, gz1 } end
		if k &gt; 1 then
			local px, pz = gatePos(g - 1)
			if px then gp[#gp + 1] = { px, pz } end
		end
		local made, tries = 0, 0
		while made &lt; 30 and tries &lt; 400 do
			tries = tries + 1
			local x, z = cx + rng:NextNumber(-152, 152), cz + rng:NextNumber(-152, 152)
			local band = math.max(math.abs(x - cx), math.abs(z - cz)) &gt; 120
			local ok = band and (x - lx) ^ 2 + (z - lz) ^ 2 &gt; 50 ^ 2
			for _, p in ipairs(gp) do
				if (p[1] - x) ^ 2 + (p[2] - z) ^ 2 &lt; 34 ^ 2 then ok = false end
			end
			if ok then
				made = made + 1
				local pick = rng:NextInteger(1, 4)
				local col = mix(base, WHITE, rng:NextNumber(0, 0.35))
				if not city then
					if pick == 1 then -- lollipop tree
						local h = rng:NextNumber(10, 18)
						deco(P(decor, Vector3.new(1.6, h, 1.6), Vector3.new(x, h / 2, z), WHITE))
						local d = rng:NextNumber(8, 13)
						deco(P(decor, Vector3.new(d, d, d), Vector3.new(x, h + d * 0.3, z), col, nil, Enum.Material.SmoothPlastic, Enum.PartType.Ball))
					elseif pick == 2 then -- gumdrop bush
						for i = 1, 3 do
							local d = rng:NextNumber(4, 7)
							deco(P(decor, Vector3.new(d, d, d), Vector3.new(x + rng:NextNumber(-3, 3), d * 0.4, z + rng:NextNumber(-3, 3)), Color3.fromHSV(rng:NextNumber(), 0.55, 1), nil, Enum.Material.SmoothPlastic, Enum.PartType.Ball))
						end
					elseif pick == 3 then -- candy cane
						for i = 1, 4 do
							deco(P(decor, Vector3.new(1.8, 3.5, 1.8), Vector3.new(x, i * 3.5 - 1.75, z), i % 2 == 0 and WHITE or Color3.fromRGB(235, 50, 70)))
						end
						deco(P(decor, Vector3.new(4, 1.8, 1.8), Vector3.new(x + 1.5, 14.6, z), Color3.fromRGB(235, 50, 70)))
					else -- floating star orb (animated on the client)
						local o = deco(P(decor, Vector3.new(3, 3, 3), Vector3.new(x, rng:NextNumber(14, 26), z), mix(base, WHITE, 0.4), nil, Enum.Material.Neon, Enum.PartType.Ball))
						CollectionService:AddTag(o, "LickBob")
					end
				else
					if pick == 1 then -- street lamp
						deco(P(decor, Vector3.new(1, 16, 1), Vector3.new(x, 8, z), Color3.fromRGB(70, 70, 90)))
						local l = deco(P(decor, Vector3.new(3.4, 3.4, 3.4), Vector3.new(x, 17, z), col, nil, Enum.Material.Neon, Enum.PartType.Ball))
						CollectionService:AddTag(l, "LickPulse")
					elseif pick == 2 then -- crate stack (studded)
						for i = 1, 3 do
							deco(P(decor, Vector3.new(6, 6, 6), Vector3.new(x + (i % 2) * 1.5, i * 6 - 3, z), mix(col, DARK, 0.2 * i), "all"))
						end
					elseif pick == 3 then -- soda cup tower
						for i = 1, 3 do
							deco(P(decor, Vector3.new(5 - i * 0.6, 4, 5 - i * 0.6), Vector3.new(x, i * 4 - 2, z), i % 2 == 0 and WHITE or Color3.fromRGB(225, 50, 60), nil, Enum.Material.SmoothPlastic, Enum.PartType.Cylinder))
						end
					else -- building with glowing windows (studded)
						local h = rng:NextNumber(26, 48)
						P(decor, Vector3.new(26, h, 26), Vector3.new(x, h / 2, z), mix(col, DARK, 0.45), "all")
						for i = 1, math.floor(h / 10) do
							deco(P(decor, Vector3.new(22, 2.4, 0.6), Vector3.new(x, i * 9, z - 13.1), Color3.fromRGB(255, 240, 150), nil, Enum.Material.Neon))
						end
					end
				end
			end
		end
	end

	-- sky details
	for i = 1, 12 do
		local x, z, y = ox + rng:NextNumber(-620, 620), rng:NextNumber(-300, 300), rng:NextNumber(85, 140)
		for j = 1, 3 do
			local d = rng:NextNumber(16, 28)
			local c = deco(P(decor, Vector3.new(d, d * 0.6, d), Vector3.new(x + j * 14, y + rng:NextNumber(-3, 3), z), city and Color3.fromRGB(255, 190, 90) or Color3.fromRGB(255, 235, 248), nil, Enum.Material.SmoothPlastic, Enum.PartType.Ball))
			c.Transparency = 0.15
			CollectionService:AddTag(c, "LickDrift")
		end
	end

	-- world portal (in each hub): free travel to the world you have unlocked
	local target = w % NW + 1
	local px, pz = hx, hz + 62
	for i = 1, 16 do
		local a = i / 16 * math.pi * 2
		local seg = P(hubs, Vector3.new(3, 3, 3), Vector3.new(px + math.cos(a) * 10, 12 + math.sin(a) * 10, pz), city and Color3.fromRGB(255, 220, 80) or Color3.fromRGB(190, 110, 255), nil, Enum.Material.Neon)
		seg.CanCollide = false
		CollectionService:AddTag(seg, "LickPulse")
	end
	P(hubs, Vector3.new(26, 2, 8), Vector3.new(px, 1, pz), Color3.fromRGB(70, 60, 120), "top")
	local trig = P(hubs, Vector3.new(14, 14, 3), Vector3.new(px, 8, pz), WHITE, nil, Enum.Material.Neon)
	trig.Transparency = 0.6
	trig.CanCollide = false
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Travel"
	prompt.ObjectText = WN[target]
	prompt.HoldDuration = 0.4
	prompt.MaxActivationDistance = 16
	prompt.RequiresLineOfSight = false
	prompt.Parent = trig
	prompt.Triggered:Connect(function(plr)
		if not rate(plr, "portal", 2) or not plr:GetAttribute("DataReady") then return end
		local need = ZL[(target - 1) * 8 + 1]
		local best = state(plr, "BestLevel", "IntValue", 1).Value
		if target &gt; w and best &lt; need then
			notify(plr, WN[target] .. " opens at Level " .. need, "error")
			return
		end
		local tx, tz = zoneCenter((target - 1) * 8 + 1)
		if plr.Character then plr.Character:PivotTo(CFrame.new(tx, 6, tz + 20)) end
		remotes.Celebrate:FireClient(plr, "world", WN[target])
	end)
end

-- lighting (you can still adjust any of this in Studio afterwards)
Lighting.ClockTime = 14.5
Lighting.Brightness = 2.4
Lighting.GlobalShadows = true
Lighting.Ambient = Color3.fromRGB(95, 90, 120)
Lighting.OutdoorAmbient = Color3.fromRGB(125, 120, 150)
Lighting.ExposureCompensation = 0.1
for _, c in ipairs(Lighting:GetChildren()) do
	if c:IsA("Atmosphere") or c:IsA("BloomEffect") or c:IsA("ColorCorrectionEffect") or c:IsA("SunRaysEffect") then c:Destroy() end
end
local at = Instance.new("Atmosphere")
at.Density = 0.28
at.Offset = 0.25
at.Color = Color3.fromRGB(215, 205, 255)
at.Decay = Color3.fromRGB(255, 190, 230)
at.Haze = 1.2
at.Glare = 0.3
at.Name = "LickAtmosphere"
at.Parent = Lighting
local bl = Instance.new("BloomEffect")
bl.Intensity = 0.35
bl.Size = 24
bl.Threshold = 1.1
bl.Parent = Lighting
local cc = Instance.new("ColorCorrectionEffect")
cc.Name = "LickColor"
cc.Contrast = 0.1
cc.Saturation = 0.22
cc.Parent = Lighting
local sr = Instance.new("SunRaysEffect")
sr.Intensity = 0.07
sr.Spread = 0.8
sr.Parent = Lighting
if not Lighting:FindFirstChildOfClass("Sky") then Instance.new("Sky").Parent = Lighting end
print("[LickWorld] ready: " .. NW .. " worlds")
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX16">
        <Properties>
          <string name="Name">LickProgress</string>
          <ProtectedString name="Source">-- LICK PROGRESS (server Script)  Location: ServerScriptService &gt; LickProgress
-- Levels (buying), milestone rewards, zone/world unlock celebrations, upgrade caps, Auto Upgrade, REBIRTH.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local HttpService = game:GetService("HttpService")
local remotes = ReplicatedStorage:WaitForChild("LickRemotes")
local bus = ServerStorage:WaitForChild("LickBus")
local function notify(plr, text, sfx) remotes.Notify:FireClient(plr, text, sfx) end
local function jdec(s)
	local ok, t = pcall(function() return HttpService:JSONDecode(s) end)
	if ok and type(t) == "table" then return t end
	return {}
end
local function jenc(t) return HttpService:JSONEncode(t) end
local function ready(plr)
	while plr.Parent and not plr:GetAttribute("DataReady") do task.wait(0.25) end
	return plr.Parent ~= nil
end
local function state(plr, name, class, default)
	local f = plr:FindFirstChild("LickState")
	if not f then
		f = Instance.new("Folder")
		f.Name = "LickState"
		f.Parent = plr
	end
	local v = f:FindFirstChild(name)
	if not v then
		v = Instance.new(class)
		v.Name = name
		v.Value = default
		v.Parent = f
	end
	return v
end
local rateT = {}
local function rate(plr, key, gap)
	local k = plr.UserId .. key
	local now = os.clock()
	if rateT[k] and now - rateT[k] &lt; gap then return false end
	rateT[k] = now
	return true
end
local function stat(plr, key, n) bus.Stat:Fire(plr, key, n or 1) end
local function grant(plr, reward, why) bus.Grant:Fire(plr, reward, why) end

local CFGF = ReplicatedStorage:WaitForChild("LickConfig")
local function csv(name)
	local t = {}
	for n in string.gmatch(CFGF:WaitForChild(name).Value, "[^,]+") do t[#t + 1] = tonumber(n) end
	return t
end
local COSTS, ZL, ZV = csv("LevelCosts"), csv("ZoneLevels"), csv("ZoneValues")
local ZN, WN = {}, {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
for n in string.gmatch(CFGF:WaitForChild("WorldNames").Value, "[^|]+") do WN[#WN + 1] = n end
local NW = #WN
local ZN = {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
local MAXLV = CFGF:GetAttribute("MaxLevel") or 400
local LPM = CFGF:GetAttribute("LPM") or 150
local function zoneOf(level)
	local z = 1
	for i = 1, #ZL do
		if level &gt;= ZL[i] then z = i end
	end
	return z
end
local function minutesGoo(level, minutes) return math.floor(minutes * LPM * ZV[zoneOf(level)]) end
local function worldOf(x) return math.clamp(math.floor((x + 1000) / 2000) + 1, 1, NW) end
local function zoneCenter(g)
	local w, k = math.floor((g - 1) / 8) + 1, (g - 1) % 8 + 1
	local col, z = k - 1, -160
	if k &gt; 4 then
		col = 8 - k
		z = 160
	end
	return -480 + 320 * col + (w - 1) * 2000, z
end
local function gatePos(g)
	local w, k = math.floor((g - 1) / 8) + 1, (g - 1) % 8 + 1
	local ox = (w - 1) * 2000
	if k &lt;= 3 then return -320 + 320 * (k - 1) + ox, -160 end
	if k == 4 then return 480 + ox, 0 end
	if k &lt; 8 then return -320 + 320 * (7 - k) + ox, 160 end
	return nil
end
local function zoneAt(x, z)
	local w = worldOf(x)
	local col = math.clamp(math.floor((x - (w - 1) * 2000 + 640) / 320), 0, 3)
	local k = 8 - col
	if z &lt; 0 then k = col + 1 end
	return (w - 1) * 8 + k
end

local REBIRTH_START = CFGF:GetAttribute("RebirthStart") or 100
local REBIRTH_STEP = CFGF:GetAttribute("RebirthStep") or 10
local MILE_COSM = { [25] = "trail_sprinkle", [50] = "aura_bubble", [75] = "trail_comet", [100] = "title_crown", [125] = "aura_star", [150] = "burst_confetti", [175] = "glow_legend", [200] = "title_champion", [300] = "title_legend", [400] = "aura_legend" }
local REBIRTH_COSM = { [1] = "title_r1", [5] = "trail_goo", [10] = "aura_goo", [25] = "burst_gold", [50] = "glow_royal", [100] = "title_god" }
local FEATURES = { [3] = "Shop upgrades unlocked!", [5] = "Daily quests unlocked!", [10] = "Food Index mastery unlocked!", [20] = "Weekly quests unlocked!", [40] = "Achievements unlocked!", [100] = "REBIRTH unlocked! Level up to Lv 100 and rebirth for permanent bonuses." }

local function reqLevel(rebirths) return math.min(MAXLV, REBIRTH_START + REBIRTH_STEP * rebirths) end

local function updateAttrs(plr)
	local stats = plr:FindFirstChild("leaderstats")
	if not stats then return end
	local best = state(plr, "BestLevel", "IntValue", 1).Value
	local cap = 10
	for _, lv in ipairs({ 50, 100, 150, 250, 350 }) do
		if best &gt;= lv then cap = cap + 5 end
	end
	plr:SetAttribute("UpgradeCap", cap)
	local level = stats.Tongue.Value
	local cb = 1
	if stats.Rebirths.Value &gt; 0 and best &gt; level then cb = 1 + (best - level) / best end
	plr:SetAttribute("Comeback", cb)
	plr:SetAttribute("BestZone", zoneOf(best))
end

local function levelUp(plr, L, newBest)
	local stats = plr:FindFirstChild("leaderstats")
	local runMile = state(plr, "RunMile", "IntValue", 0)
	if L &gt; runMile.Value then
		if L % 5 == 0 then grant(plr, { gooMin = 1 }, "Level " .. L .. " gift") end
		if L % 10 == 0 then
			local boost = 15
			if L &gt;= 100 then boost = 30 end
			grant(plr, { boostMin = boost, rolls = 1 }, "Level " .. L .. " reward")
		end
		runMile.Value = L
	end
	if newBest then
		local c = MILE_COSM[L]
		if c then grant(plr, { cosmetic = c }, "Level " .. L .. " milestone") end
		if L == 200 then grant(plr, { cosmetic = "skin_champion" }, "Level 200 champion") end
		if FEATURES[L] then remotes.Celebrate:FireClient(plr, "feature", FEATURES[L]) end
		for z = 2, #ZL do
			if ZL[z] == L then
				remotes.Celebrate:FireClient(plr, "zone", z)
				stat(plr, "zones", z)
				if (z - 1) % 8 == 0 then remotes.Celebrate:FireClient(plr, "feature", WN[math.floor((z - 1) / 8) + 1] .. " is open! Use the portal in the hub.") end
			end
		end
		stat(plr, "level", L)
	end
end

local function buy(plr, amount)
	local stats = plr:FindFirstChild("leaderstats")
	if not stats or not plr:GetAttribute("DataReady") then return end
	local bestV = state(plr, "BestLevel", "IntValue", 1)
	local bought, oldBest = 0, bestV.Value
	local start = stats.Tongue.Value
	while bought &lt; amount and stats.Tongue.Value &lt; MAXLV do
		local cost = COSTS[stats.Tongue.Value]
		if stats.Goo.Value &lt; cost then break end
		stats.Goo.Value = stats.Goo.Value - cost
		stats.Tongue.Value = stats.Tongue.Value + 1
		bought = bought + 1
		local L = stats.Tongue.Value
		local nb = L &gt; bestV.Value
		if nb then bestV.Value = L end
		levelUp(plr, L, nb)
	end
	if bought == 0 then
		if rate(plr, "poor", 1.5) then
			local nextCost = COSTS[stats.Tongue.Value]
			notify(plr, nextCost and ("Not enough goo! Need " .. nextCost) or "You are at the highest level!", "error")
		end
		return
	end
	stat(plr, "upgrades", bought)
	updateAttrs(plr)
	remotes.Celebrate:FireClient(plr, "level", stats.Tongue.Value, bought)
end

remotes.BuyTongue.OnServerEvent:Connect(function(plr, amount)
	if not rate(plr, "buylv", 0.12) then return end
	if typeof(amount) ~= "number" then return end
	buy(plr, math.clamp(math.floor(amount), 1, 100))
end)

remotes.Rebirth.OnServerEvent:Connect(function(plr)
	if not rate(plr, "rebirth", 2) or not plr:GetAttribute("DataReady") then return end
	local stats = plr:FindFirstChild("leaderstats")
	if not stats then return end
	local R = stats.Rebirths.Value
	local need = reqLevel(R)
	if stats.Tongue.Value &lt; need then
		notify(plr, "Reach Level " .. need .. " to rebirth!", "error")
		return
	end
	stats.Tongue.Value = 1
	stats.Goo.Value = 0
	stats.Rebirths.Value = R + 1
	state(plr, "RunMile", "IntValue", 0).Value = 0
	updateAttrs(plr)
	local hx, hz = zoneCenter(1)
	if plr.Character then plr.Character:PivotTo(CFrame.new(hx, 6, hz + 20)) end
	grant(plr, { boostMin = 30 }, "Rebirth bonus")
	local c = REBIRTH_COSM[R + 1]
	if c then grant(plr, { cosmetic = c }, "Rebirth " .. (R + 1)) end
	stat(plr, "rebirths", R + 1)
	remotes.Celebrate:FireClient(plr, "rebirth", R + 1)
	task.spawn(function() bus.SaveNow:Invoke(plr) end)
end)

remotes.TutorialAction.OnServerEvent:Connect(function(plr, action, v)
	if not rate(plr, "tut", 0.4) or typeof(action) ~= "string" or not plr:GetAttribute("DataReady") then return end
	local sv = state(plr, "Tut", "StringValue", "{}")
	local d = jdec(sv.Value)
	if action == "step" and typeof(v) == "number" then
		d.state = "active"
		d.step = math.clamp(math.floor(v), 0, 10)
	elseif action == "skip" then
		d.state = "skipped"
	elseif action == "done" then
		if not d.rewarded then
			d.rewarded = true
			grant(plr, { gooMin = 5, rolls = 1 }, "Tutorial complete")
		end
		d.state = "done"
	elseif action == "replay" then
		d.state = "active"
		d.step = 0
	else
		return
	end
	sv.Value = jenc(d)
end)

remotes.SaveSettings.OnServerEvent:Connect(function(plr, json)
	if not rate(plr, "settings", 0.5) or typeof(json) ~= "string" or #json &gt; 200 then return end
	local t = jdec(json)
	state(plr, "Settings", "StringValue", "{}").Value = jenc({ sfx = math.clamp(tonumber(t.sfx) or 1, 0, 1), fx = math.clamp(math.floor(tonumber(t.fx) or 3), 1, 3) })
end)

local function setup(plr)
	if not ready(plr) then return end
	local stats = plr.leaderstats
	updateAttrs(plr)
	stats.Tongue.Changed:Connect(function() updateAttrs(plr) end)
	state(plr, "BestLevel", "IntValue", 1).Changed:Connect(function() updateAttrs(plr) end)
	stats.Rebirths.Changed:Connect(function() updateAttrs(plr) end)
	task.spawn(function()
		while plr.Parent do
			task.wait(1)
			if plr:GetAttribute("AutoUpgrade") and stats.Tongue.Value &lt; MAXLV and stats.Goo.Value &gt;= COSTS[stats.Tongue.Value] then buy(plr, 1) end
		end
	end)
end
Players.PlayerAdded:Connect(function(plr) task.spawn(setup, plr) end)
for _, plr in ipairs(Players:GetPlayers()) do task.spawn(setup, plr) end
print("[LickProgress] ready")
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX17">
        <Properties>
          <string name="Name">LickShop</string>
          <ProtectedString name="Source">-- LICK SHOP (server Script)  Location: ServerScriptService &gt; LickShop
-- Upgrades (Walk Speed, Lick Speed, Lucky Lick) and the Free gift. (Skin rolls live in LickRewards.)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local HttpService = game:GetService("HttpService")
local remotes = ReplicatedStorage:WaitForChild("LickRemotes")
local bus = ServerStorage:WaitForChild("LickBus")
local function notify(plr, text, sfx) remotes.Notify:FireClient(plr, text, sfx) end
local function jdec(s)
	local ok, t = pcall(function() return HttpService:JSONDecode(s) end)
	if ok and type(t) == "table" then return t end
	return {}
end
local function jenc(t) return HttpService:JSONEncode(t) end
local function ready(plr)
	while plr.Parent and not plr:GetAttribute("DataReady") do task.wait(0.25) end
	return plr.Parent ~= nil
end
local function state(plr, name, class, default)
	local f = plr:FindFirstChild("LickState")
	if not f then
		f = Instance.new("Folder")
		f.Name = "LickState"
		f.Parent = plr
	end
	local v = f:FindFirstChild(name)
	if not v then
		v = Instance.new(class)
		v.Name = name
		v.Value = default
		v.Parent = f
	end
	return v
end
local rateT = {}
local function rate(plr, key, gap)
	local k = plr.UserId .. key
	local now = os.clock()
	if rateT[k] and now - rateT[k] &lt; gap then return false end
	rateT[k] = now
	return true
end
local function stat(plr, key, n) bus.Stat:Fire(plr, key, n or 1) end
local function grant(plr, reward, why) bus.Grant:Fire(plr, reward, why) end

local CFGF = ReplicatedStorage:WaitForChild("LickConfig")
local function csv(name)
	local t = {}
	for n in string.gmatch(CFGF:WaitForChild(name).Value, "[^,]+") do t[#t + 1] = tonumber(n) end
	return t
end
local COSTS, ZL, ZV = csv("LevelCosts"), csv("ZoneLevels"), csv("ZoneValues")
local ZN, WN = {}, {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
for n in string.gmatch(CFGF:WaitForChild("WorldNames").Value, "[^|]+") do WN[#WN + 1] = n end
local NW = #WN
local ZN = {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
local MAXLV = CFGF:GetAttribute("MaxLevel") or 400
local LPM = CFGF:GetAttribute("LPM") or 150
local function zoneOf(level)
	local z = 1
	for i = 1, #ZL do
		if level &gt;= ZL[i] then z = i end
	end
	return z
end
local function minutesGoo(level, minutes) return math.floor(minutes * LPM * ZV[zoneOf(level)]) end
local function worldOf(x) return math.clamp(math.floor((x + 1000) / 2000) + 1, 1, NW) end
local function zoneCenter(g)
	local w, k = math.floor((g - 1) / 8) + 1, (g - 1) % 8 + 1
	local col, z = k - 1, -160
	if k &gt; 4 then
		col = 8 - k
		z = 160
	end
	return -480 + 320 * col + (w - 1) * 2000, z
end
local function gatePos(g)
	local w, k = math.floor((g - 1) / 8) + 1, (g - 1) % 8 + 1
	local ox = (w - 1) * 2000
	if k &lt;= 3 then return -320 + 320 * (k - 1) + ox, -160 end
	if k == 4 then return 480 + ox, 0 end
	if k &lt; 8 then return -320 + 320 * (7 - k) + ox, 160 end
	return nil
end
local function zoneAt(x, z)
	local w = worldOf(x)
	local col = math.clamp(math.floor((x - (w - 1) * 2000 + 640) / 320), 0, 3)
	local k = 8 - col
	if z &lt; 0 then k = col + 1 end
	return (w - 1) * 8 + k
end

local UPGRADES = {
	speed = { attr = "Speed", label = "Walk Speed", base = 0.5 },
	lickspeed = { attr = "LickSpeed", label = "Lick Speed", base = 0.8 },
	lucky = { attr = "Lucky", label = "Lucky Lick", base = 1.5 },
}
local FREE_COOLDOWN = 120

-- price = minutes of income at your best zone, so it always matches the economy
local function cost(def, lvl, best) return math.floor(def.base * (lvl + 1) ^ 1.7 * LPM * ZV[zoneOf(best)]) end

local function sync(plr)
	local best = state(plr, "BestLevel", "IntValue", 1).Value
	local cap = plr:GetAttribute("UpgradeCap") or 10
	for _, def in pairs(UPGRADES) do
		local lvl = plr:GetAttribute(def.attr .. "Lvl") or 0
		plr:SetAttribute(def.attr .. "Lvl", lvl)
		plr:SetAttribute(def.attr .. "Cost", lvl &gt;= cap and 0 or cost(def, lvl, best))
	end
	plr:SetAttribute("FreeCost", minutesGoo(best, 6))
end

remotes.BuyUpgrade.OnServerEvent:Connect(function(plr, key)
	if not rate(plr, "upg", 0.3) or typeof(key) ~= "string" or not plr:GetAttribute("DataReady") then return end
	local def = UPGRADES[key]
	local stats = plr:FindFirstChild("leaderstats")
	if not def or not stats then return end
	sync(plr)
	local lvl = plr:GetAttribute(def.attr .. "Lvl") or 0
	local cap = plr:GetAttribute("UpgradeCap") or 10
	if lvl &gt;= cap then
		notify(plr, def.label .. " is at its maximum for now. More at Lv 50, 100, 150!", "error")
		return
	end
	local c = plr:GetAttribute(def.attr .. "Cost") or 0
	if stats.Goo.Value &lt; c then
		notify(plr, "Not enough goo! Need " .. c, "error")
		return
	end
	stats.Goo.Value = stats.Goo.Value - c
	plr:SetAttribute(def.attr .. "Lvl", lvl + 1)
	sync(plr)
	stat(plr, "upgrades", 1)
	notify(plr, def.label .. " Lv " .. (lvl + 1) .. "!", "chime")
end)

remotes.Free.OnServerEvent:Connect(function(plr)
	if not rate(plr, "free", 1) or not plr:GetAttribute("DataReady") then return end
	if os.time() &lt; (plr:GetAttribute("NextFree") or 0) then
		notify(plr, "Free gift not ready yet!", "error")
		return
	end
	local gap, mins = FREE_COOLDOWN, 0.5
	if plr:GetAttribute("GiftBoost") then
		gap = 60
		mins = 1
	end
	plr:SetAttribute("NextFree", os.time() + gap)
	grant(plr, { gooMin = mins }, "Free gift")
end)

local function setup(plr)
	plr:SetAttribute("NextFree", os.time())
	if not ready(plr) then return end
	sync(plr)
	for _, a in ipairs({ "UpgradeCap" }) do plr:GetAttributeChangedSignal(a):Connect(function() sync(plr) end) end
	state(plr, "BestLevel", "IntValue", 1).Changed:Connect(function() sync(plr) end)
end
Players.PlayerAdded:Connect(function(plr) task.spawn(setup, plr) end)
for _, plr in ipairs(Players:GetPlayers()) do task.spawn(setup, plr) end
print("[LickShop] ready")
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX18">
        <Properties>
          <string name="Name">LickRewards</string>
          <ProtectedString name="Source">-- LICK REWARDS (server Script)  Location: ServerScriptService &gt; LickRewards
-- Reward handler for the whole game (goo, boosts, free rolls, cosmetics), cosmetic equipping,
-- the server-decided SKIN ROLL (with real odds) and REDEEM CODES.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local HttpService = game:GetService("HttpService")
local remotes = ReplicatedStorage:WaitForChild("LickRemotes")
local bus = ServerStorage:WaitForChild("LickBus")
local function notify(plr, text, sfx) remotes.Notify:FireClient(plr, text, sfx) end
local function jdec(s)
	local ok, t = pcall(function() return HttpService:JSONDecode(s) end)
	if ok and type(t) == "table" then return t end
	return {}
end
local function jenc(t) return HttpService:JSONEncode(t) end
local function ready(plr)
	while plr.Parent and not plr:GetAttribute("DataReady") do task.wait(0.25) end
	return plr.Parent ~= nil
end
local function state(plr, name, class, default)
	local f = plr:FindFirstChild("LickState")
	if not f then
		f = Instance.new("Folder")
		f.Name = "LickState"
		f.Parent = plr
	end
	local v = f:FindFirstChild(name)
	if not v then
		v = Instance.new(class)
		v.Name = name
		v.Value = default
		v.Parent = f
	end
	return v
end
local rateT = {}
local function rate(plr, key, gap)
	local k = plr.UserId .. key
	local now = os.clock()
	if rateT[k] and now - rateT[k] &lt; gap then return false end
	rateT[k] = now
	return true
end
local function stat(plr, key, n) bus.Stat:Fire(plr, key, n or 1) end
local function grant(plr, reward, why) bus.Grant:Fire(plr, reward, why) end

local CFGF = ReplicatedStorage:WaitForChild("LickConfig")
local function csv(name)
	local t = {}
	for n in string.gmatch(CFGF:WaitForChild(name).Value, "[^,]+") do t[#t + 1] = tonumber(n) end
	return t
end
local COSTS, ZL, ZV = csv("LevelCosts"), csv("ZoneLevels"), csv("ZoneValues")
local ZN, WN = {}, {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
for n in string.gmatch(CFGF:WaitForChild("WorldNames").Value, "[^|]+") do WN[#WN + 1] = n end
local NW = #WN
local ZN = {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
local MAXLV = CFGF:GetAttribute("MaxLevel") or 400
local LPM = CFGF:GetAttribute("LPM") or 150
local function zoneOf(level)
	local z = 1
	for i = 1, #ZL do
		if level &gt;= ZL[i] then z = i end
	end
	return z
end
local function minutesGoo(level, minutes) return math.floor(minutes * LPM * ZV[zoneOf(level)]) end
local function worldOf(x) return math.clamp(math.floor((x + 1000) / 2000) + 1, 1, NW) end
local function zoneCenter(g)
	local w, k = math.floor((g - 1) / 8) + 1, (g - 1) % 8 + 1
	local col, z = k - 1, -160
	if k &gt; 4 then
		col = 8 - k
		z = 160
	end
	return -480 + 320 * col + (w - 1) * 2000, z
end
local function gatePos(g)
	local w, k = math.floor((g - 1) / 8) + 1, (g - 1) % 8 + 1
	local ox = (w - 1) * 2000
	if k &lt;= 3 then return -320 + 320 * (k - 1) + ox, -160 end
	if k == 4 then return 480 + ox, 0 end
	if k &lt; 8 then return -320 + 320 * (7 - k) + ox, 160 end
	return nil
end
local function zoneAt(x, z)
	local w = worldOf(x)
	local col = math.clamp(math.floor((x - (w - 1) * 2000 + 640) / 320), 0, 3)
	local k = 8 - col
	if z &lt; 0 then k = col + 1 end
	return (w - 1) * 8 + k
end

local PolicyService = game:GetService("PolicyService")
local rng = Random.new()

-- ===== cosmetics: slot = trail / aura / title / burst / glow / skin =====
local CAT = {
	trail_sprinkle = { "trail", "Sprinkle Trail", "UNCOMMON" }, aura_bubble = { "aura", "Bubble Aura", "RARE" },
	trail_comet = { "trail", "Candy Comet Trail", "EPIC" }, title_crown = { "title", "Gold Crown", "EPIC" },
	aura_star = { "aura", "Starlight Aura", "EPIC" }, burst_confetti = { "burst", "Confetti Lick Burst", "EPIC" },
	glow_legend = { "glow", "Legend Glow", "LEGENDARY" }, title_champion = { "title", "Champion", "LEGENDARY" },
	skin_champion = { "skin", "Champion Pink", "LEGENDARY", "ff4fa0" }, title_legend = { "title", "Legend", "LEGENDARY" },
	aura_legend = { "aura", "Legend Aura", "MYTHICAL" }, title_r1 = { "title", "Reborn", "RARE" },
	trail_goo = { "trail", "Gooey Trail", "EPIC" }, aura_goo = { "aura", "Goo Aura", "EPIC" },
	burst_gold = { "burst", "Golden Burst", "LEGENDARY" }, glow_royal = { "glow", "Royal Glow", "LEGENDARY" },
	title_god = { "title", "Lick God", "MYTHICAL" }, trail_frost = { "trail", "Frost Sprinkles", "RARE" },
	aura_party = { "aura", "Launch Party Aura", "EPIC" }, title_early = { "title", "Early Licker", "RARE" },
	title_taster = { "title", "Master Taster", "EPIC" }, title_loyal = { "title", "Loyal Licker", "EPIC" },
}
-- skin roll table: id, name, rarity, weight (percent, total 100), color
local SKINS = {
	{ "skin_hotpink", "Hot Pink", "COMMON", 14, "ff1493" }, { "skin_banana", "Banana", "COMMON", 13, "fff03c" }, { "skin_ghost", "Ghost White", "COMMON", 13, "f0f0ff" },
	{ "skin_toxic", "Toxic Green", "UNCOMMON", 9, "39ff14" }, { "skin_berry", "Blue Raspberry", "UNCOMMON", 8, "008cff" }, { "skin_lava", "Lava Orange", "UNCOMMON", 8, "ff6400" },
	{ "skin_grape", "Grape Soda", "RARE", 7, "9632ff" }, { "skin_mint", "Mint Frost", "RARE", 7, "7dffd0" }, { "skin_cherry", "Cherry Blast", "RARE", 6, "d2143c" },
	{ "skin_black", "Cursed Black", "EPIC", 4, "28282f" }, { "skin_aurora", "Aurora", "EPIC", 3.5, "5affb4" }, { "skin_sunset", "Sunset Swirl", "EPIC", 2.5, "ff7a5a" },
	{ "skin_teal", "Cosmic Teal", "LEGENDARY", 2.5, "00ffdc" }, { "skin_gold", "Golden Glaze", "LEGENDARY", 2, "ffc800" },
	{ "skin_prism", "Prismatic", "MYTHICAL", 0.5, "ffffff" },
}
for _, s in ipairs(SKINS) do CAT[s[1]] = { "skin", s[2], s[3], s[5] } end

local SLOT_ATTR = { trail = "CosTrail", aura = "CosAura", title = "CosTitle", burst = "CosBurst", glow = "CosGlow", skin = "CosSkin" }

-- publish the catalog + odds so the menus show exactly what the server uses
do
	local t = {}
	for id, c in pairs(CAT) do t[id] = { c[1], c[2], c[3], c[4] } end
	local sv = Instance.new("StringValue")
	sv.Name = "Cosmetics"
	sv.Value = jenc(t)
	sv.Parent = ReplicatedStorage:WaitForChild("LickConfig")
	local parts = {}
	for _, s in ipairs(SKINS) do parts[#parts + 1] = s[1] .. "|" .. s[2] .. "|" .. s[3] .. "|" .. s[4] .. "|" .. s[5] end
	local o = Instance.new("StringValue")
	o.Name = "LickSkinOdds"
	o.Value = table.concat(parts, ";")
	o.Parent = ReplicatedStorage
end

local function cosm(plr) return state(plr, "Cosm", "StringValue", "{}") end

local function equip(plr, id, slot)
	local c = CAT[id]
	if id == "" then
		plr:SetAttribute(SLOT_ATTR[slot], nil)
		if slot == "skin" then plr:SetAttribute("TongueColor", nil) end
		return
	end
	if not c then return end
	plr:SetAttribute(SLOT_ATTR[c[1]], id)
	if c[1] == "skin" then
		if id == "skin_prism" then plr:SetAttribute("TongueColor", nil) else plr:SetAttribute("TongueColor", Color3.fromHex(c[4])) end
	end
end

local function addCosmetic(plr, id, silent)
	local c = CAT[id]
	if not c then return false end
	local v = cosm(plr)
	local d = jdec(v.Value)
	d.own = d.own or {}
	d.eq = d.eq or {}
	if d.own[id] then return false end
	d.own[id] = true
	if not d.eq[c[1]] or c[1] == "skin" then
		d.eq[c[1]] = id
		equip(plr, id, c[1])
	end
	v.Value = jenc(d)
	if not silent then remotes.Reveal:FireClient(plr, "cosmetic", id, c[3], c[2], c[1]) end
	return true
end

bus.Grant.Event:Connect(function(plr, r, why)
	local stats = plr:FindFirstChild("leaderstats")
	if not stats or type(r) ~= "table" or not plr:GetAttribute("DataReady") then return end
	local goo = (r.goo or 0)
	if r.gooMin then goo = goo + minutesGoo(state(plr, "BestLevel", "IntValue", 1).Value, r.gooMin) end
	if goo &gt; 0 then
		stats.Goo.Value = stats.Goo.Value + goo
		local tg = state(plr, "TotalGoo", "NumberValue", 0)
		tg.Value = tg.Value + goo
		remotes.Celebrate:FireClient(plr, "reward", goo, why or "Reward")
	end
	if r.boostMin then plr:SetAttribute("BoostUntil", math.max(os.time(), plr:GetAttribute("BoostUntil") or 0) + r.boostMin * 60) end
	if r.rolls then plr:SetAttribute("FreeRolls", (plr:GetAttribute("FreeRolls") or 0) + r.rolls) end
	if r.cosmetic then addCosmetic(plr, r.cosmetic, r.silent) end
	if (r.boostMin or r.rolls) and goo == 0 then
		local bits = {}
		if r.boostMin then bits[#bits + 1] = "x2 goo boost (" .. r.boostMin .. " min)" end
		if r.rolls then bits[#bits + 1] = r.rolls .. " free skin roll" end
		notify(plr, (why or "Reward") .. ": " .. table.concat(bits, " + "), "chime")
	end
end)

remotes.EquipCosmetic.OnServerEvent:Connect(function(plr, slot, id)
	if not rate(plr, "equip", 0.4) or typeof(slot) ~= "string" or typeof(id) ~= "string" or not SLOT_ATTR[slot] then return end
	local v = cosm(plr)
	local d = jdec(v.Value)
	d.own = d.own or {}
	d.eq = d.eq or {}
	if id ~= "" and (not d.own[id] or not CAT[id] or CAT[id][1] ~= slot) then return end
	d.eq[slot] = id ~= "" and id or nil
	v.Value = jenc(d)
	equip(plr, id, slot)
end)

-- ===== SKIN ROLL: the SERVER picks the result; the screen only shows it =====
local lastAnnounce = 0
local function rollOne()
	local pick = rng:NextNumber(0, 100)
	for _, s in ipairs(SKINS) do
		pick = pick - s[4]
		if pick &lt;= 0 then return s end
	end
	return SKINS[1]
end
remotes.BuySkin.OnServerEvent:Connect(function(plr)
	if not rate(plr, "roll", 2) or not plr:GetAttribute("DataReady") then return end
	local stats = plr:FindFirstChild("leaderstats")
	if not stats then return end
	if plr:GetAttribute("NoPaidRandom") then
		notify(plr, "Skin rolls are not available in your region.", "error")
		return
	end
	local rolls = plr:GetAttribute("FreeRolls") or 0
	if rolls &gt; 0 then
		plr:SetAttribute("FreeRolls", rolls - 1)
	else
		local c = minutesGoo(state(plr, "BestLevel", "IntValue", 1).Value, 6)
		if stats.Goo.Value &lt; c then
			notify(plr, "Not enough goo! A roll costs " .. c, "error")
			return
		end
		stats.Goo.Value = stats.Goo.Value - c
	end
	local s = rollOne()
	local d = jdec(cosm(plr).Value)
	local isNew = not (d.own and d.own[s[1]])
	addCosmetic(plr, s[1], true)
	equip(plr, s[1], "skin")
	stat(plr, "skins", 1)
	remotes.Reveal:FireClient(plr, "roll", s[1], s[3], s[2], s[4], isNew)
	if s[3] == "MYTHICAL" and os.time() - lastAnnounce &gt; 20 then
		lastAnnounce = os.time()
		for _, p in ipairs(Players:GetPlayers()) do remotes.Celebrate:FireClient(p, "announce", plr.Name .. " just rolled the MYTHICAL " .. s[2] .. " skin!") end
	end
end)

-- region check for paid random items (matters once goo can be bought with Robux)
Players.PlayerAdded:Connect(function(plr)
	task.spawn(function()
		local ok, info = pcall(function() return PolicyService:GetPolicyInfoForPlayerAsync(plr) end)
		if ok and info and info.ArePaidRandomItemsRestricted then plr:SetAttribute("NoPaidRandom", true) end
	end)
	task.spawn(function()
		if ready(plr) then
			local d = jdec(cosm(plr).Value)
			for slot, id in pairs(d.eq or {}) do if CAT[id] then equip(plr, id, slot) end end
		end
	end)
end)

-- ===== REDEEM CODES: add new codes here. expires = "YYYY-MM-DD" (optional) =====
local CODES = {
	WELCOME = { gooMin = 10, boostMin = 15 },
	LICKLAND = { gooMin = 20, rolls = 2 },
	EARLYLICKER = { gooMin = 30, cosmetic = "title_early" },
	SLURP = { boostMin = 30, expires = "2027-06-30" },
	OLDCODE = { gooMin = 5, expires = "2025-01-01" },
}
local function expiry(s)
	local y, m, d = string.match(s or "", "(%d+)-(%d+)-(%d+)")
	if not y then return nil end
	return os.time({ year = tonumber(y), month = tonumber(m), day = tonumber(d), hour = 23, min = 59, sec = 59 })
end
remotes.RedeemCode.OnServerInvoke = function(plr, code)
	if not rate(plr, "code", 1.5) then return false, "Slow down a little!" end
	if typeof(code) ~= "string" or not plr:GetAttribute("DataReady") then return false, "Try again in a moment." end
	code = string.upper(string.gsub(code, "%s+", ""))
	local def = CODES[code]
	if code == "" or not def then return false, "That code is not valid." end
	local ex = expiry(def.expires)
	if ex and os.time() &gt; ex then return false, "That code has expired." end
	local v = state(plr, "Codes", "StringValue", "{}")
	local d = jdec(v.Value)
	d.used = d.used or {}
	if d.used[code] then return false, "You already redeemed this code." end
	d.used[code] = os.time()
	v.Value = jenc(d)
	grant(plr, { gooMin = def.gooMin, boostMin = def.boostMin, rolls = def.rolls, cosmetic = def.cosmetic }, "Code " .. code)
	stat(plr, "codes", 1)
	task.spawn(function() bus.SaveNow:Invoke(plr) end)
	return true, "Code redeemed! Rewards added."
end
print("[LickRewards] ready")
