local function bounce(sc, from)
	sc.Scale = from or 0.85
	TweenService:Create(sc, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end
local function popIn(obj)
	local sc = Instance.new("UIScale")
	sc.Scale = 0.6
	sc.Parent = obj
	TweenService:Create(sc, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end
local function button(parent, str, size, pos, c1, c2, ts, idle)
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Size = size
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.new(pos.X.Scale + size.X.Scale * 0.5, pos.X.Offset + size.X.Offset * 0.5, pos.Y.Scale + size.Y.Scale * 0.5, pos.Y.Offset + size.Y.Offset * 0.5)
	holder.Parent = parent
	local pop = Instance.new("UIScale")
	pop.Parent = holder
	local wrap = Instance.new("Frame")
	wrap.BackgroundTransparency = 1
	wrap.Size = UDim2.new(1, 0, 1, 0)
	wrap.Parent = holder
	if idle then
		local ps = Instance.new("UIScale")
		ps.Parent = wrap
		TweenService:Create(ps, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = 1.07 }):Play()
	end
	local vis = box(wrap, UDim2.new(1, 0, 1, 0), UDim2.new(0, 0, 0, 0), c1, c2, nil, true)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 1, 0)
	b.BackgroundTransparency = 1
	b.Font = FONT
	b.Text = str
	b.TextSize = ts or 22
	b.TextColor3 = WHITE
	b.TextStrokeColor3 = DARK
	b.TextStrokeTransparency = 0
	b.ZIndex = 2
	b.Parent = wrap
	b.Activated:Connect(function()
		sfx("click")
		bounce(pop, 0.85)
	end)
	return b, holder, vis
end
task.spawn(function()
	while true do
		task.wait(2.8)
		for i = #shines, 1, -1 do
			local s = shines[i]
			if not s:IsDescendantOf(game) then
				table.remove(shines, i)
			else
				task.delay(math.random() * 0.8, function()
					if s:IsDescendantOf(game) then
						s.Position = UDim2.new(-0.4, 0, -0.3, 0)
						TweenService:Create(s, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Position = UDim2.new(1.2, 0, -0.3, 0) }):Play()
					end
				end)
			end
		end
	end
end)

local CFGF = ReplicatedStorage:WaitForChild("LickConfig")
local COSTS, ZN = {}, {}
for n in string.gmatch(CFGF:WaitForChild("LevelCosts").Value, "[^,]+") do COSTS[#COSTS + 1] = tonumber(n) end
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
local HttpService = game:GetService("HttpService")
local root = player:WaitForChild("PlayerGui"):WaitForChild("LickUI"):WaitForChild("Root")
local menuEv = ReplicatedStorage:WaitForChild("LickMenu")
local sf = player:WaitForChild("LickState")
local stats = player:WaitForChild("leaderstats")
local cam = workspace.CurrentCamera
repeat task.wait(0.25) until player:GetAttribute("DataReady")
local tv = sf:FindFirstChild("Tut")
local okT, tut = pcall(function() return HttpService:JSONDecode(tv and tv.Value or "{}") end)
tut = okT and type(tut) == "table" and tut or {}
if tut.state == "done" or tut.state == "skipped" then return end
local lickables = workspace:WaitForChild("LickWorld"):WaitForChild("Lickables")

local gfx = Instance.new("Folder")
gfx.Name = "LickTutorialFx"
gfx.Parent = cam
local foods, shopOpened, rebirthOpened = 0, false, false
remotes.Eat.OnClientEvent:Connect(function(m, b, t, fin) if fin then foods = foods + 1 end end)
menuEv.Event:Connect(function(n)
	if n == "shop" then shopOpened = true elseif n == "rebirth" then rebirthOpened = true end
end)
remotes.OpenShop.OnClientEvent:Connect(function() shopOpened = true end)
local function totalGoo() local v = sf:FindFirstChild("TotalGoo") return v and v.Value or 0 end
local function myPos() local r = player.Character and player.Character:FindFirstChild("HumanoidRootPart") return r and r.Position end

local function starter()
	for _, m in ipairs(lickables:GetChildren()) do if m:GetAttribute("Starter") then return m end end
end
local function nearestFood()
	local p, best, bd = myPos(), nil, 1e9
	if not p then return nil end
	for _, m in ipairs(lickables:GetChildren()) do
		local c = m:GetAttribute("Center")
		if c and (m:GetAttribute("Zone") or 1) &lt;= (player:GetAttribute("BestZone") or 1) then
			local d = (c - p).Magnitude
			if d &lt; bd then best, bd = m, d end
		end
	end
	return best
end
local function shopNpc()
	local p, best, bd = myPos(), nil, 1e9
	local w = workspace:FindFirstChild("LickWorld")
	if not p or not w then return nil end
	for _, m in ipairs(w:GetChildren()) do
		if m:IsA("Model") and m.Name == "Upgrade Shop" then
			local d = (m:GetPivot().Position - p).Magnitude
			if d &lt; bd then best, bd = m, d end
		end
	end
	return best
end

local chev = {}
for i = 1, 16 do
	local pair = {}
	for s = 1, 2 do
		local p = Instance.new("Part")
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
		p.Material = Enum.Material.Neon
		p.Color = Color3.fromRGB(255, 235, 60)
		p.Size = Vector3.new(0.7, 0.25, 2.6)
		p.Transparency = 1
		p.Parent = gfx
		pair[s] = p
	end
	chev[i] = pair
end
local beacon = Instance.new("Part")
beacon.Anchored, beacon.CanCollide, beacon.CanQuery, beacon.CanTouch, beacon.CastShadow = true, false, false, false, false
beacon.Shape = Enum.PartType.Cylinder
beacon.Material = Enum.Material.Neon
beacon.Color = Color3.fromRGB(255, 235, 60)
beacon.Size = Vector3.new(70, 3, 3)
beacon.Transparency = 1
beacon.Parent = gfx
local bb = Instance.new("BillboardGui")
bb.Size = UDim2.new(0, 70, 0, 70)
bb.AlwaysOnTop = true
bb.LightInfluence = 0
bb.Enabled = false
bb.Parent = gfx
local bbl = Instance.new("TextLabel")
