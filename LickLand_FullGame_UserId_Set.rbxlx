	alive = false
	hide3d()
	clearPointer()
	fxLayer:Destroy()
	gfx:Destroy()
end
skipB.Activated:Connect(function()
	remotes.TutorialAction:FireServer("skip")
	cleanup()
end)

local function confetti(n)
	for i = 1, n do
		local c = Instance.new("Frame")
		c.Size = UDim2.new(0, math.random(8, 16), 0, 10)
		c.Position = UDim2.new(math.random(), 0, -0.05, 0)
		c.Rotation = math.random(0, 360)
		c.BackgroundColor3 = Color3.fromHSV(math.random(), 0.7, 1)
		c.BorderSizePixel = 0
		c.ZIndex = 40
		c.Parent = root
		local tw = TweenService:Create(c, TweenInfo.new(1.3 + math.random(), Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.new(c.Position.X.Scale, 0, 1.1, 0), Rotation = c.Rotation + 300 })
		tw:Play()
		tw.Completed:Connect(function() c:Destroy() end)
	end
end

local GATE = Vector3.new(-320, 3, -160)
local steps = {
	{ "LICK THE DONUT!", "Walk to the glowing donut. Tap it, or hold the LICK button, until it is gone!", function() return "model", starter() end, function() return foods &gt;= 1 end },
	{ "EARN GOO!", "Every lick gives goo. Keep licking food until you can afford an upgrade.", function() return "model", nearestFood() end, function() return stats.Goo.Value &gt;= COSTS[1] end },
	{ "LEVEL UP!", "Tap +1 LEVEL to make your tongue stronger. Levels unlock new zones!", function() return "gui", "Btn_buy1" end, function() return stats.Tongue.Value &gt;= 2 end },
	{ "UNLOCK ZONES!", "Walk to the glowing gate. At Level 10 it opens the " .. ZN[2] .. ". Higher zones pay more goo!", function() return "pos", GATE end, function() local p = myPos() return p and (Vector3.new(GATE.X, p.Y, GATE.Z) - p).Magnitude &lt; 50 end },
	{ "VISIT THE SHOP!", "Tap the shopkeeper to upgrade your speed and roll for tongue skins.", function() return "model", shopNpc() end, function() return shopOpened end },
	{ "REBIRTH!", "At Level 100 you can REBIRTH: reset your level for permanent goo bonuses. Tap Rebirth to read how it works.", function() return "gui", "Btn_rebirth" end, function() return rebirthOpened end },
}

local function show(i)
	local s = steps[i]
	card.Visible = true
	titleL.Text = s[1]
	bodyL.Text = s[2]
	popIn(card)
	for k = 1, 6 do dots[k].BackgroundColor3 = k &lt; i and GREEN1 or (k == i and YELLOW1 or Color3.fromRGB(190, 190, 230)) end
	remotes.TutorialAction:FireServer("step", i)
	clearPointer()
	hide3d()
end

local function welcome()
	local white = Instance.new("Frame")
	white.Size = UDim2.new(1, 0, 1, 0)
	white.BackgroundColor3 = WHITE
	white.BorderSizePixel = 0
	white.ZIndex = 45
	white.Parent = root
	TweenService:Create(white, TweenInfo.new(0.9), { BackgroundTransparency = 1 }):Play()
	task.delay(1, function() white:Destroy() end)
	local t = text(root, "WELCOME TO LICK LAND!", UDim2.new(0, 560, 0, 70), UDim2.new(0.5, -280, -0.2, 0), 52)
	t.ZIndex = 46
	t.TextScaled = true
	gradient(t, Color3.fromRGB(255, 250, 140), Color3.fromRGB(255, 130, 200))
	TweenService:Create(t, TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, -280, 0.2, 0) }):Play()
	sfx("chime", 1.2, 1)
	confetti(36)
	local s = text(root, "Lick yummy food. Collect goo. Unlock new zones!", UDim2.new(0, 560, 0, 30), UDim2.new(0.5, -280, 0.2, 76), 22)
	s.ZIndex = 46
	task.wait(2.2)
	TweenService:Create(t, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	task.wait(0.4)
	t:Destroy()
	s:Destroy()
end

task.spawn(function()
	local i = math.clamp(tut.step or 1, 1, #steps)
	if not tut.step then
		remotes.TutorialAction:FireServer("step", 1)
		task.spawn(welcome)
		task.wait(1.4) -- the arrow and glowing target appear while the welcome title is still on screen
	end
	show(i)
	while alive and i &lt;= #steps do
		local s = steps[i]
		local kind, val = s[3]()
		if kind == "model" then setModel(val) elseif kind == "pos" then setPos(val) elseif kind == "gui" then if not pointer or pointer.Parent == nil then pointAt(val) end end
		if s[4]() then
			sfx("chime", 1.2, 0.9)
			confetti(12)
			if i == #steps then break end
			i = i + 1
			show(i)
		end
		task.wait(0.25)
	end
	if alive then
		remotes.TutorialAction:FireServer("done")
		hide3d()
		clearPointer()
		sfx("chime", 1.5, 1)
		confetti(50)
		titleL.Text = "TUTORIAL COMPLETE!"
		bodyL.Text = "Reward added. Have fun licking!"
		for k = 1, 6 do dots[k].BackgroundColor3 = GREEN1 end
		task.wait(3)
		cleanup()
	end
end)
print("[LickTutorial] ready")
</ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBX37">
          <Properties>
            <string name="Name">LickAmbient</string>
            <ProtectedString name="Source">-- LICK AMBIENT (LocalScript)  Location: StarterPlayer &gt; StarterPlayerScripts &gt; LickAmbient
-- Living world: bobbing orbs, drifting clouds, pulsing lights, the sky/colors changing smoothly as you cross zones and worlds,
-- and the VISUALS of every cosmetic (trails, auras, glows, titles) on nearby players. All local (no replication).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local HttpService = game:GetService("HttpService")
local player = Players.LocalPlayer
local CFGF = ReplicatedStorage:WaitForChild("LickConfig")
local function csv(name)
	local t = {}
	for n in string.gmatch(CFGF:WaitForChild(name).Value, "[^,]+") do t[#t + 1] = tonumber(n) end
	return t
end
local COSTS, ZL, ZV = csv("LevelCosts"), csv("ZoneLevels"), csv("ZoneValues")
local ZN, WN = {}, {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
for n in string.gmatch(CFGF:WaitForChild("WorldNames").Value, "[^|]+") do WN[#WN + 1] = n end
local NW = #WN
local ZN = {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
local MAXLV = CFGF:GetAttribute("MaxLevel") or 400
local LPM = CFGF:GetAttribute("LPM") or 150
local function zoneOf(level)
	local z = 1
	for i = 1, #ZL do
		if level &gt;= ZL[i] then z = i end
	end
	return z
end
local function worldOf(x) return math.clamp(math.floor((x + 1000) / 2000) + 1, 1, NW) end
local function zoneAt(x, z)
	local w = worldOf(x)
	local col = math.clamp(math.floor((x - (w - 1) * 2000 + 640) / 320), 0, 3)
	local k = 8 - col
	if z &lt; 0 then k = col + 1 end
	return (w - 1) * 8 + k
end

local ZC = {}
for h in string.gmatch(CFGF:WaitForChild("ZoneColors").Value, "[^,]+") do ZC[#ZC + 1] = Color3.fromHex(h) end
local WHITE = Color3.new(1, 1, 1)
local function quality() return player:GetAttribute("FxQuality") or 3 end

-- ===== animated tagged parts =====
local anim = { LickBob = {}, LickDrift = {}, LickPulse = {} }
local function reg(tag)
	local function add(p)
		if p:IsA("BasePart") then anim[tag][p] = { base = p.CFrame, ph = math.random() * 6.28 } end
	end
	for _, p in ipairs(CollectionService:GetTagged(tag)) do add(p) end
	CollectionService:GetInstanceAddedSignal(tag):Connect(add)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(function(p) anim[tag][p] = nil end)
end
for tag in pairs(anim) do reg(tag) end
local frame = 0
RunService.RenderStepped:Connect(function()
	frame = frame + 1
	local q = quality()
	if q == 1 and frame % 3 ~= 0 then return end
	local t = os.clock()
	for p, d in pairs(anim.LickBob) do p.CFrame = d.base * CFrame.new(0, math.sin(t * 1.6 + d.ph) * 1.6, 0) end
	for p, d in pairs(anim.LickDrift) do p.CFrame = d.base * CFrame.new(math.sin(t * 0.06 + d.ph) * 36, 0, 0) end
	for p, d in pairs(anim.LickPulse) do p.LocalTransparencyModifier = 0.3 * (0.5 + 0.5 * math.sin(t * 2.2 + d.ph)) end
end)

-- ===== zone atmosphere (smooth transitions) =====
local atm = Lighting:WaitForChild("LickAtmosphere", 30)
local cc = Lighting:WaitForChild("LickColor", 30)
local lastZone = 0
task.spawn(function()
	while true do
		task.wait(1)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and atm and cc then
			local g = zoneAt(root.Position.X, root.Position.Z)
			if g ~= lastZone then
				lastZone = g
				local col = ZC[g] or WHITE
				local info = TweenInfo.new(3, Enum.EasingStyle.Sine)
				TweenService:Create(atm, info, { Color = col:Lerp(WHITE, 0.55), Decay = col:Lerp(Color3.fromRGB(60, 40, 110), 0.25) }):Play()
				TweenService:Create(cc, info, { TintColor = col:Lerp(WHITE, 0.82) }):Play()
				TweenService:Create(Lighting, info, { ClockTime = worldOf(root.Position.X) == 2 and 18.3 or 14.5 }):Play()
			end
		end
	end
end)

-- ===== cosmetic visuals =====
local CATALOG = {}
task.spawn(function()
	local v = ReplicatedStorage:WaitForChild("LickConfig"):WaitForChild("Cosmetics", 20)
	if v then
		local ok, t = pcall(function() return HttpService:JSONDecode(v.Value) end)
		if ok then CATALOG = t end
	end
end)
local RAINBOW = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 120)), ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 225, 80)), ColorSequenceKeypoint.new(0.66, Color3.fromRGB(90, 220, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(190, 110, 255)) })
local TRAILS = { trail_sprinkle = RAINBOW, trail_comet = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(90, 150, 255)), trail_goo = ColorSequence.new(Color3.fromRGB(150, 255, 230), Color3.fromRGB(60, 200, 170)), trail_frost = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(150, 210, 255)) }
local AURAS = { aura_bubble = { Color3.new(1, 1, 1), 5 }, aura_star = { Color3.fromRGB(255, 235, 90), 8 }, aura_goo = { Color3.fromRGB(120, 255, 215), 7 }, aura_legend = { RAINBOW, 14 }, aura_party = { Color3.fromRGB(255, 120, 200), 9 } }
local GLOWS = { glow_legend = Color3.fromRGB(255, 200, 60), glow_royal = Color3.fromRGB(170, 100, 255) }
local sig = {}

local function clear(char)
	for _, n in ipairs({ "LickTrail", "LickAura", "LickGlow", "LickTitle", "LickA0", "LickA1" }) do
		for _, d in ipairs(char:GetDescendants()) do if d.Name == n then d:Destroy() end end
	end
end
local function refresh(plr)
	local char = plr.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local head = char and char:FindFirstChild("Head")
	if not root or not head then return end
	local trail, aura, glow, title = plr:GetAttribute("CosTrail"), plr:GetAttribute("CosAura"), plr:GetAttribute("CosGlow"), plr:GetAttribute("CosTitle")
	local vip = plr:GetAttribute("Pass_VIP") == true or plr:GetAttribute("GooPass_VIP") == true
	local s = tostring(trail) .. tostring(aura) .. tostring(glow) .. tostring(title) .. tostring(vip) .. tostring(quality())
	if sig[plr] == s and root:FindFirstChild("LickA0") then return end
	sig[plr] = s
	clear(char)
	if quality() == 1 and plr ~= player then return end
	local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
	a0.Name, a1.Name = "LickA0", "LickA1"
	a0.Position, a1.Position = Vector3.new(0, 1, 0), Vector3.new(0, -1.5, 0)
	a0.Parent, a1.Parent = root, root
	if trail and TRAILS[trail] then
		local t = Instance.new("Trail")
		t.Name = "LickTrail"
		t.Attachment0, t.Attachment1 = a0, a1
		t.Color = TRAILS[trail]
		t.Lifetime = 0.8
		t.LightEmission = 0.6
		t.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
		t.Parent = root
	end
	local ad = aura and AURAS[aura]
	if ad or vip then
		local e = Instance.new("ParticleEmitter")
		e.Name = "LickAura"
		e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		e.Color = ad and (typeof(ad[1]) == "ColorSequence" and ad[1] or ColorSequence.new(ad[1])) or ColorSequence.new(Color3.fromRGB(255, 215, 0))
		e.Rate = ad and ad[2] or 5
		e.Lifetime = NumberRange.new(0.8, 1.4)
		e.Speed = NumberRange.new(1, 3)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0) })
		e.LightEmission = 0.7
		e.Parent = root
	end
	if glow and GLOWS[glow] then
		local l = Instance.new("PointLight")
		l.Name = "LickGlow"
		l.Color = GLOWS[glow]
		l.Brightness = 2
		l.Range = 16
		l.Parent = root
	end
	if title and CATALOG[title] then
		local g = Instance.new("BillboardGui")
		g.Name = "LickTitle"
		g.Size = UDim2.new(0, 190, 0, 26)
		g.StudsOffset = Vector3.new(0, 3.1, 0)
		g.MaxDistance = 70
		g.LightInfluence = 0
		g.Parent = head
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(1, 0, 1, 0)
		l.BackgroundTransparency = 1
		l.Font = Enum.Font.FredokaOne
		l.TextScaled = true
		l.Text = CATALOG[title][2]
		l.TextColor3 = Color3.fromRGB(255, 225, 90)
		l.TextStrokeTransparency = 0
		l.Parent = g
	end
end
task.spawn(function()
	while true do
		task.wait(1.2)
		local mine = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local list = {}
		for _, p in ipairs(Players:GetPlayers()) do
			local r = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if r and mine then list[#list + 1] = { p, (r.Position - mine.Position).Magnitude } end
		end
		table.sort(list, function(a, b) return a[2] &lt; b[2] end)
		for i = 1, math.min(#list, 8) do
			if list[i][2] &lt; 140 then pcall(refresh, list[i][1]) end
		end
	end
end)
Players.PlayerRemoving:Connect(function(p) sig[p] = nil end)
print("[LickAmbient] ready")
