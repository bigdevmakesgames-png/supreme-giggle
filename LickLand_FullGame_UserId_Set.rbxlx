			lbl.Text = locked and ("LOCKED - Level " .. ZL[z]) or (best:GetAttribute("FlavorName") .. "   " .. left .. " bites")
			lbl.TextColor3 = locked and Color3.fromRGB(255, 130, 130) or Color3.new(1, 1, 1)
			gui.Enabled = true
		else
			gui.Enabled = false
		end
	end
end)
