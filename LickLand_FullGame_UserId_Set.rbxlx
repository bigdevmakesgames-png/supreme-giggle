task.spawn(function()
	while true do
		local root3 = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root3 then
			local g = zoneAt(root3.Position.X, root3.Position.Z)
			local w = worldOf(root3.Position.X)
			zoneLbl.Text = ZN[g]
			worldLbl.Text = WN[w]
			local col = ZC[g] or WHITE
			chip:FindFirstChildOfClass("UIGradient").Color = ColorSequence.new(col:Lerp(WHITE, 0.25), col:Lerp(DARK, 0.45))
		end
		local az = zoneOf(best())
		if az &lt; #ZN then
			nextLbl.Text = "Next: " .. ZN[az + 1] .. " at Level " .. ZL[az + 1]
			local from, to = ZL[az], ZL[az + 1]
			zbar.Size = UDim2.new(math.clamp((Tongue.Value - from) / (to - from), 0, 1), 0, 1, 0)
		else
			nextLbl.Text = "All zones unlocked!"
			zbar.Size = UDim2.new(1, 0, 1, 0)
		end
		local ls = player:GetAttribute("LastSave") or os.time()
		if player:GetAttribute("SaveOk") == false then
			saveLbl.Text = "Saving failed - retrying..."
			saveLbl.TextColor3 = Color3.fromRGB(255, 130, 130)
		else
			saveLbl.Text = "Progress saved " .. math.max(0, os.time() - ls) .. "s ago"
			saveLbl.TextColor3 = Color3.fromRGB(190, 255, 200)
		end
		local left = (player:GetAttribute("BoostUntil") or 0) - os.time()
		boostLbl.Text = left &gt; 0 and string.format("x2 GOO BOOST %d:%02d", math.floor(left / 60), left % 60) or ""
		local nf = (player:GetAttribute("NextFree") or 0) - os.time()
		caps.free.Text = nf &lt;= 0 and "FREE!" or string.format("%d:%02d", math.floor(nf / 60), nf % 60)
		local tp = player:GetAttribute("Pass_Teleporter") == true or player:GetAttribute("GooPass_Teleporter") == true
		holders.teleport.Visible, caps.teleport.Visible = tp, tp
		local au = player:GetAttribute("Pass_AutoLick") == true or player:GetAttribute("GooPass_AutoLick") == true
		holders.auto.Visible, caps.auto.Visible = au, au
		if au then caps.auto.Text = player:GetAttribute("AutoLick") and "AUTO ON" or "AUTO OFF" end
		if os.clock() - comboAt &gt; 1.8 then comboF.Visible = false end
		local p, s = gooPill.AbsolutePosition, gooPill.AbsoluteSize
		root:SetAttribute("GooX", p.X + s.X / 2)
		root:SetAttribute("GooY", p.Y + s.Y / 2)
		task.wait(0.4)
	end
end)

