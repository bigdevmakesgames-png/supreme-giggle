local MarketplaceService = game:GetService("MarketplaceService")

local PASSES = { X2Goo = 1748978692, X3Goo = 1195334475, AutoLick = 1195466483, FastLick = 1195194445, MegaReach = 1152458181, SuperSpeed = 1153001762, LuckyLicks = 1152177770, VIP = 1152003704, AutoUpgrade = 1150787898, SuperRebirth = 1150787896, GiftBoost = 1151003814, RainbowTongue = 1154987870, GalaxyTongue = 1152946137, Teleporter = 1151216037, StarterPack = 1133357987 }
local ROBUX = { X2Goo = 199, X3Goo = 399, AutoLick = 299, FastLick = 149, MegaReach = 149, SuperSpeed = 99, LuckyLicks = 199, VIP = 399, AutoUpgrade = 249, SuperRebirth = 299, GiftBoost = 99, RainbowTongue = 149, GalaxyTongue = 199, Teleporter = 99, StarterPack = 79 }
-- goo price = Robux price x 150,000 (x300,000 for the goo-multiplying passes). Starter Pack is cheap on purpose.
local MULTI = { X2Goo = true, X3Goo = true, SuperRebirth = true, VIP = true }
local GOO = {}
for name, r in pairs(ROBUX) do GOO[name] = r * (MULTI[name] and 300000 or 150000) end
GOO.StarterPack = 300000

-- developer products (repeatable). gooMin = minutes of income at your best zone, so packs scale with progress
local PRODUCTS = {
	[3730209921] = { gooMin = 15 }, -- Goo Pack 1
	[3730210052] = { gooMin = 60 }, -- Goo Pack 2
	[3730210119] = { gooMin = 180 }, -- Goo Pack 3
	[3730210205] = { gooMin = 600 }, -- Goo Pack 4
	[3730210305] = { boostMin = 15 }, -- 15-minute x2 Goo boost
}
-- DONATION products: create developer products in Creator Hub and list them here as [productId] = true
local DONATIONS = {}

do
	local t = {}
	for name, id in pairs(PASSES) do t[name] = { id, ROBUX[name], GOO[name] } end
	local sv = Instance.new("StringValue")
	sv.Name = "Passes"
	sv.Value = jenc(t)
	sv.Parent = ReplicatedStorage:WaitForChild("LickConfig")
end

local function has(plr, name) return plr:GetAttribute("Pass_" .. name) == true or plr:GetAttribute("GooPass_" .. name) == true end

local function applyPerks(plr)
	local mult = 1
	if has(plr, "X3Goo") then mult = 3 elseif has(plr, "X2Goo") then mult = 2 end
	if has(plr, "VIP") then mult = mult * 1.25 end
	plr:SetAttribute("PassMult", mult)
	plr:SetAttribute("RebirthBonus", has(plr, "SuperRebirth") and 1.0 or 0.5)
	plr:SetAttribute("LickCooldownMult", has(plr, "FastLick") and 0.5 or 1)
	plr:SetAttribute("ReachBonus", has(plr, "MegaReach") and 15 or 0)
	plr:SetAttribute("SpeedBonus", has(plr, "SuperSpeed") and 8 or 0)
	plr:SetAttribute("LuckBonus", has(plr, "LuckyLicks") and 0.10 or 0)
	plr:SetAttribute("GiftBoost", has(plr, "GiftBoost"))
	plr:SetAttribute("AutoUpgrade", has(plr, "AutoUpgrade"))
	local style = nil
	if has(plr, "GalaxyTongue") then style = "galaxy" elseif has(plr, "RainbowTongue") then style = "rainbow" elseif has(plr, "VIP") then style = "vip" end
	plr:SetAttribute("TongueStyle", style)
end

local function addVipTag(char)
	local head = char:WaitForChild("Head", 5)
	if not head or head:FindFirstChild("VipTag") then return end
	local gui = Instance.new("BillboardGui")
	gui.Name = "VipTag"
	gui.Size = UDim2.new(0, 70, 0, 26)
	gui.StudsOffset = Vector3.new(0, 4.4, 0)
	gui.MaxDistance = 60
	gui.Parent = head
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, 0, 1, 0)
	l.BackgroundTransparency = 1
	l.TextScaled = true
	l.Font = Enum.Font.FredokaOne
	l.Text = "VIP"
	l.TextColor3 = Color3.fromRGB(255, 215, 0)
	l.TextStrokeTransparency = 0
	l.Parent = gui
end

local function gpv(plr) return state(plr, "GooPass", "StringValue", "{}") end

local function starter(plr)
	if not has(plr, "StarterPack") then return end
	local v = gpv(plr)
	local d = jdec(v.Value)
	if d.starter then return end
	d.starter = true
	v.Value = jenc(d)
	grant(plr, { gooMin = 20, boostMin = 30, rolls = 3 }, "Starter Pack")
end

local function onOwned(plr, name)
	applyPerks(plr)
	if name == "VIP" and plr.Character then addVipTag(plr.Character) end
	if name == "StarterPack" then starter(plr) end
end

local function setup(plr)
	plr.CharacterAdded:Connect(function(char) if has(plr, "VIP") then addVipTag(char) end end)
	if not ready(plr) then return end
	local d = jdec(gpv(plr).Value)
	for name in pairs(d.owned or {}) do
		if PASSES[name] then plr:SetAttribute("GooPass_" .. name, true) end
	end
	for name, id in pairs(PASSES) do
		local ok, owns = pcall(function() return MarketplaceService:UserOwnsGamePassAsync(plr.UserId, id) end)
		if ok and owns then plr:SetAttribute("Pass_" .. name, true) end
	end
	applyPerks(plr)
	if has(plr, "VIP") and plr.Character then addVipTag(plr.Character) end
	starter(plr)
end
Players.PlayerAdded:Connect(function(plr) task.spawn(setup, plr) end)
for _, plr in ipairs(Players:GetPlayers()) do task.spawn(setup, plr) end

local priceCache = {}
local function robuxOf(id, infoType)
	if priceCache[id] then return priceCache[id] end
	local ok, info = pcall(function() return MarketplaceService:GetProductInfo(id, infoType) end)
	local p = ok and info and info.PriceInRobux or 0
	priceCache[id] = p
	return p
end

-- Robux purchase of a gamepass in game: unlock now (ownership itself is re-checked on every join)
MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(plr, passId, purchased)
	if not purchased then return end
	for name, id in pairs(PASSES) do
		if id == passId then
			plr:SetAttribute("Pass_" .. name, true)
			onOwned(plr, name)
			notify(plr, "Thank you! " .. name .. " unlocked!", "chime")
			bus.Spent:Fire(plr.UserId, robuxOf(id, Enum.InfoType.GamePass), "gamepass")
		end
	end
end)

-- developer products: receipts are recorded by PurchaseId so a reward can never be given twice
MarketplaceService.ProcessReceipt = function(info)
	local plr = Players:GetPlayerByUserId(info.PlayerId)
	local prod = PRODUCTS[info.ProductId]
	if not plr or not (prod or DONATIONS[info.ProductId]) then return Enum.ProductPurchaseDecision.NotProcessedYet end
	if not ready(plr) then return Enum.ProductPurchaseDecision.NotProcessedYet end
	local rv = state(plr, "Receipts", "StringValue", "{}")
	local d = jdec(rv.Value)
	d.ids = d.ids or {}
	local pid = tostring(info.PurchaseId)
	if not d.ids[pid] then
		d.ids[pid] = os.time()
		local n = 0
		for _ in pairs(d.ids) do n = n + 1 end
		if n &gt; 150 then
			local oldK, oldT = nil, math.huge
			for k, t in pairs(d.ids) do if t &lt; oldT then oldK, oldT = k, t end end
			d.ids[oldK] = nil
		end
		rv.Value = jenc(d)
		if prod then grant(plr, prod, "Purchase") else notify(plr, "Thank you for your donation!", "chime") end
		local spent = info.CurrencySpent
		if not spent or spent &lt;= 0 then spent = robuxOf(info.ProductId, Enum.InfoType.Product) end
		bus.Spent:Fire(plr.UserId, spent, DONATIONS[info.ProductId] and "donation" or "product")
	end
	if bus.SaveNow:Invoke(plr) then return Enum.ProductPurchaseDecision.PurchaseGranted end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

-- unlock a pass with Goo
remotes.BuyGooPass.OnServerInvoke = function(plr, name)
	if not rate(plr, "goopass", 1.5) then return false, "Slow down a little!" end
	if typeof(name) ~= "string" or not PASSES[name] or not plr:GetAttribute("DataReady") then return false, "Unknown pass." end
	if has(plr, name) then return false, "You already own this." end
	local stats = plr:FindFirstChild("leaderstats")
	if not stats then return false, "Try again." end
	local price = GOO[name]
	if stats.Goo.Value &lt; price then return false, "Not enough goo." end
	stats.Goo.Value = stats.Goo.Value - price
	local v = gpv(plr)
	local d = jdec(v.Value)
	d.owned = d.owned or {}
	d.owned[name] = os.time()
	v.Value = jenc(d)
	plr:SetAttribute("GooPass_" .. name, true)
	onOwned(plr, name)
	task.spawn(function() bus.SaveNow:Invoke(plr) end)
	notify(plr, name .. " unlocked with goo!", "chime")
	return true, "Unlocked!"
end

remotes.ToggleAuto.OnServerEvent:Connect(function(plr)
	if rate(plr, "auto", 0.4) and has(plr, "AutoLick") then plr:SetAttribute("AutoLick", not plr:GetAttribute("AutoLick")) end
end)

remotes.Teleport.OnServerEvent:Connect(function(plr, g)
	if not rate(plr, "tp", 1.5) then return end
	if not has(plr, "Teleporter") then notify(plr, "You need the Zone Teleporter pass!", "error") return end
	if typeof(g) ~= "number" then return end
	g = math.floor(g)
	local az = zoneOf(state(plr, "BestLevel", "IntValue", 1).Value)
	if g &lt; 1 or g &gt; #ZN or g &gt; az then notify(plr, "That zone is still locked!", "error") return end
	if not plr.Character then return end
	local cx, cz = zoneCenter(g)
	if (g - 1) % 8 == 0 then
		plr.Character:PivotTo(CFrame.new(cx, 6, cz + 24))
	else
		local gx, gz = gatePos(g - 1)
		local dx, dz = cx - gx, cz - gz
		local len = math.sqrt(dx * dx + dz * dz)
		plr.Character:PivotTo(CFrame.new(gx + dx / len * 20, 6, gz + dz / len * 20))
	end
	notify(plr, "Teleported to " .. ZN[g], "chime")
end)
print("[LickPasses] ready")
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX20">
        <Properties>
          <string name="Name">LickQuests</string>
          <ProtectedString name="Source">-- LICK QUESTS (server Script)  Location: ServerScriptService &gt; LickQuests
-- Daily / weekly / lifetime / zone / event quests, achievements, daily login streak and food-index mastery.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local HttpService = game:GetService("HttpService")
local remotes = ReplicatedStorage:WaitForChild("LickRemotes")
local bus = ServerStorage:WaitForChild("LickBus")
local function notify(plr, text, sfx) remotes.Notify:FireClient(plr, text, sfx) end
local function jdec(s)
	local ok, t = pcall(function() return HttpService:JSONDecode(s) end)
	if ok and type(t) == "table" then return t end
	return {}
end
local function jenc(t) return HttpService:JSONEncode(t) end
local function ready(plr)
	while plr.Parent and not plr:GetAttribute("DataReady") do task.wait(0.25) end
	return plr.Parent ~= nil
end
local function state(plr, name, class, default)
	local f = plr:FindFirstChild("LickState")
	if not f then
		f = Instance.new("Folder")
		f.Name = "LickState"
		f.Parent = plr
	end
	local v = f:FindFirstChild(name)
	if not v then
		v = Instance.new(class)
		v.Name = name
		v.Value = default
		v.Parent = f
	end
	return v
end
local rateT = {}
local function rate(plr, key, gap)
	local k = plr.UserId .. key
	local now = os.clock()
	if rateT[k] and now - rateT[k] &lt; gap then return false end
	rateT[k] = now
	return true
end
local function stat(plr, key, n) bus.Stat:Fire(plr, key, n or 1) end
local function grant(plr, reward, why) bus.Grant:Fire(plr, reward, why) end

local CFGF = ReplicatedStorage:WaitForChild("LickConfig")
local function csv(name)
	local t = {}
	for n in string.gmatch(CFGF:WaitForChild(name).Value, "[^,]+") do t[#t + 1] = tonumber(n) end
	return t
end
local COSTS, ZL, ZV = csv("LevelCosts"), csv("ZoneLevels"), csv("ZoneValues")
local ZN, WN = {}, {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
for n in string.gmatch(CFGF:WaitForChild("WorldNames").Value, "[^|]+") do WN[#WN + 1] = n end
local NW = #WN
local ZN = {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
local MAXLV = CFGF:GetAttribute("MaxLevel") or 400
local LPM = CFGF:GetAttribute("LPM") or 150
local function zoneOf(level)
	local z = 1
	for i = 1, #ZL do
		if level &gt;= ZL[i] then z = i end
	end
	return z
end
local function minutesGoo(level, minutes) return math.floor(minutes * LPM * ZV[zoneOf(level)]) end
local function worldOf(x) return math.clamp(math.floor((x + 1000) / 2000) + 1, 1, NW) end
local function zoneCenter(g)
	local w, k = math.floor((g - 1) / 8) + 1, (g - 1) % 8 + 1
	local col, z = k - 1, -160
	if k &gt; 4 then
		col = 8 - k
		z = 160
	end
	return -480 + 320 * col + (w - 1) * 2000, z
end
local function gatePos(g)
	local w, k = math.floor((g - 1) / 8) + 1, (g - 1) % 8 + 1
	local ox = (w - 1) * 2000
	if k &lt;= 3 then return -320 + 320 * (k - 1) + ox, -160 end
	if k == 4 then return 480 + ox, 0 end
	if k &lt; 8 then return -320 + 320 * (7 - k) + ox, 160 end
	return nil
end
local function zoneAt(x, z)
	local w = worldOf(x)
	local col = math.clamp(math.floor((x - (w - 1) * 2000 + 640) / 320), 0, 3)
	local k = 8 - col
	if z &lt; 0 then k = col + 1 end
	return (w - 1) * 8 + k
end

local function fmt(n)
	n = math.floor(n)
	if n &lt; 1000 then return tostring(n) end
	local suf, i, v = { "K", "M", "B", "T", "Qa", "Qi" }, 0, n
	while v &gt;= 1000 and i &lt; #suf do v = v / 1000 i = i + 1 end
	return string.format(v &lt; 10 and "%.2f%s" or v &lt; 100 and "%.1f%s" or "%.0f%s", v, suf[i])
end

-- ===== EVENTS: add a limited-time event here (dates are YYYY-MM-DD, UTC) =====
local EVENTS = {
	{ id = "launch", name = "Grand Opening", from = "2026-11-01", to = "2027-02-01", cosmetic = "aura_party", quests = { { "Lick %d times", "licks", 600 }, { "Finish %d foods", "foods", 60 }, { "Claim %d quests", "quests", 4 } } },
	{ id = "winter", name = "Frosty Festival", from = "2027-12-10", to = "2028-01-05", cosmetic = "trail_frost", quests = { { "Lick %d times", "licks", 800 }, { "Finish %d foods", "foods", 80 }, { "Earn %d levels", "levels", 5 } } },
}
local function dateTime(s, endOfDay)
	local y, m, d = string.match(s, "(%d+)-(%d+)-(%d+)")
	return os.time({ year = tonumber(y), month = tonumber(m), day = tonumber(d), hour = endOfDay and 23 or 0, min = endOfDay and 59 or 0 })
end
local function activeEvent()
	local now = os.time()
	for _, e in ipairs(EVENTS) do
		if now &gt;= dateTime(e.from) and now &lt;= dateTime(e.to, true) then return e end
	end
end

local function Q(desc, stat, target, rew, max) return { desc = desc, stat = stat, target = target, n = 0, claimed = false, rew = rew, max = max } end
local function tier(best) return best &lt; 25 and 1 or best &lt; 100 and 2 or 3 end

local function dailyList(plr, day)
	local best = state(plr, "BestLevel", "IntValue", 1).Value
	local t = tier(best)
	local pool = {
		function() return Q("Lick " .. ({ 80, 150, 250 })[t] .. " times", "licks", ({ 80, 150, 250 })[t], { gooMin = 2 }) end,
		function() return Q("Finish " .. ({ 8, 14, 22 })[t] .. " foods", "foods", ({ 8, 14, 22 })[t], { gooMin = 2.5 }) end,
		function() local g = minutesGoo(best, 6) return Q("Earn " .. fmt(g) .. " goo", "goo", g, { gooMin = 2 }) end,
		function() return Q("Buy " .. t .. " upgrade" .. (t &gt; 1 and "s" or ""), "upgrades", t, { gooMin = 2, rolls = 1 }) end,
		function() return Q("Gain " .. (t + 1) .. " levels", "levels", t + 1, { gooMin = 3 }) end,
	}
	local rg = Random.new(day)
	local idx, out = { 1, 2, 3, 4, 5 }, {}
	for i = 5, 2, -1 do local j = rg:NextInteger(1, i) idx[i], idx[j] = idx[j], idx[i] end
	for i = 1, 3 do out[i] = pool[idx[i]]() end
	return out
end
local function weeklyList(plr)
	local best = state(plr, "BestLevel", "IntValue", 1).Value
	local t = tier(best)
	local g = minutesGoo(best, 45)
	return { Q("Lick " .. ({ 800, 1500, 2500 })[t] .. " times", "licks", ({ 800, 1500, 2500 })[t], { gooMin = 12, boostMin = 20 }), Q("Finish " .. ({ 80, 150, 250 })[t] .. " foods", "foods", ({ 80, 150, 250 })[t], { gooMin = 14, rolls = 1 }), Q("Earn " .. fmt(g) .. " goo", "goo", g, { gooMin = 12, boostMin = 30, rolls = 1 }) }
end
local function lifeList()
	local l = {}
	for i, n in ipairs({ 500, 5000, 50000, 500000 }) do l[#l + 1] = Q("Lick " .. fmt(n) .. " times", "licks", n, { gooMin = 6 * i }) end
	for i, n in ipairs({ 100, 1000, 10000 }) do l[#l + 1] = Q("Finish " .. fmt(n) .. " foods", "foods", n, { gooMin = 8 * i }) end
	for i, n in ipairs({ 10, 60, 250 }) do l[#l + 1] = Q("Buy " .. n .. " upgrades", "upgrades", n, { gooMin = 8 * i }) end
	for i, n in ipairs({ 25, 50, 100, 150, 200, 300, 400 }) do l[#l + 1] = Q("Reach Level " .. n, "level", n, { gooMin = 10, boostMin = 30 }, true) end
	l[#l + 1] = Q("Rebirth for the first time", "rebirths", 1, { gooMin = 20, rolls = 2 }, true)
	return l
end
local function zoneList()
	local l = {}
	for g = 1, #ZN do
		local q = Q("Finish 25 foods in " .. ZN[g], "zf" .. g, 25, { gooMin = 3 + g, boostMin = (g % 8 == 0) and 30 or nil })
		q.zone = g
		l[#l + 1] = q
	end
	return l
end
local function eventList(e)
	local l = {}
	for i, q in ipairs(e.quests) do
		l[#l + 1] = Q(string.format(q[1], q[3]), q[2], q[3], { gooMin = 6, boostMin = 15, cosmetic = (i == #e.quests) and e.cosmetic or nil })
	end
	return l
end

-- ===== ACHIEVEMENTS (unlock by themselves) =====
local ACH = {}
local function A(id, name, stat, target, rew, max) ACH[#ACH + 1] = { id = id, name = name, stat = stat, target = target, rew = rew, max = max } end
A("lick1", "First Lick", "licks", 1, { gooMin = 1 })
A("lick1k", "Licking Fan (1K licks)", "licks", 1000, { gooMin = 8 })
A("lick25k", "Lick Machine (25K licks)", "licks", 25000, { gooMin = 25, rolls = 2 })
A("lick1m", "Million Licks", "licks", 1000000, { gooMin = 90, cosmetic = "trail_frost" })
A("food100", "Food Finisher (100)", "foods", 100, { gooMin = 10 })
A("food5k", "Feast Master (5K)", "foods", 5000, { gooMin = 40, rolls = 2 })
A("lvl25", "Level 25", "level", 25, { gooMin = 6 }, true)
A("lvl100", "Level 100", "level", 100, { gooMin = 20, rolls = 2 }, true)
A("lvl200", "Level 200 Champion", "level", 200, { gooMin = 40, boostMin = 60 }, true)
A("reb1", "Reborn", "rebirths", 1, { gooMin = 15 }, true)
A("reb10", "Ten Rebirths", "rebirths", 10, { gooMin = 40, rolls = 3 }, true)
A("zone8", "Zone Explorer (8 zones)", "zones", 8, { gooMin = 15 }, true)
A("zone9", "World Traveler (Snack City)", "zones", 9, { gooMin = 30, rolls = 2 }, true)
A("quest10", "Quest Hunter (10)", "quests", 10, { gooMin = 12 })
A("quest100", "Quest Legend (100)", "quests", 100, { gooMin = 60, rolls = 3 })
A("skin5", "Skin Collector (5 rolls)", "skins", 5, { gooMin = 10 })
A("code1", "Code Cracker", "codes", 1, { gooMin = 5 })
A("index8", "Taster (8 foods found)", "index", 8, { gooMin = 12 })

do
	local list = {}
	for _, a in ipairs(ACH) do list[#list + 1] = { a.id, a.name, a.stat, a.target } end
	local sv = Instance.new("StringValue")
	sv.Name = "Awards"
	sv.Value = jenc(list)
	sv.Parent = ReplicatedStorage:WaitForChild("LickConfig")
end
local QS = {}
local dirty = {}
local function today() return math.floor(os.time() / 86400) end
local function thisWeek() return math.floor((today() + 3) / 7) end

local function load(plr)
	local d = jdec(state(plr, "Quests", "StringValue", "{}").Value)
	d.l = d.l or { list = lifeList() }
	d.z = d.z or { list = zoneList() }
	d.i = d.i or {}
	if not d.d or d.d.day ~= today() then d.d = { day = today(), list = dailyList(plr, today() + plr.UserId % 97) } end
	if not d.w or d.w.week ~= thisWeek() then d.w = { week = thisWeek(), list = weeklyList(plr) } end
	local e = activeEvent()
	if e and (not d.e or d.e.id ~= e.id) then d.e = { id = e.id, name = e.name, list = eventList(e) } elseif not e then d.e = nil end
	return d
end

local function flush(plr)
	local S = QS[plr]
	if S and dirty[plr] then
		dirty[plr] = nil
		state(plr, "Quests", "StringValue", "{}").Value = jenc(S.q)
		state(plr, "Achv", "StringValue", "{}").Value = jenc(S.a)
	end
end

local function achievement(plr, S, key, n)
	for _, a in ipairs(ACH) do
		if a.stat == key and not S.a.done[a.id] then
			local have = S.a.n[key] or 0
			if have &gt;= a.target then
				S.a.done[a.id] = os.time()
				grant(plr, a.rew, "Achievement")
				remotes.Celebrate:FireClient(plr, "achievement", a.name)
			end
		end
	end
end

bus.Stat.Event:Connect(function(plr, key, n)
	local S = QS[plr]
	if not S then return end
	local isMax = key == "level" or key == "rebirths" or key == "zones" or key == "index"
	if isMax then S.a.n[key] = math.max(S.a.n[key] or 0, n) else S.a.n[key] = (S.a.n[key] or 0) + n end
	achievement(plr, S, key, n)
	for _, cat in ipairs({ S.q.d, S.q.w, S.q.l, S.q.z, S.q.e }) do
		if cat then
			for _, q in ipairs(cat.list) do
				if q.stat == key and q.n &lt; q.target then
					if q.max then q.n = math.max(q.n, n) else q.n = q.n + n end
					if q.n &gt; q.target then q.n = q.target end
				end
			end
		end
	end
	dirty[plr] = true
end)

remotes.QuestClaim.OnServerEvent:Connect(function(plr, id)
	if not rate(plr, "qclaim", 0.4) or typeof(id) ~= "string" or not QS[plr] then return end
	local S = QS[plr]
	local cat, idx = string.match(id, "^(%a)(%d+)$")
	if cat then
		local c = ({ d = S.q.d, w = S.q.w, l = S.q.l, z = S.q.z, e = S.q.e })[cat]
		local q = c and c.list[tonumber(idx)]
		if q and q.n &gt;= q.target and not q.claimed then
			q.claimed = true
			state(plr, "QuestsDone", "IntValue", 0).Value = state(plr, "QuestsDone", "IntValue", 0).Value + 1
			grant(plr, q.rew, "Quest")
			remotes.Celebrate:FireClient(plr, "quest", q.desc)
			stat(plr, "quests", 1)
			dirty[plr] = true
			flush(plr)
		end
		return
	end
	-- food index mastery: i:&lt;food&gt;:&lt;rank 1-3&gt;   or   i:all
	local food, rank = string.match(id, "^i:(.+):(%d)$")
	local idx2 = jdec(state(plr, "Index", "StringValue", "{}").Value)
	if food and idx2[food] then
		rank = tonumber(rank)
		local need = ({ 10, 100, 1000 })[rank]
		local key = food .. rank
		if need and (idx2[food] or 0) &gt;= need and not S.q.i[key] then
			S.q.i[key] = true
			grant(plr, { gooMin = ({ 3, 10, 30 })[rank] }, food .. " mastery")
			remotes.Celebrate:FireClient(plr, "quest", food .. " mastery " .. rank)
			dirty[plr] = true
			flush(plr)
		end
	elseif id == "i:all" then
		local n = 0
		for _ in pairs(idx2) do n = n + 1 end
		if n &gt;= #ZN and not S.q.i.all then
			S.q.i.all = true
			grant(plr, { gooMin = 25, cosmetic = "title_taster" }, "Food Index complete")
			remotes.Celebrate:FireClient(plr, "quest", "Food Index complete!")
			dirty[plr] = true
			flush(plr)
		end
	end
end)

-- daily login streak (7 day cycle)
local LOGIN = { { gooMin = 1 }, { gooMin = 2 }, { gooMin = 3 }, { gooMin = 4, boostMin = 15 }, { gooMin = 6 }, { gooMin = 8, rolls = 1 }, { gooMin = 12, boostMin = 30, rolls = 2 } }
remotes.ClaimLogin.OnServerEvent:Connect(function(plr)
	if not rate(plr, "login", 1) or not plr:GetAttribute("DataReady") then return end
	local v = state(plr, "Login", "StringValue", "{}")
	local d = jdec(v.Value)
	local t = today()
	if d.last == t then notify(plr, "Come back tomorrow for the next reward!", "error") return end
	d.streak = (d.last == t - 1) and ((d.streak or 0) + 1) or 1
	d.last = t
	local r = {}
	for k, val in pairs(LOGIN[(d.streak - 1) % 7 + 1]) do r[k] = val end
	if d.streak == 30 then r.cosmetic = "title_loyal" end
	v.Value = jenc(d)
	grant(plr, r, "Day " .. d.streak .. " login reward")
	stat(plr, "logins", 1)
end)

local function setup(plr)
	if not ready(plr) then return end
	local ad = jdec(state(plr, "Achv", "StringValue", "{}").Value)
	ad.n = ad.n or {}
	ad.done = ad.done or {}
	QS[plr] = { q = load(plr), a = ad }
	dirty[plr] = true
	flush(plr)
	local best = state(plr, "BestLevel", "IntValue", 1).Value
	stat(plr, "level", best)
	stat(plr, "zones", zoneOf(best))
	stat(plr, "rebirths", plr.leaderstats.Rebirths.Value)
end
Players.PlayerAdded:Connect(function(plr) task.spawn(setup, plr) end)
for _, plr in ipairs(Players:GetPlayers()) do task.spawn(setup, plr) end
Players.PlayerRemoving:Connect(function(plr)
	flush(plr)
	QS[plr] = nil
	dirty[plr] = nil
end)
task.spawn(function()
	while true do
		task.wait(2)
		for _, plr in ipairs(Players:GetPlayers()) do flush(plr) end
	end
end)
print("[LickQuests] ready")
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX21">
        <Properties>
          <string name="Name">LickBoards</string>
          <ProtectedString name="Source">-- LICK BOARDS (server Script)  Location: ServerScriptService &gt; LickBoards
-- GLOBAL leaderboards (OrderedDataStores) for Goo earned, licks, highest level, rebirths, quests,
-- the physical boards in the first hub, and the TOP DONATORS board (counted from verified receipts).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local HttpService = game:GetService("HttpService")
local remotes = ReplicatedStorage:WaitForChild("LickRemotes")
local bus = ServerStorage:WaitForChild("LickBus")
local function notify(plr, text, sfx) remotes.Notify:FireClient(plr, text, sfx) end
local function jdec(s)
	local ok, t = pcall(function() return HttpService:JSONDecode(s) end)
	if ok and type(t) == "table" then return t end
	return {}
end
local function jenc(t) return HttpService:JSONEncode(t) end
local function ready(plr)
	while plr.Parent and not plr:GetAttribute("DataReady") do task.wait(0.25) end
	return plr.Parent ~= nil
end
local function state(plr, name, class, default)
	local f = plr:FindFirstChild("LickState")
	if not f then
		f = Instance.new("Folder")
		f.Name = "LickState"
		f.Parent = plr
	end
	local v = f:FindFirstChild(name)
	if not v then
		v = Instance.new(class)
		v.Name = name
		v.Value = default
		v.Parent = f
	end
	return v
end
local rateT = {}
local function rate(plr, key, gap)
	local k = plr.UserId .. key
	local now = os.clock()
	if rateT[k] and now - rateT[k] &lt; gap then return false end
	rateT[k] = now
	return true
end
local function stat(plr, key, n) bus.Stat:Fire(plr, key, n or 1) end
local function grant(plr, reward, why) bus.Grant:Fire(plr, reward, why) end

local DataStoreService = game:GetService("DataStoreService")
local STATS = { goo = "LickBoard_Goo_v1", licks = "LickBoard_Licks_v1", level = "LickBoard_Level_v1", rebirths = "LickBoard_Rebirths_v1", quests = "LickBoard_Quests_v1", donors = "LickDonors_v1" }
local TITLES = { goo = "TOTAL GOO", licks = "TOTAL LICKS", level = "HIGHEST LEVEL", rebirths = "REBIRTHS", quests = "QUESTS DONE" }
local stores = {}
for k, n in pairs(STATS) do stores[k] = DataStoreService:GetOrderedDataStore(n) end

local function fmt(n)
	n = math.floor(n)
	if n &lt; 1000 then return tostring(n) end
	local suf, i, v = { "K", "M", "B", "T", "Qa", "Qi" }, 0, n
	while v &gt;= 1000 and i &lt; #suf do v = v / 1000 i = i + 1 end
	return string.format(v &lt; 10 and "%.2f%s" or v &lt; 100 and "%.1f%s" or "%.0f%s", v, suf[i])
end

local cache, names = {}, {}
local function nameOf(id)
	if names[id] then return names[id] end
	local p = Players:GetPlayerByUserId(id)
	if p then names[id] = p.Name return p.Name end
	local ok, n = pcall(function() return Players:GetNameFromUserIdAsync(id) end)
	names[id] = ok and n or ("Player " .. id)
	return names[id]
end

local function value(plr, k)
	local sf, ls = plr:FindFirstChild("LickState"), plr:FindFirstChild("leaderstats")
	if not sf or not ls then return 0 end
	if k == "goo" then return sf:FindFirstChild("TotalGoo") and sf.TotalGoo.Value or 0 end
	if k == "licks" then return ls.Licks.Value end
	if k == "level" then return sf:FindFirstChild("BestLevel") and sf.BestLevel.Value or 1 end
	if k == "rebirths" then return ls.Rebirths.Value end
	if k == "quests" then return sf:FindFirstChild("QuestsDone") and sf.QuestsDone.Value or 0 end
	return 0
end

local function refresh(k)
	local ok, pages = pcall(function() return stores[k]:GetSortedAsync(false, 25) end)
	if not ok then return end
	local ok2, page = pcall(function() return pages:GetCurrentPage() end)
	if not ok2 then return end
	local list = {}
	for i, e in ipairs(page) do
		local id = tonumber(e.key)
		if id then list[#list + 1] = { id = id, name = nameOf(id), value = e.value } end
	end
	cache[k] = { list = list, updated = os.time() }
end

-- physical boards (north edge of the first hub)
local world = workspace:WaitForChild("LickWorld")
local boardFolder = Instance.new("Folder")
boardFolder.Name = "Boards"
boardFolder.Parent = world
local labels = {}
local order = { "goo", "licks", "level", "rebirths", "quests", "donors" }
local hx, hz = -480, -160 -- hub of the first world
for i, k in ipairs(order) do
	local x = hx - 125 + (i - 1) * 50
	local frame = Instance.new("Part")
	frame.Anchored = true
	frame.Size = Vector3.new(40, 30, 4)
	frame.Position = Vector3.new(x, 16, hz - 142)
	frame.Color = Color3.fromRGB(110, 70, 200)
	frame.Material = Enum.Material.Plastic
	frame.TopSurface = Enum.SurfaceType.Studs
	frame.Parent = boardFolder
	local post = Instance.new("Part")
	post.Anchored = true
	post.Size = Vector3.new(6, 2, 6)
	post.Position = Vector3.new(x, 1, hz - 142)
	post.Color = Color3.fromRGB(70, 50, 140)
	post.Material = Enum.Material.Plastic
	post.TopSurface = Enum.SurfaceType.Studs
	post.Parent = boardFolder
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Back
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 24
	sg.Parent = frame
	local bg = Instance.new("Frame")
	bg.Size = UDim2.new(1, 0, 1, 0)
	bg.BackgroundColor3 = Color3.fromRGB(35, 25, 90)
	bg.Parent = sg
	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0.12, 0)
	title.BackgroundColor3 = k == "donors" and Color3.fromRGB(240, 170, 20) or Color3.fromRGB(255, 90, 190)
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextColor3 = Color3.new(1, 1, 1)
	title.Text = k == "donors" and "TOP DONATORS (R$)" or TITLES[k]
	title.Parent = bg
	local rows = {}
	for r = 1, 10 do
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(0.94, 0, 0.075, 0)
		l.Position = UDim2.new(0.03, 0, 0.13 + (r - 1) * 0.085, 0)
		l.BackgroundTransparency = 1
		l.Font = Enum.Font.FredokaOne
		l.TextScaled = true
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.TextColor3 = r == 1 and Color3.fromRGB(255, 215, 0) or r == 2 and Color3.fromRGB(220, 220, 235) or r == 3 and Color3.fromRGB(230, 150, 90) or Color3.new(1, 1, 1)
		l.Text = r .. ".  ..."
		l.Parent = bg
		rows[r] = l
	end
	labels[k] = rows
end
local function paint(k)
	local c = cache[k]
	if not c then return end
	for r = 1, 10 do
		local e = c.list[r]
		labels[k][r].Text = e and (r .. ".  " .. e.name .. "  -  " .. fmt(e.value)) or (r .. ".  ---")
	end
end

-- donations: only genuine, receipt-verified purchases arrive on this event (LickPasses fires it once per PurchaseId)
bus.Spent.Event:Connect(function(userId, robux, source)
	if type(userId) ~= "number" or type(robux) ~= "number" or robux &lt;= 0 then return end
	pcall(function()
		stores.donors:UpdateAsync(tostring(userId), function(old) return math.floor((old or 0) + robux) end)
	end)
end)

remotes.BoardData.OnServerInvoke = function(plr, k)
	if typeof(k) ~= "string" or not STATS[k] or not rate(plr, "board", 1) then return nil end
	local c = cache[k] or { list = {}, updated = 0 }
	local mine, rank = nil, nil
	if k == "donors" then
		local ok, v = pcall(function() return stores.donors:GetAsync(tostring(plr.UserId)) end)
		mine = ok and v or 0
	else
		mine = value(plr, k)
	end
	for i, e in ipairs(c.list) do if e.id == plr.UserId then rank = i end end
	return { list = c.list, updated = c.updated, mine = mine, rank = rank }
end

task.spawn(function()
	while true do
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr:GetAttribute("DataReady") then
				for _, k in ipairs({ "goo", "licks", "level", "rebirths", "quests" }) do
					pcall(function() stores[k]:SetAsync(tostring(plr.UserId), math.floor(value(plr, k))) end)
				end
				task.wait(1)
			end
		end
		task.wait(40)
	end
end)
task.spawn(function()
	task.wait(8)
	while true do
		for _, k in ipairs(order) do
			refresh(k)
			paint(k)
			task.wait(3)
		end
		task.wait(60)
	end
end)
print("[LickBoards] ready")
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX22">
        <Properties>
          <string name="Name">LickAdmin</string>
          <ProtectedString name="Source">-- LICK ADMIN (server Script)  Location: ServerScriptService &gt; LickAdmin
-- Secure owner-only admin tools. EVERY command is checked on the server; ordinary players cannot use or even see it.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local HttpService = game:GetService("HttpService")
local remotes = ReplicatedStorage:WaitForChild("LickRemotes")
local bus = ServerStorage:WaitForChild("LickBus")
local function notify(plr, text, sfx) remotes.Notify:FireClient(plr, text, sfx) end
local function jdec(s)
	local ok, t = pcall(function() return HttpService:JSONDecode(s) end)
	if ok and type(t) == "table" then return t end
	return {}
end
local function jenc(t) return HttpService:JSONEncode(t) end
local function ready(plr)
	while plr.Parent and not plr:GetAttribute("DataReady") do task.wait(0.25) end
	return plr.Parent ~= nil
end
local function state(plr, name, class, default)
	local f = plr:FindFirstChild("LickState")
	if not f then
		f = Instance.new("Folder")
		f.Name = "LickState"
		f.Parent = plr
	end
	local v = f:FindFirstChild(name)
	if not v then
		v = Instance.new(class)
		v.Name = name
		v.Value = default
		v.Parent = f
	end
	return v
end
local rateT = {}
local function rate(plr, key, gap)
	local k = plr.UserId .. key
	local now = os.clock()
	if rateT[k] and now - rateT[k] &lt; gap then return false end
	rateT[k] = now
	return true
end
local function stat(plr, key, n) bus.Stat:Fire(plr, key, n or 1) end
local function grant(plr, reward, why) bus.Grant:Fire(plr, reward, why) end

local CFGF = ReplicatedStorage:WaitForChild("LickConfig")
local function csv(name)
	local t = {}
	for n in string.gmatch(CFGF:WaitForChild(name).Value, "[^,]+") do t[#t + 1] = tonumber(n) end
	return t
end
local COSTS, ZL, ZV = csv("LevelCosts"), csv("ZoneLevels"), csv("ZoneValues")
local ZN, WN = {}, {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
for n in string.gmatch(CFGF:WaitForChild("WorldNames").Value, "[^|]+") do WN[#WN + 1] = n end
local NW = #WN
local ZN = {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
local MAXLV = CFGF:GetAttribute("MaxLevel") or 400
local LPM = CFGF:GetAttribute("LPM") or 150
local function zoneOf(level)
	local z = 1
	for i = 1, #ZL do
		if level &gt;= ZL[i] then z = i end
	end
	return z
end
local function minutesGoo(level, minutes) return math.floor(minutes * LPM * ZV[zoneOf(level)]) end
local function worldOf(x) return math.clamp(math.floor((x + 1000) / 2000) + 1, 1, NW) end
local function zoneCenter(g)
	local w, k = math.floor((g - 1) / 8) + 1, (g - 1) % 8 + 1
	local col, z = k - 1, -160
	if k &gt; 4 then
		col = 8 - k
		z = 160
	end
	return -480 + 320 * col + (w - 1) * 2000, z
end
local function gatePos(g)
	local w, k = math.floor((g - 1) / 8) + 1, (g - 1) % 8 + 1
	local ox = (w - 1) * 2000
	if k &lt;= 3 then return -320 + 320 * (k - 1) + ox, -160 end
	if k == 4 then return 480 + ox, 0 end
	if k &lt; 8 then return -320 + 320 * (7 - k) + ox, 160 end
	return nil
end
local function zoneAt(x, z)
	local w = worldOf(x)
	local col = math.clamp(math.floor((x - (w - 1) * 2000 + 640) / 320), 0, 3)
	local k = 8 - col
	if z &lt; 0 then k = col + 1 end
	return (w - 1) * 8 + k
end

-- ============ SET YOUR OWNER USER ID HERE (a number, e.g. 123456789). 0 = not set ============
local OWNER_USER_ID = 8157356300
-- also treat the account that owns this place as an admin (works when the place is owned by a user)
local ALLOW_PLACE_OWNER = true
-- ==========================================================================================
local startTime = os.time()

local function isAdmin(plr)
	if OWNER_USER_ID ~= 0 and plr.UserId == OWNER_USER_ID then return true end
	if ALLOW_PLACE_OWNER and game.CreatorType == Enum.CreatorType.User and game.CreatorId ~= 0 and plr.UserId == game.CreatorId then return true end
	return false
end

local cosmeticIds = {}
task.spawn(function()
	local sv = ReplicatedStorage:WaitForChild("LickConfig"):WaitForChild("Cosmetics")
	for id in pairs(jdec(sv.Value)) do cosmeticIds[id] = true end
end)

remotes.AdminInfo.OnServerInvoke = function(plr)
	if not isAdmin(plr) then return { admin = false } end
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do list[#list + 1] = { id = p.UserId, name = p.Name } end
	local cos = {}
	for id in pairs(cosmeticIds) do cos[#cos + 1] = id end
	table.sort(cos)
	return { admin = true, players = list, cosmetics = cos, maxLevel = MAXLV }
end

remotes.AdminAction.OnServerInvoke = function(plr, cmd, targetId, a1, a2)
	if not isAdmin(plr) then
		warn("[LickAdmin] blocked non-admin " .. plr.Name .. " (" .. plr.UserId .. ")")
		return false, "No permission."
	end
	if not rate(plr, "admin", 0.25) or typeof(cmd) ~= "string" then return false, "Too fast." end
	local target = typeof(targetId) == "number" and Players:GetPlayerByUserId(targetId) or nil
	local stats = target and target:FindFirstChild("leaderstats")
	local function log(msg) print("[LickAdmin] " .. plr.Name .. ": " .. msg) end
	if cmd == "announce" then
		if typeof(a1) ~= "string" or #a1 &lt; 1 then return false, "Type a message." end
		local msg = string.sub(a1, 1, 120)
		for _, p in ipairs(Players:GetPlayers()) do remotes.Celebrate:FireClient(p, "announce", msg) end
		log("announce " .. msg)
		return true, "Sent to " .. #Players:GetPlayers() .. " players."
	elseif cmd == "stats" then
		return true, #Players:GetPlayers() .. " players, server up " .. math.floor((os.time() - startTime) / 60) .. " min"
	end
	if not target or not stats or not target:GetAttribute("DataReady") then return false, "Pick a player first." end
	if cmd == "goo" then
		local n = math.clamp(tonumber(a1) or 0, -1e12, 1e12)
		if n &gt;= 0 then grant(target, { goo = n }, "Gift") else stats.Goo.Value = math.max(0, stats.Goo.Value + n) end
		log("goo " .. n .. " -&gt; " .. target.Name)
		return true, "Goo changed by " .. n
	elseif cmd == "level" then
		local L = math.clamp(math.floor(tonumber(a1) or 1), 1, MAXLV)
		stats.Tongue.Value = L
		state(target, "BestLevel", "IntValue", 1).Value = L
		state(target, "RunMile", "IntValue", 0).Value = L
		log("level " .. L .. " -&gt; " .. target.Name)
		return true, "Level set to " .. L
	elseif cmd == "boost" then
		grant(target, { boostMin = math.clamp(math.floor(tonumber(a1) or 0), 1, 600) }, "Admin boost")
		log("boost -&gt; " .. target.Name)
		return true, "Boost added."
	elseif cmd == "rolls" then
		grant(target, { rolls = math.clamp(math.floor(tonumber(a1) or 0), 1, 50) }, "Admin rolls")
		log("rolls -&gt; " .. target.Name)
		return true, "Free rolls added."
	elseif cmd == "cosmetic" then
		if typeof(a1) ~= "string" or not cosmeticIds[a1] then return false, "Unknown cosmetic." end
		grant(target, { cosmetic = a1 }, "Admin gift")
		log("cosmetic " .. a1 .. " -&gt; " .. target.Name)
		return true, "Cosmetic given."
	elseif cmd == "resettut" then
		state(target, "Tut", "StringValue", "{}").Value = "{}"
		log("resettut -&gt; " .. target.Name)
		return true, "Tutorial will show again on rejoin."
	elseif cmd == "kick" then
		if target == plr then return false, "You cannot kick yourself." end
		local reason = typeof(a1) == "string" and string.sub(a1, 1, 80) or "Removed by an admin."
		log("kick " .. target.Name)
		target:Kick(reason ~= "" and reason or "Removed by an admin.")
		return true, "Kicked."
	elseif cmd == "bring" or cmd == "goto" then
		local a, b = plr, target
		if cmd == "bring" then a, b = target, plr end
		local ra = a.Character and a.Character:FindFirstChild("HumanoidRootPart")
		local rb = b.Character and b.Character:FindFirstChild("HumanoidRootPart")
		if not ra or not rb then return false, "Character missing." end
		ra.CFrame = rb.CFrame * CFrame.new(0, 0, 5)
		log(cmd .. " " .. target.Name)
		return true, "Done."
	end
	return false, "Unknown command."
end
print("[LickAdmin] ready (owner id set: " .. tostring(OWNER_USER_ID ~= 0) .. ")")
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX23">
        <Properties>
          <string name="Name">LickStands</string>
          <ProtectedString name="Source">-- LICK STANDS (server Script)  Location: ServerScriptService &gt; LickStands
-- The two NPC shop stands in EACH world hub. Tap the shopkeeper (or use the prompt) to open the shop.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local function report(name, err)
	warn("[Lick] " .. name .. ": " .. tostring(err))
	local log = ReplicatedStorage:FindFirstChild("LickBootLog")
	if log then
		log.Value = log.Value .. name .. ": " .. tostring(err) .. "\n"
	end
end

local function step(name, fn)
	local ok, err = pcall(fn)
	if not ok then
		report(name, err)
	end
end

local function getFolder(name, parent)
	local f = parent:FindFirstChild(name)
	if not f then
		f = Instance.new("Folder")
		f.Name = name
		f.Parent = parent
	end
	return f
end

local remotes = ReplicatedStorage:WaitForChild("LickRemotes")
local NotifyRemote = remotes:WaitForChild("Notify")
local OpenShopRemote = remotes:WaitForChild("OpenShop")

local function notify(plr, text, sfx)
	NotifyRemote:FireClient(plr, text, sfx)
end

local world = getFolder("LickWorld", workspace)

local BALL = Enum.PartType.Ball
local CYL = Enum.PartType.Cylinder
local K = 1 -- current model scale

local function mk(parent, shape, size, cf, color, material, transparency)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	if shape then p.Shape = shape end
	p.Transparency = transparency or 0
	p.TopSurface = shape and Enum.SurfaceType.Smooth or Enum.SurfaceType.Studs
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function ball(m, d, x, y, z, color, mat, tr)
	return mk(m, BALL, Vector3.new(d, d, d) * K, CFrame.new(x * K, y * K, z * K), color, mat, tr)
end

-- upright cylinder (height h, diameter d)
local function vcyl(m, h, d, x, y, z, color, mat)
	return mk(m, CYL, Vector3.new(h, d, d) * K, CFrame.new(x * K, y * K, z * K) * CFrame.Angles(0, 0, math.rad(90)), color, mat)
end

local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

-- NPC shop stands near spawn
local STANDS = {
	{ key = "upgrades", name = "Upgrade Shop", sign = "SHOP", pos = Vector3.new(-17, 0.6, -13), awning = rgb(190, 150, 230), hat = rgb(255, 120, 40) },
	{ key = "skins", name = "Skin Shop", sign = "SKINS", pos = Vector3.new(17, 0.6, -13), awning = rgb(255, 150, 190), hat = rgb(150, 70, 255) },
}

-- ===== NPC shop stands =====
local npcs = {}

local function buildStand(def)
	K = 1
	local WOOD = rgb(225, 160, 110)
	local DARKWOOD = rgb(190, 130, 85)
	local m = Instance.new("Model")
	m.Name = def.name

	local root = mk(m, nil, Vector3.new(0.4, 0.4, 0.4), CFrame.new(), WOOD)
	root.Transparency = 1
	root.CanCollide = false
	m.PrimaryPart = root

	-- counter, back panel, posts
	mk(m, nil, Vector3.new(9, 3.5, 2), CFrame.new(0, 1.75, -1.4), WOOD)
	mk(m, nil, Vector3.new(9, 3.2, 0.5), CFrame.new(0, 1.6, 3.2), DARKWOOD)
	for _, px in ipairs({ -4.3, 4.3 }) do
		mk(m, nil, Vector3.new(0.6, 8.2, 0.6), CFrame.new(px, 4.1, -2.7), DARKWOOD)
		mk(m, nil, Vector3.new(0.6, 8.2, 0.6), CFrame.new(px, 4.1, 3.0), DARKWOOD)
	end

	-- striped awning with scalloped front
	for i = 1, 9 do
		local x = -4 + (i - 1)
		local c = Color3.new(1, 1, 1)
		if i % 2 == 0 then
			c = def.awning
		end
		mk(m, nil, Vector3.new(1, 0.4, 7), CFrame.new(x, 8.4, 0.2) * CFrame.Angles(math.rad(-12), 0, 0), c)
		mk(m, BALL, Vector3.new(1.1, 1.1, 1.1), CFrame.new(x, 7.65, -3.25), c)
	end

	-- blue floor frame out front
	local frameColor = rgb(70, 120, 210)
	mk(m, nil, Vector3.new(12, 0.3, 0.6), CFrame.new(0, 0.15, -0.9), frameColor)
	mk(m, nil, Vector3.new(12, 0.3, 0.6), CFrame.new(0, 0.15, -6.9), frameColor)
	mk(m, nil, Vector3.new(0.6, 0.3, 6.6), CFrame.new(-6, 0.15, -3.9), frameColor)
	mk(m, nil, Vector3.new(0.6, 0.3, 6.6), CFrame.new(6, 0.15, -3.9), frameColor)

	-- props: crates and a cauldron
	mk(m, nil, Vector3.new(3, 3, 3), CFrame.new(-7, 1.5, 1), rgb(205, 145, 90))
	mk(m, nil, Vector3.new(3, 3, 3), CFrame.new(-7, 1.5, -2.2), rgb(205, 145, 90))
	mk(m, nil, Vector3.new(2.4, 2.4, 2.4), CFrame.new(-7, 4.2, 0) * CFrame.Angles(0, math.rad(25), 0), rgb(190, 130, 85))
	vcyl(m, 2.2, 3.4, 7, 1.1, 0.5, rgb(40, 40, 48))
	vcyl(m, 0.2, 2.8, 7, 2.15, 0.5, rgb(90, 255, 120), Enum.Material.Neon)

	-- big SHOP sign
	local signPart = mk(m, nil, Vector3.new(1, 1, 1), CFrame.new(0, 11.5, -1), Color3.new(1, 1, 1))
	signPart.Transparency = 1
	signPart.CanCollide = false
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(0, 240, 0, 90)
	gui.MaxDistance = 140
	gui.LightInfluence = 0
	gui.Parent = signPart
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.Bangers
	label.Text = def.sign
	label.TextColor3 = rgb(255, 250, 240)
	label.TextStrokeColor3 = rgb(110, 60, 160)
	label.TextStrokeTransparency = 0
	label.Parent = gui

	-- the shopkeeper NPC (a little noob built from parts)
	local npc = Instance.new("Model")
	npc.Name = "Shopkeeper"
	npc.Parent = m
	local yellow = rgb(245, 205, 48)
	mk(npc, nil, Vector3.new(0.9, 2, 1), CFrame.new(-0.5, 1, 1), rgb(40, 127, 71))
	mk(npc, nil, Vector3.new(0.9, 2, 1), CFrame.new(0.5, 1, 1), rgb(40, 127, 71))
	local torso = mk(npc, nil, Vector3.new(2, 2, 1), CFrame.new(0, 3, 1), rgb(13, 105, 172))
	mk(npc, nil, Vector3.new(1, 2, 1), CFrame.new(-1.5, 3, 1), yellow)
	mk(npc, nil, Vector3.new(1, 2, 1), CFrame.new(1.5, 3, 1), yellow)
	local head = mk(npc, nil, Vector3.new(1.3, 1.3, 1.3), CFrame.new(0, 4.6, 1), yellow)
	local face = Instance.new("Decal")
	face.Texture = "rbxasset://textures/face.png"
	face.Face = Enum.NormalId.Front
	face.Parent = head
	mk(npc, nil, Vector3.new(1.4, 0.4, 1.4), CFrame.new(0, 5.4, 1), def.hat)
	mk(npc, nil, Vector3.new(1.4, 0.15, 0.7), CFrame.new(0, 5.25, 0.35), def.hat)
	npc.PrimaryPart = torso

	m.Parent = world
	m:PivotTo(CFrame.lookAt(def.pos, def.face or Vector3.new(0, def.pos.Y, 0)))

	local entry = { model = npc, base = npc:GetPivot(), phase = math.random() * 6, bounceAt = nil }
	npcs[#npcs + 1] = entry

	local function open(plr)
		local char = plr.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
		if (hrp.Position - def.pos).Magnitude &gt; 40 then
			notify(plr, "Walk closer to the shop!", "error")
			return
		end
		entry.bounceAt = os.clock()
		notify(plr, nil, "click")
		OpenShopRemote:FireClient(plr, def.key)
	end

	local cd = Instance.new("ClickDetector")
	cd.MaxActivationDistance = 40
	cd.Parent = m
	cd.MouseClick:Connect(open)

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Open Shop"
	prompt.ObjectText = def.name
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = torso
	prompt.Triggered:Connect(open)
end

step("stands", function()
	for w = 1, 2 do
		local hx, hz = -480 + (w - 1) * 2000, -160
		for i, d in ipairs(STANDS) do
			local def = {}
			for k, v in pairs(d) do def[k] = v end
			def.pos = Vector3.new(hx + (i == 1 and -30 or 30), 0.6, hz + 14)
			def.face = Vector3.new(hx, 0.6, hz)
			buildStand(def)
		end
	end
end)

-- shopkeepers bob and wiggle, and hop when someone taps them
RunService.Heartbeat:Connect(function()
	local t = os.clock()
	for _, n in ipairs(npcs) do
		local bob = math.sin(t * 2 + n.phase) * 0.25
		local jump = 0
		if n.bounceAt then
			local bt = t - n.bounceAt
			if bt &lt; 0.5 then
				jump = math.sin(bt / 0.5 * math.pi) * 3
			end
		end
		n.model:PivotTo(n.base * CFrame.new(0, bob + jump, 0) * CFrame.Angles(0, math.sin(t + n.phase) * 0.12, 0))
	end
end)

print("[LickStands] ready")
