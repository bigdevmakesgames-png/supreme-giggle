						TweenService:Create(s, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Position = UDim2.new(1.2, 0, -0.3, 0) }):Play()
					end
				end)
			end
		end
	end
end)
local function getRoot()
	return player:WaitForChild("PlayerGui"):WaitForChild("LickUI"):WaitForChild("Root")
end
local function modal(root, titleStr, w, h, c1, c2)
	local old = root:FindFirstChild("LickModal")
	if old then old:Destroy() end
	local bd = Instance.new("TextButton")
	bd.Name = "LickModal"
	bd.Size = UDim2.new(1, 0, 1, 0)
	bd.BackgroundColor3 = Color3.new(0, 0, 0)
	bd.BackgroundTransparency = 0.5
	bd.Text = ""
	bd.AutoButtonColor = false
	bd.ZIndex = 10
	bd.Parent = root
	bd.Activated:Connect(function() bd:Destroy() end)
	local panel = box(bd, UDim2.new(0, w, 0, h), UDim2.new(0.5, 0, 0.5, 0), Color3.fromRGB(70, 100, 230), Color3.fromRGB(30, 40, 130), 16)
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Active = true
	popIn(panel)
	local head = box(panel, UDim2.new(1, 0, 0, 48), UDim2.new(0, 0, 0, 0), c1 or YELLOW1, c2 or YELLOW2, 16, true)
	text(head, titleStr, UDim2.new(1, -70, 1, 0), UDim2.new(0, 16, 0, 0), 28, WHITE, Enum.TextXAlignment.Left)
	local xb = button(head, "X", UDim2.new(0, 36, 0, 34), UDim2.new(1, -44, 0, 7), RED1, RED2, 20)
	xb.Activated:Connect(function() bd:Destroy() end)
	sfx("menu")
	return panel, bd
end

