local tg = Instance.new("TextLabel")
tg.BackgroundTransparency = 1
tg.Size = UDim2.new(1, 0, 0, 40)
tg.Position = UDim2.new(0, 0, 0, 14)
tg.Font = FONT
tg.Text = "👅"
tg.TextSize = 40
tg.ZIndex = 3
tg.Parent = b.Parent
b.TextYAlignment = Enum.TextYAlignment.Bottom
b.Position = UDim2.new(0, 0, 0, -8)
text(root, "Hold to lick  |  E key", UDim2.new(0, 170, 0, 16), UDim2.new(1, -274, 1, -148), 12)

local holding = false
local function loop()
	while holding do
		remotes.LickNearest:FireServer()
		task.wait(0.14)
	end
end
b.MouseButton1Down:Connect(function()
	if holding then return end
	holding = true
	task.spawn(loop)
end)
b.MouseButton1Up:Connect(function() holding = false end)
b.MouseLeave:Connect(function() holding = false end)
UserInputService.InputBegan:Connect(function(input, processed)
	if processed or input.KeyCode ~= Enum.KeyCode.E or holding then return end
	holding = true
	task.spawn(loop)
end)
UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.E then holding = false end
end)
print("[LickControls] ready")
</ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBX27">
          <Properties>
            <string name="Name">LickTongue</string>
            <ProtectedString name="Source">-- LICK TONGUE (LocalScript)  Location: StarterPlayer &gt; StarterPlayerScripts &gt; LickTongue
-- The big 3D pink tongue (built from smooth overlapping ellipsoids, bends along a curve, squash and stretch),
-- lick impact particles, floating goo numbers and goo orbs flying into your goo counter. All drawn locally (nothing replicated).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("LickRemotes")
local sfxEv = ReplicatedStorage:WaitForChild("LickSfx", 20)
local CFGF = ReplicatedStorage:WaitForChild("LickConfig")
local function csv(name)
	local t = {}
	for n in string.gmatch(CFGF:WaitForChild(name).Value, "[^,]+") do t[#t + 1] = tonumber(n) end
	return t
end
local COSTS, ZL, ZV = csv("LevelCosts"), csv("ZoneLevels"), csv("ZoneValues")
local ZN, WN = {}, {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
for n in string.gmatch(CFGF:WaitForChild("WorldNames").Value, "[^|]+") do WN[#WN + 1] = n end
local NW = #WN
local ZN = {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
local MAXLV = CFGF:GetAttribute("MaxLevel") or 400
local LPM = CFGF:GetAttribute("LPM") or 150
local function zoneOf(level)
	local z = 1
	for i = 1, #ZL do
		if level &gt;= ZL[i] then z = i end
	end
	return z
end
local function worldOf(x) return math.clamp(math.floor((x + 1000) / 2000) + 1, 1, NW) end
local function zoneAt(x, z)
	local w = worldOf(x)
	local col = math.clamp(math.floor((x - (w - 1) * 2000 + 640) / 320), 0, 3)
	local k = 8 - col
	if z &lt; 0 then k = col + 1 end
	return (w - 1) * 8 + k
end

local cam = workspace.CurrentCamera
local fxFolder = Instance.new("Folder")
fxFolder.Name = "LickLocalFx"
fxFolder.Parent = cam

local PINK, TIP, GROOVE = Color3.fromRGB(255, 92, 150), Color3.fromRGB(255, 150, 190), Color3.fromRGB(205, 45, 100)
local GOLD = Color3.fromRGB(255, 205, 40)
local function quality() return player:GetAttribute("FxQuality") or 3 end

-- ===== tongue rig =====
local function ellipsoid(color, parent)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = false, false, false, false
	p.Material = Enum.Material.SmoothPlastic
	p.Color = color
	p.Size = Vector3.new(1, 1, 1)
	p.Transparency = 1
	local m = Instance.new("SpecialMesh")
	m.MeshType = Enum.MeshType.Sphere
	m.Parent = p
	p.Parent = parent
	return p
end
local function newRig(n)
	local f = Instance.new("Folder")
	f.Name = "Tongue"
	f.Parent = fxFolder
	local r = { n = n, seg = {}, groove = {}, gloss = {}, bump = {}, folder = f, busy = false }
	for i = 1, n do
		r.seg[i] = ellipsoid(PINK, f)
		if i &gt; 1 and i &lt; n then
			r.groove[i] = ellipsoid(GROOVE, f)
			r.gloss[i] = ellipsoid(Color3.new(1, 1, 1), f)
		end
	end
	for i = 1, 7 do r.bump[i] = ellipsoid(TIP, f) end
	return r
end
local function hide(r)
	for _, p in pairs(r.seg) do p.Transparency = 1 end
	for _, p in pairs(r.groove) do p.Transparency = 1 end
	for _, p in pairs(r.gloss) do p.Transparency = 1 end
	for _, p in pairs(r.bump) do p.Transparency = 1 end
end

local function colorFor(plr)
	if plr:GetAttribute("Century") then return GOLD end
	local style = plr:GetAttribute("TongueStyle")
	if plr:GetAttribute("CosSkin") == "skin_prism" or style == "rainbow" then return "rainbow" end
	if style == "galaxy" then return Color3.fromRGB(150, 85, 255) end
	local tc = plr:GetAttribute("TongueColor")
	if tc then return tc end
	if style == "vip" then return Color3.fromRGB(255, 190, 70) end
	return PINK
end

local function ease(t) local c = t - 1 return 1 + c * c * c + 1.7 * c * c * (c + 0) end
local function outBack(t) local c1 = 1.9 local c3 = c1 + 1 return 1 + c3 * (t - 1) ^ 3 + c1 * (t - 1) ^ 2 end

-- one lick animation: mouth -&gt; target and back, with squash &amp; stretch
local function animate(rig, head, target, finished, plr)
	if rig.busy then return end
	rig.busy = true
	local t0 = os.clock()
	local W, E, H, R = 0.07, 0.11, finished and 0.16 or 0.08, 0.2
	local total = W + E + H + R
	local base = colorFor(plr)
	local n = rig.n
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		if t &gt; total or not head.Parent then
			conn:Disconnect()
			hide(rig)
			rig.busy = false
			return
		end
		local mouth = head.Position + head.CFrame.LookVector * 0.9 + Vector3.new(0, -0.35, 0)
		local dir = target - mouth
		local dist = dir.Magnitude
		dir = dir.Unit
		-- length and thickness over time
		local len, th
		if t &lt; W then
			local k = t / W
			len = 0.16 - 0.1 * k
			th = 1 + 0.35 * k
		elseif t &lt; W + E then
			local k = (t - W) / E
			len = 0.06 + 1.04 * outBack(k) * 0.92
			th = 1.35 - 0.6 * k
		elseif t &lt; W + E + H then
			local k = (t - W - E) / H
			len = 1.0 + 0.03 * math.sin(k * 20)
			th = 0.75 + 0.45 * math.sin(math.min(k * 3, 1) * 1.57)
		else
			local k = (t - W - E - H) / R
			len = 1.0 - 0.9 * (k * k * (3 - 2 * k))
			th = 1.2 - 0.2 * k + 0.12 * math.sin(k * 14) * (1 - k)
		end
		local L = math.max(len * dist, 1.2)
		local tip = mouth + dir * L
		local up = Vector3.new(0, 1, 0)
		local side = dir:Cross(up)
		if side.Magnitude &lt; 0.01 then side = Vector3.new(1, 0, 0) end
		side = side.Unit
		local sag = math.clamp(L * 0.16, 0.4, 5) * (1 - math.abs(len - 1))
		local ctrl = (mouth + tip) / 2 + Vector3.new(0, sag, 0)
		local segLen = (L / (n - 1)) * 2.1
		local prev = mouth
		for i = 1, n do
			local u = (i - 1) / (n - 1)
			local pt = (1 - u) ^ 2 * mouth + 2 * (1 - u) * u * ctrl + u * u * tip
			pt = pt + side * math.sin(u * 7 + t * 24) * 0.22 * (1 - u) * (1 - len * 0.5) + up * math.sin(u * 5 + t * 18) * 0.12
			local nxt = (1 - math.min(u + 0.05, 1)) ^ 2 * mouth + 2 * (1 - math.min(u + 0.05, 1)) * math.min(u + 0.05, 1) * ctrl + math.min(u + 0.05, 1) ^ 2 * tip
			local fw = (nxt - pt)
			if fw.Magnitude &lt; 0.01 then fw = dir end
			local cf = CFrame.lookAt(pt, pt + fw)
			local w = (1.0 + 1.35 * math.sin(math.pi * (0.2 + 0.8 * u) * 0.9)) * th
			if u &gt; 0.86 then w = w * (1 - (u - 0.86) * 2.6) end
			if u &gt; 0.9 and t &gt; W + E and finished then w = w * 1.12 end
			local hgt = (0.55 + 0.5 * math.sin(math.pi * u * 0.8)) * th
			local col
			if base == "rainbow" then col = Color3.fromHSV((os.clock() * 0.7 + u * 0.6) % 1, 0.65, 1) else col = base:Lerp(TIP, u * u * 0.6) end
			local s = rig.seg[i]
			s.Color = col
			s.Size = Vector3.new(math.max(w, 0.2), math.max(hgt, 0.2), segLen)
			s.CFrame = cf
			s.Transparency = 0
			if rig.groove[i] then
				local g = rig.groove[i]
				g.Size = Vector3.new(0.2 * th, 0.14, segLen * 0.9)
				g.CFrame = cf * CFrame.new(0, hgt * 0.43, 0)
				g.Transparency = 0.05
				local gl = rig.gloss[i]
				gl.Size = Vector3.new(w * 0.35, 0.1, segLen * 0.7)
				gl.CFrame = cf * CFrame.new(-w * 0.22, hgt * 0.47, 0)
				gl.Transparency = 0.55
			end
			prev = pt
		end
		for i, b in ipairs(rig.bump) do
			local u = 0.7 + (i % 4) * 0.07
			local pt = (1 - u) ^ 2 * mouth + 2 * (1 - u) * u * ctrl + u * u * tip
			b.Size = Vector3.new(0.28, 0.2, 0.28)
			b.CFrame = CFrame.new(pt + up * (0.5 * th) + side * ((i % 3) - 1) * 0.45)
			b.Transparency = 0
		end
	end)
end

local rigs = {}
local function rigFor(plr, light)
	local r = rigs[plr]
	if not r then
		r = newRig(light and 9 or 14)
		rigs[plr] = r
	end
	return r
end
Players.PlayerRemoving:Connect(function(plr)
	if rigs[plr] then rigs[plr].folder:Destroy() rigs[plr] = nil end
end)

-- ===== particles / rings / numbers =====
local emPool, emIdx = {}, 0
local function emitter()
	emIdx = emIdx % 6 + 1
	local e = emPool[emIdx]
	if not e then
		local part = Instance.new("Part")
		part.Anchored, part.CanCollide, part.CanQuery, part.CanTouch, part.Transparency, part.Size = true, false, false, false, 1, Vector3.new(0.2, 0.2, 0.2)
		part.Parent = fxFolder
		local pe = Instance.new("ParticleEmitter")
		pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		pe.Lifetime = NumberRange.new(0.45, 0.9)
		pe.Speed = NumberRange.new(12, 26)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.Drag = 3
		pe.Acceleration = Vector3.new(0, -34, 0)
		pe.LightEmission = 0.65
		pe.Rate = 0
		pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0) })
		pe.Parent = part
		e = { part, pe }
		emPool[emIdx] = e
	end
	return e
end
local function burst(pos, color, count, confetti)
	local e = emitter()
	e[1].Position = pos
	e[2].Color = confetti and ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 120)), ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 225, 80)), ColorSequenceKeypoint.new(0.66, Color3.fromRGB(90, 220, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(190, 110, 255)) }) or ColorSequence.new(color)
	e[2]:Emit(math.max(1, math.floor(count * (quality() / 3))))
end
local function ring(pos, color, size)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Shape = Enum.PartType.Cylinder
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Size = Vector3.new(0.3, 1, 1)
	p.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
	p.Transparency = 0.2
	p.Parent = fxFolder
	local tw = TweenService:Create(p, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.3, size, size), Transparency = 1 })
	tw:Play()
	tw.Completed:Connect(function() p:Destroy() end)
end
local function floatText(pos, str, color, scale)
	local part = Instance.new("Part")
	part.Anchored, part.CanCollide, part.CanQuery, part.CanTouch, part.Transparency, part.Size = true, false, false, false, 1, Vector3.new(0.2, 0.2, 0.2)
	part.Position = pos
	part.Parent = fxFolder
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(0, 160 * scale, 0, 46 * scale)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Parent = part
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, 0, 1, 0)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.Text = str
	l.TextColor3 = color
	l.TextStrokeColor3 = Color3.fromRGB(20, 10, 50)
	l.TextStrokeTransparency = 0
	l.Parent = gui
	TweenService:Create(part, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = pos + Vector3.new(0, 5 + scale * 2, 0) }):Play()
	local tw = TweenService:Create(l, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1, TextStrokeTransparency = 1 })
	tw:Play()
	tw.Completed:Connect(function() part:Destroy() end)
end

-- goo orbs fly from the food into the goo counter
local fxGui = Instance.new("ScreenGui")
fxGui.Name = "LickFxGui"
fxGui.ResetOnSpawn = false
fxGui.IgnoreGuiInset = true
fxGui.DisplayOrder = 20
fxGui.Parent = player:WaitForChild("PlayerGui")
local orbs = {}
local function orb(from, color)
	local o = Instance.new("Frame")
	o.Size = UDim2.new(0, 16, 0, 16)
	o.AnchorPoint = Vector2.new(0.5, 0.5)
	o.BackgroundColor3 = color
	o.BorderSizePixel = 0
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(1, 0)
	c.Parent = o
	local s = Instance.new("UIStroke")
	s.Color = Color3.new(1, 1, 1)
	s.Thickness = 2
	s.Parent = o
	o.Position = UDim2.new(0, from.X, 0, from.Y)
	o.Parent = fxGui
	local root = fxGui.Parent:FindFirstChild("LickUI") and fxGui.Parent.LickUI:FindFirstChild("Root")
	local tx, ty = root and root:GetAttribute("GooX") or 120, root and root:GetAttribute("GooY") or 140
	orbs[#orbs + 1] = { o, from, Vector2.new(tx, ty), os.clock(), 0.5 + math.random() * 0.3, Vector2.new((math.random() - 0.5) * 220, -80 - math.random() * 120) }
end
RunService.RenderStepped:Connect(function()
	for i = #orbs, 1, -1 do
		local d = orbs[i]
		local k = (os.clock() - d[4]) / d[5]
		if k &gt;= 1 then
			d[1]:Destroy()
			table.remove(orbs, i)
		else
			local e = k * k
			local ctrl = (d[2] + d[3]) / 2 + d[6]
			local p = (1 - e) ^ 2 * d[2] + 2 * (1 - e) * e * ctrl + e * e * d[3]
			d[1].Position = UDim2.new(0, p.X, 0, p.Y)
			d[1].Size = UDim2.new(0, 16 - 6 * k, 0, 16 - 6 * k)
		end
	end
end)

-- ===== events =====
local function aimTarget(model)
	return model:GetAttribute("Center")
end

remotes.Eat.OnClientEvent:Connect(function(model, bite, total, finished, gain, lucky)
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	local center = model and model:GetAttribute("Center")
	if not head or not center then return end
	local hr = char:FindFirstChild("HumanoidRootPart")
	if hr then
		local flat = Vector3.new(center.X, hr.Position.Y, center.Z)
		if (flat - hr.Position).Magnitude &gt; 1 then hr.CFrame = CFrame.lookAt(hr.Position, flat) end
	end
	animate(rigFor(player, false), head, center, finished, player)
	local col = colorFor(player)
	if col == "rainbow" then col = Color3.fromHSV(os.clock() % 1, 0.6, 1) end
	local tier = finished and 2 or 1
	if lucky then tier = tier + 1 end
	task.delay(0.19, function()
		local conf = player:GetAttribute("CosBurst") ~= nil and finished
		burst(center, col, tier == 1 and 8 or tier == 2 and 22 or 34, conf)
		if tier &gt;= 2 then ring(center - Vector3.new(0, center.Y - 0.3, 0), col, tier == 2 and 12 or 18) end
		local numCol = tier == 1 and Color3.new(1, 1, 1) or tier == 2 and Color3.fromRGB(255, 235, 90) or GOLD
		floatText(center + Vector3.new(0, 4, 0), (tier &gt;= 3 and "LUCKY +" or "+") .. gain, numCol, 0.9 + tier * 0.25)
		local sp, onScreen = cam:WorldToViewportPoint(center)
		if onScreen then
			for _ = 1, (tier == 1 and 2 or tier == 2 and 5 or 8) * quality() / 3 do orb(Vector2.new(sp.X, sp.Y), tier &gt;= 3 and GOLD or Color3.fromRGB(120, 255, 215)) end
		end
		if finished and quality() &gt;= 2 then
			local fov = cam.FieldOfView
			TweenService:Create(cam, TweenInfo.new(0.08), { FieldOfView = fov - 4 }):Play()
			task.delay(0.1, function() TweenService:Create(cam, TweenInfo.new(0.25, Enum.EasingStyle.Back), { FieldOfView = fov }):Play() end)
		end
	end)
end)

local active = 0
remotes.LickFx.OnClientEvent:Connect(function(userId, center, finished)
	if quality() &lt; 2 or active &gt;= 3 then return end
	local plr = Players:GetPlayerByUserId(userId)
	local head = plr and plr.Character and plr.Character:FindFirstChild("Head")
	if not head then return end
	local rig = rigFor(plr, true)
	if rig.busy then return end
	active = active + 1
	animate(rig, head, center, finished, plr)
	task.delay(0.19, function()
		burst(center, Color3.fromRGB(255, 130, 190), finished and 10 or 4)
		active = math.max(0, active - 1)
	end)
end)
print("[LickTongue] ready")
</ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBX28">
          <Properties>
            <string name="Name">LickFood</string>
            <ProtectedString name="Source">-- LICK FOOD (LocalScript)  Location: StarterPlayer &gt; StarterPlayerScripts &gt; LickFood
-- Food reacts to YOUR licks only (squish, shake, bite stages, crumbs, completion pop, regrow). Everything here is local,
-- so another player's burger is never changed by your bites. Also shows one small name tag on the nearest food.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("LickRemotes")
local CFGF = ReplicatedStorage:WaitForChild("LickConfig")
local function csv(name)
	local t = {}
	for n in string.gmatch(CFGF:WaitForChild(name).Value, "[^,]+") do t[#t + 1] = tonumber(n) end
	return t
end
local COSTS, ZL, ZV = csv("LevelCosts"), csv("ZoneLevels"), csv("ZoneValues")
local ZN, WN = {}, {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
for n in string.gmatch(CFGF:WaitForChild("WorldNames").Value, "[^|]+") do WN[#WN + 1] = n end
local NW = #WN
local ZN = {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
local MAXLV = CFGF:GetAttribute("MaxLevel") or 400
local LPM = CFGF:GetAttribute("LPM") or 150
local function zoneOf(level)
	local z = 1
	for i = 1, #ZL do
		if level &gt;= ZL[i] then z = i end
	end
	return z
end
local function worldOf(x) return math.clamp(math.floor((x + 1000) / 2000) + 1, 1, NW) end
local function zoneAt(x, z)
	local w = worldOf(x)
	local col = math.clamp(math.floor((x - (w - 1) * 2000 + 640) / 320), 0, 3)
	local k = 8 - col
	if z &lt; 0 then k = col + 1 end
	return (w - 1) * 8 + k
end

local REGROW = CFGF:GetAttribute("RegrowSeconds") or 6
local lickables = workspace:WaitForChild("LickWorld"):WaitForChild("Lickables")
local st = {}

local function quality() return player:GetAttribute("FxQuality") or 3 end

-- crumb particles in the color of the part that was just eaten
local crumbPart = Instance.new("Part")
crumbPart.Anchored, crumbPart.CanCollide, crumbPart.CanQuery, crumbPart.CanTouch, crumbPart.Transparency = true, false, false, false, 1
crumbPart.Size = Vector3.new(0.2, 0.2, 0.2)
crumbPart.Parent = workspace.CurrentCamera
local crumbs = Instance.new("ParticleEmitter")
crumbs.Texture = "rbxasset://textures/particles/sparkles_main.dds"
crumbs.Lifetime = NumberRange.new(0.4, 0.8)
crumbs.Speed = NumberRange.new(6, 14)
crumbs.SpreadAngle = Vector2.new(180, 180)
crumbs.Acceleration = Vector3.new(0, -40, 0)
crumbs.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 0) })
crumbs.Rate = 0
crumbs.Parent = crumbPart
local function crumb(pos, color, n)
	crumbPart.Position = pos
	crumbs.Color = ColorSequence.new(color)
	crumbs:Emit(n)
end

local function state(model)
	local s = st[model]
	if not s then
		local parts = {}
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") and d ~= model.PrimaryPart then parts[#parts + 1] = d end
		end
		s = { parts = parts, hidden = 0, busy = false, bite = 0 }
		st[model] = s
	end
	return s
end

-- squash and spring back (scales only YOUR local copy of the model)
local function squish(model, strength)
	task.spawn(function()
		local t0 = os.clock()
		while true do
			local k = (os.clock() - t0) / 0.26
			if k &gt;= 1 or not model.Parent then break end
			local s = 1 - strength * math.sin(k * math.pi) * (1 - k * 0.5) + 0.08 * math.sin(k * 14) * (1 - k)
			pcall(function() model:ScaleTo(math.max(s, 0.3)) end)
			RunService.Heartbeat:Wait()
		end
		pcall(function() model:ScaleTo(1) end)
	end)
end
local function shake(model)
	task.spawn(function()
		local base = model:GetPivot()
		local t0 = os.clock()
		while os.clock() - t0 &lt; 0.32 and model.Parent do
			local k = (os.clock() - t0) / 0.32
			model:PivotTo(base * CFrame.new(math.sin(k * 60) * 0.35 * (1 - k), 0, math.cos(k * 47) * 0.2 * (1 - k)))
			RunService.Heartbeat:Wait()
		end
		model:PivotTo(base)
	end)
end

remotes.Eat.OnClientEvent:Connect(function(model, bite, total, finished, gain, lucky)
	if not model or not model.Parent then return end
	local s = state(model)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if s.hidden == 0 and root and not s.sorted then
		table.sort(s.parts, function(a, b) return (a.Position - root.Position).Magnitude &lt; (b.Position - root.Position).Magnitude end)
		s.sorted = true
	end
	s.bite = bite
	local target = finished and #s.parts or math.floor(#s.parts * 0.88 * bite / total)
	for i = s.hidden + 1, target do
		local p = s.parts[i]
		p.LocalTransparencyModifier = 1
		if quality() &gt;= 2 and i % 2 == 0 then crumb(p.Position, p.Color, 2) end
	end
	s.hidden = math.max(s.hidden, target)
	if quality() &gt;= 2 then
		squish(model, finished and 0.28 or 0.14)
		if not finished and bite == total - 1 then task.delay(0.28, function() shake(model) end) end
	end
	if finished then
		task.delay(REGROW, function()
			if not model.Parent then return end
			for _, p in ipairs(s.parts) do p.LocalTransparencyModifier = 0 end
			s.hidden, s.bite, s.sorted = 0, 0, false
			if quality() &gt;= 2 then
				task.spawn(function()
					local t0 = os.clock()
					while true do
						local k = (os.clock() - t0) / 0.4
						if k &gt;= 1 or not model.Parent then break end
						local c = k - 1
						pcall(function() model:ScaleTo(math.max(0.05, 1 + 2.7 * c * c * c + 1.7 * c * c)) end)
						RunService.Heartbeat:Wait()
					end
					pcall(function() model:ScaleTo(1) end)
				end)
			end
		end)
	end
end)

