</ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBX29">
          <Properties>
            <string name="Name">LickCelebrate</string>
            <ProtectedString name="Source">-- LICK CELEBRATE (LocalScript)  Location: StarterPlayer &gt; StarterPlayerScripts &gt; LickCelebrate
-- Banners, flashes, confetti and screen shake for level-ups, zone/world unlocks, rebirth, quests, achievements and rewards.
-- Bigger events get bigger effects; small rewards stay small.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local function errBanner(msg)
	local pg = player:WaitForChild("PlayerGui")
	if pg:FindFirstChild("LickError") then return end
	local g = Instance.new("ScreenGui")
	g.Name = "LickError"
	g.ResetOnSpawn = false
	g.DisplayOrder = 500
	g.Parent = pg
	local t = Instance.new("TextLabel")
	t.Size = UDim2.new(0.8, 0, 0.3, 0)
	t.Position = UDim2.new(0.1, 0, 0.35, 0)
	t.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextScaled = true
	t.TextWrapped = true
	t.Font = Enum.Font.FredokaOne
	t.Text = msg
	t.Parent = g
end
local remotes = ReplicatedStorage:WaitForChild("LickRemotes", 20)
if not remotes then
	errBanner("LICK ERROR: the LickData script is not running. It must be a Script in ServerScriptService. Check the Output window.")
	return
end
local sfxEv = ReplicatedStorage:WaitForChild("LickSfx", 20)
if not sfxEv then
	errBanner("LICK ERROR: the LickAudio LocalScript is missing (StarterPlayer &gt; StarterPlayerScripts).")
	return
end
local function sfx(key, speed, vol) sfxEv:Fire(key, speed, vol) end
local FONT = Enum.Font.FredokaOne
local WHITE = Color3.new(1, 1, 1)
local DARK = Color3.fromRGB(10, 10, 40)
local BLUE1, BLUE2 = Color3.fromRGB(60, 160, 255), Color3.fromRGB(20, 80, 200)
local GREEN1, GREEN2 = Color3.fromRGB(90, 230, 90), Color3.fromRGB(30, 150, 40)
local ORANGE1, ORANGE2 = Color3.fromRGB(255, 190, 60), Color3.fromRGB(230, 110, 20)
local PINK1, PINK2 = Color3.fromRGB(255, 110, 200), Color3.fromRGB(190, 40, 150)
local PURPLE1, PURPLE2 = Color3.fromRGB(170, 90, 255), Color3.fromRGB(90, 40, 200)
local RED1, RED2 = Color3.fromRGB(255, 90, 90), Color3.fromRGB(190, 30, 30)
local YELLOW1, YELLOW2 = Color3.fromRGB(255, 240, 100), Color3.fromRGB(240, 165, 20)
local CYAN1, CYAN2 = Color3.fromRGB(100, 255, 240), Color3.fromRGB(20, 160, 190)
local LIME1, LIME2 = Color3.fromRGB(180, 255, 100), Color3.fromRGB(60, 170, 40)
local function fmt(n)
	n = math.floor(n or 0)
	if n &lt; 1000 then return tostring(n) end
	local suf = { "K", "M", "B", "T", "Qa", "Qi" }
	local i, v = 0, n
	while v &gt;= 1000 and i &lt; #suf do
		v = v / 1000
		i = i + 1
	end
	if v &lt; 10 then return string.format("%.2f%s", v, suf[i]) end
	if v &lt; 100 then return string.format("%.1f%s", v, suf[i]) end
	return string.format("%.0f%s", v, suf[i])
end
local function corner(p, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 12)
	c.Parent = p
end
local function stroke(p, color, th)
	local s = Instance.new("UIStroke")
	s.Color = color or DARK
	s.Thickness = th or 3
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = p
end
local function gradient(p, c1, c2, rot)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(c1, c2)
	g.Rotation = rot or 90
	g.Parent = p
	return g
end
local shines = {}
local function gloss(f, r)
	local g = Instance.new("Frame")
	g.Size = UDim2.new(1, -8, 0.48, 0)
	g.Position = UDim2.new(0, 4, 0, 3)
	g.BackgroundColor3 = WHITE
	g.BorderSizePixel = 0
	g.Parent = f
	corner(g, r or 10)
	local gr = Instance.new("UIGradient")
	gr.Rotation = 90
	gr.Transparency = NumberSequence.new(0.35, 0.85)
	gr.Parent = g
	local dot = Instance.new("Frame")
	dot.Size = UDim2.new(0, 7, 0, 7)
	dot.Position = UDim2.new(0, 10, 0, 7)
	dot.BackgroundColor3 = WHITE
	dot.BackgroundTransparency = 0.15
	dot.BorderSizePixel = 0
	dot.Parent = f
	corner(dot, 4)
	local clip = Instance.new("Frame")
	clip.Size = UDim2.new(1, 0, 1, 0)
	clip.BackgroundTransparency = 1
	clip.ClipsDescendants = true
	clip.Parent = f
	local st = Instance.new("Frame")
	st.Size = UDim2.new(0.18, 0, 1.6, 0)
	st.Position = UDim2.new(-0.4, 0, -0.3, 0)
	st.Rotation = 20
	st.BackgroundColor3 = WHITE
	st.BackgroundTransparency = 0.7
	st.BorderSizePixel = 0
	st.Parent = clip
	shines[#shines + 1] = st
end
local function box(parent, size, pos, c1, c2, r, shiny)
	local f = Instance.new("Frame")
	f.Size = size
	f.Position = pos
	f.BackgroundColor3 = WHITE
	f.BorderSizePixel = 0
	f.Parent = parent
	corner(f, r or 12)
	stroke(f)
	gradient(f, c1, c2 or c1)
	if shiny then gloss(f, (r or 12) - 2) end
	return f
end
local function text(parent, str, size, pos, ts, color, ax)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = size
	l.Position = pos
	l.Font = FONT
	l.Text = str
	l.TextSize = ts
	l.TextColor3 = color or WHITE
	l.TextStrokeColor3 = DARK
	l.TextStrokeTransparency = 0
	l.TextXAlignment = ax or Enum.TextXAlignment.Center
	l.Parent = parent
	return l
end
local function bounce(sc, from)
	sc.Scale = from or 0.85
	TweenService:Create(sc, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end
local function popIn(obj)
	local sc = Instance.new("UIScale")
	sc.Scale = 0.6
	sc.Parent = obj
	TweenService:Create(sc, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end
local function button(parent, str, size, pos, c1, c2, ts, idle)
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Size = size
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.new(pos.X.Scale + size.X.Scale * 0.5, pos.X.Offset + size.X.Offset * 0.5, pos.Y.Scale + size.Y.Scale * 0.5, pos.Y.Offset + size.Y.Offset * 0.5)
	holder.Parent = parent
	local pop = Instance.new("UIScale")
	pop.Parent = holder
	local wrap = Instance.new("Frame")
	wrap.BackgroundTransparency = 1
	wrap.Size = UDim2.new(1, 0, 1, 0)
	wrap.Parent = holder
	if idle then
		local ps = Instance.new("UIScale")
		ps.Parent = wrap
		TweenService:Create(ps, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = 1.07 }):Play()
	end
	local vis = box(wrap, UDim2.new(1, 0, 1, 0), UDim2.new(0, 0, 0, 0), c1, c2, nil, true)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 1, 0)
	b.BackgroundTransparency = 1
	b.Font = FONT
	b.Text = str
	b.TextSize = ts or 22
	b.TextColor3 = WHITE
	b.TextStrokeColor3 = DARK
	b.TextStrokeTransparency = 0
	b.ZIndex = 2
	b.Parent = wrap
	b.Activated:Connect(function()
		sfx("click")
		bounce(pop, 0.85)
	end)
	return b, holder, vis
end
task.spawn(function()
	while true do
		task.wait(2.8)
		for i = #shines, 1, -1 do
			local s = shines[i]
			if not s:IsDescendantOf(game) then
				table.remove(shines, i)
			else
				task.delay(math.random() * 0.8, function()
					if s:IsDescendantOf(game) then
						s.Position = UDim2.new(-0.4, 0, -0.3, 0)
						TweenService:Create(s, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Position = UDim2.new(1.2, 0, -0.3, 0) }):Play()
					end
				end)
			end
		end
	end
end)

local CFGF = ReplicatedStorage:WaitForChild("LickConfig")
local function csv(name)
	local t = {}
	for n in string.gmatch(CFGF:WaitForChild(name).Value, "[^,]+") do t[#t + 1] = tonumber(n) end
	return t
end
local COSTS, ZL, ZV = csv("LevelCosts"), csv("ZoneLevels"), csv("ZoneValues")
local ZN, WN = {}, {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
for n in string.gmatch(CFGF:WaitForChild("WorldNames").Value, "[^|]+") do WN[#WN + 1] = n end
local NW = #WN
local ZN = {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
local MAXLV = CFGF:GetAttribute("MaxLevel") or 400
local LPM = CFGF:GetAttribute("LPM") or 150
local function zoneOf(level)
	local z = 1
	for i = 1, #ZL do
		if level &gt;= ZL[i] then z = i end
	end
	return z
end
local function worldOf(x) return math.clamp(math.floor((x + 1000) / 2000) + 1, 1, NW) end
local function zoneAt(x, z)
	local w = worldOf(x)
	local col = math.clamp(math.floor((x - (w - 1) * 2000 + 640) / 320), 0, 3)
	local k = 8 - col
	if z &lt; 0 then k = col + 1 end
	return (w - 1) * 8 + k
end

local root = player:WaitForChild("PlayerGui"):WaitForChild("LickUI"):WaitForChild("Root")
local ZC = {}
for h in string.gmatch(CFGF:WaitForChild("ZoneColors").Value, "[^,]+") do ZC[#ZC + 1] = Color3.fromHex(h) end
local function quality() return player:GetAttribute("FxQuality") or 3 end
local COLS = { Color3.fromRGB(255, 90, 120), Color3.fromRGB(255, 225, 80), Color3.fromRGB(90, 220, 255), Color3.fromRGB(190, 110, 255), Color3.fromRGB(120, 255, 150), Color3.fromRGB(255, 160, 60) }

local fx = Instance.new("Frame")
fx.Name = "CelebrateLayer"
fx.BackgroundTransparency = 1
fx.Size = UDim2.new(1, 0, 1, 0)
fx.ZIndex = 30
fx.Parent = root

local function flash(color, alpha, dur)
	local f = Instance.new("Frame")
	f.Size = UDim2.new(1, 0, 1, 0)
	f.BackgroundColor3 = color
	f.BackgroundTransparency = alpha
	f.BorderSizePixel = 0
	f.ZIndex = 31
	f.Parent = fx
	local tw = TweenService:Create(f, TweenInfo.new(dur), { BackgroundTransparency = 1 })
	tw:Play()
	tw.Completed:Connect(function() f:Destroy() end)
end

local function confetti(n)
	n = math.floor(n * quality() / 3)
	for i = 1, n do
		local c = Instance.new("Frame")
		local sz = math.random(8, 16)
		c.Size = UDim2.new(0, sz, 0, sz * 0.6)
		c.Position = UDim2.new(math.random(), 0, -0.05, 0)
		c.Rotation = math.random(0, 360)
		c.BackgroundColor3 = COLS[math.random(#COLS)]
		c.BorderSizePixel = 0
		c.ZIndex = 32
		c.Parent = fx
		local tw = TweenService:Create(c, TweenInfo.new(1.2 + math.random() * 1.0, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.new(c.Position.X.Scale + (math.random() - 0.5) * 0.3, 0, 1.1, 0), Rotation = c.Rotation + math.random(-400, 400), BackgroundTransparency = 0.5 })
		task.delay(i * 0.012, function() tw:Play() end)
		tw.Completed:Connect(function() c:Destroy() end)
	end
end

local function shake(amount, dur)
	if quality() &lt; 2 then return end
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 &lt; dur do
			local k = 1 - (os.clock() - t0) / dur
			hum.CameraOffset = Vector3.new((math.random() - 0.5) * amount * k, (math.random() - 0.5) * amount * k, 0)
			RunService.Heartbeat:Wait()
		end
		hum.CameraOffset = Vector3.new(0, 0, 0)
	end)
end

local function ringBurst(color, n)
	for i = 1, n do
		task.delay(i * 0.12, function()
			local r = Instance.new("Frame")
			r.AnchorPoint = Vector2.new(0.5, 0.5)
			r.Position = UDim2.new(0.5, 0, 0.42, 0)
			r.Size = UDim2.new(0, 30, 0, 30)
			r.BackgroundTransparency = 1
			r.ZIndex = 31
			r.Parent = fx
			corner(r, 500)
			local s = Instance.new("UIStroke")
			s.Color = color
			s.Thickness = 8
			s.Parent = r
			TweenService:Create(r, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(0, 900, 0, 900) }):Play()
			local tw = TweenService:Create(s, TweenInfo.new(0.8), { Transparency = 1, Thickness = 1 })
			tw:Play()
			tw.Completed:Connect(function() r:Destroy() end)
		end)
	end
end

-- banners play one after another
local queue, playing = {}, false
local function playBanner(b)
	local w = 320 + b.tier * 70
	local f = box(fx, UDim2.new(0, w, 0, 70 + b.tier * 18), UDim2.new(0.5, 0, 0.26, 0), b.c1, b.c2, 18, true)
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.ZIndex = 33
	popIn(f)
	local t = text(f, b.title, UDim2.new(1, -20, 0.55, 0), UDim2.new(0, 10, 0, 4), 24 + b.tier * 5)
	t.ZIndex = 34
	t.TextScaled = true
	local s = text(f, b.sub or "", UDim2.new(1, -20, 0.3, 0), UDim2.new(0, 10, 0.62, 0), 16)
	s.ZIndex = 34
	s.TextScaled = true
	if b.tier &gt;= 2 then flash(b.c1, 0.6, 0.5) end
	if b.tier &gt;= 3 then
		ringBurst(b.c1, 3)
		shake(0.6, 0.35)
	end
	if b.confetti &gt; 0 then confetti(b.confetti) end
	task.wait(1.5 + b.tier * 0.5)
	TweenService:Create(f, TweenInfo.new(0.35), { BackgroundTransparency = 1 }):Play()
	task.wait(0.35)
	f:Destroy()
end
local function banner(title, sub, c1, c2, tier, conf)
	if #queue &gt;= 3 then table.remove(queue, 1) end
	queue[#queue + 1] = { title = title, sub = sub, c1 = c1, c2 = c2, tier = tier, confetti = conf or 0 }
	if playing then return end
	playing = true
	task.spawn(function()
		while #queue &gt; 0 do
			local b = table.remove(queue, 1)
			playBanner(b)
		end
		playing = false
	end)
end

local function pill(str, big)
	local f = box(fx, UDim2.new(0, 290 + (big and 80 or 0), 0, big and 56 or 42), UDim2.new(0.5, 0, 0.14, 0), Color3.fromRGB(120, 255, 190), Color3.fromRGB(30, 170, 120), 20, true)
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.ZIndex = 33
	popIn(f)
	local t = text(f, str, UDim2.new(1, -16, 1, 0), UDim2.new(0, 8, 0, 0), big and 26 or 20)
	t.ZIndex = 34
	t.TextScaled = true
	TweenService:Create(f, TweenInfo.new(0.3, Enum.EasingStyle.Quad), { Position = UDim2.new(0.5, 0, 0.1, 0) }):Play()
	task.delay(1.6, function()
		TweenService:Create(f, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
		task.delay(0.4, function() f:Destroy() end)
	end)
end

remotes.Celebrate.OnClientEvent:Connect(function(kind, a, b)
	if kind == "level" then
		banner("LEVEL " .. a .. "!", b and b &gt; 1 and ("+" .. b .. " levels") or "Your tongue is stronger!", BLUE1, BLUE2, 1, 14)
	elseif kind == "zone" then
		local c = ZC[a] or YELLOW1
		banner("NEW ZONE UNLOCKED!", ZN[a], c:Lerp(WHITE, 0.2), c:Lerp(DARK, 0.4), 3, 60)
	elseif kind == "world" then
		banner("WELCOME TO", a, PURPLE1, PURPLE2, 3, 50)
	elseif kind == "rebirth" then
		flash(WHITE, 0.2, 1.2)
		banner("REBIRTH " .. a .. "!", "Permanent goo bonus + new rewards", PINK1, PINK2, 4, 90)
		shake(1.2, 0.8)
	elseif kind == "feature" then
		banner("UNLOCKED!", tostring(a), GREEN1, GREEN2, 2, 20)
	elseif kind == "reward" then
		local az = player:FindFirstChild("LickState") and player.LickState:FindFirstChild("BestLevel")
		local income = LPM * ZV[zoneOf(az and az.Value or 1)]
		local mins = (tonumber(a) or 0) / math.max(income, 1)
		if mins &gt;= 8 then
			banner("+" .. fmt(a) .. " GOO", tostring(b), YELLOW1, YELLOW2, 2, 30)
		else
			pill("+" .. fmt(a) .. " goo  " .. tostring(b), mins &gt;= 2)
		end
	elseif kind == "quest" then
		banner("QUEST COMPLETE!", tostring(a), GREEN1, GREEN2, 2, 24)
	elseif kind == "achievement" then
		banner("ACHIEVEMENT!", tostring(a), PURPLE1, PURPLE2, 3, 40)
	elseif kind == "flavor" then
		banner("NEW FLAVOR!", tostring(a), PINK1, PINK2, 1, 10)
	elseif kind == "announce" then
		banner("ANNOUNCEMENT", tostring(a), ORANGE1, ORANGE2, 2, 20)
	end
end)
print("[LickCelebrate] ready")
</ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBX30">
          <Properties>
            <string name="Name">LickRoll</string>
            <ProtectedString name="Source">-- LICK ROLL (LocalScript)  Location: StarterPlayer &gt; StarterPlayerScripts &gt; LickRoll
-- The skin ROLL animation and the reward REVEAL for every new cosmetic. The SERVER decides the reward and its odds;
-- this script only shows exactly what the server already granted. Tap anywhere to skip the animation.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local function errBanner(msg)
	local pg = player:WaitForChild("PlayerGui")
	if pg:FindFirstChild("LickError") then return end
	local g = Instance.new("ScreenGui")
	g.Name = "LickError"
	g.ResetOnSpawn = false
	g.DisplayOrder = 500
	g.Parent = pg
	local t = Instance.new("TextLabel")
	t.Size = UDim2.new(0.8, 0, 0.3, 0)
	t.Position = UDim2.new(0.1, 0, 0.35, 0)
	t.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextScaled = true
	t.TextWrapped = true
	t.Font = Enum.Font.FredokaOne
	t.Text = msg
	t.Parent = g
end
local remotes = ReplicatedStorage:WaitForChild("LickRemotes", 20)
if not remotes then
	errBanner("LICK ERROR: the LickData script is not running. It must be a Script in ServerScriptService. Check the Output window.")
	return
end
local sfxEv = ReplicatedStorage:WaitForChild("LickSfx", 20)
if not sfxEv then
	errBanner("LICK ERROR: the LickAudio LocalScript is missing (StarterPlayer &gt; StarterPlayerScripts).")
	return
end
local function sfx(key, speed, vol) sfxEv:Fire(key, speed, vol) end
local FONT = Enum.Font.FredokaOne
local WHITE = Color3.new(1, 1, 1)
local DARK = Color3.fromRGB(10, 10, 40)
local BLUE1, BLUE2 = Color3.fromRGB(60, 160, 255), Color3.fromRGB(20, 80, 200)
local GREEN1, GREEN2 = Color3.fromRGB(90, 230, 90), Color3.fromRGB(30, 150, 40)
local ORANGE1, ORANGE2 = Color3.fromRGB(255, 190, 60), Color3.fromRGB(230, 110, 20)
local PINK1, PINK2 = Color3.fromRGB(255, 110, 200), Color3.fromRGB(190, 40, 150)
local PURPLE1, PURPLE2 = Color3.fromRGB(170, 90, 255), Color3.fromRGB(90, 40, 200)
local RED1, RED2 = Color3.fromRGB(255, 90, 90), Color3.fromRGB(190, 30, 30)
local YELLOW1, YELLOW2 = Color3.fromRGB(255, 240, 100), Color3.fromRGB(240, 165, 20)
local CYAN1, CYAN2 = Color3.fromRGB(100, 255, 240), Color3.fromRGB(20, 160, 190)
local LIME1, LIME2 = Color3.fromRGB(180, 255, 100), Color3.fromRGB(60, 170, 40)
local function fmt(n)
	n = math.floor(n or 0)
	if n &lt; 1000 then return tostring(n) end
	local suf = { "K", "M", "B", "T", "Qa", "Qi" }
	local i, v = 0, n
	while v &gt;= 1000 and i &lt; #suf do
		v = v / 1000
		i = i + 1
	end
	if v &lt; 10 then return string.format("%.2f%s", v, suf[i]) end
	if v &lt; 100 then return string.format("%.1f%s", v, suf[i]) end
	return string.format("%.0f%s", v, suf[i])
end
local function corner(p, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 12)
	c.Parent = p
end
local function stroke(p, color, th)
	local s = Instance.new("UIStroke")
	s.Color = color or DARK
	s.Thickness = th or 3
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = p
end
local function gradient(p, c1, c2, rot)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(c1, c2)
	g.Rotation = rot or 90
	g.Parent = p
	return g
end
local shines = {}
local function gloss(f, r)
	local g = Instance.new("Frame")
	g.Size = UDim2.new(1, -8, 0.48, 0)
	g.Position = UDim2.new(0, 4, 0, 3)
	g.BackgroundColor3 = WHITE
	g.BorderSizePixel = 0
	g.Parent = f
	corner(g, r or 10)
	local gr = Instance.new("UIGradient")
	gr.Rotation = 90
	gr.Transparency = NumberSequence.new(0.35, 0.85)
	gr.Parent = g
	local dot = Instance.new("Frame")
	dot.Size = UDim2.new(0, 7, 0, 7)
	dot.Position = UDim2.new(0, 10, 0, 7)
	dot.BackgroundColor3 = WHITE
	dot.BackgroundTransparency = 0.15
	dot.BorderSizePixel = 0
	dot.Parent = f
	corner(dot, 4)
	local clip = Instance.new("Frame")
	clip.Size = UDim2.new(1, 0, 1, 0)
	clip.BackgroundTransparency = 1
	clip.ClipsDescendants = true
	clip.Parent = f
	local st = Instance.new("Frame")
	st.Size = UDim2.new(0.18, 0, 1.6, 0)
	st.Position = UDim2.new(-0.4, 0, -0.3, 0)
	st.Rotation = 20
	st.BackgroundColor3 = WHITE
	st.BackgroundTransparency = 0.7
	st.BorderSizePixel = 0
	st.Parent = clip
	shines[#shines + 1] = st
end
local function box(parent, size, pos, c1, c2, r, shiny)
	local f = Instance.new("Frame")
	f.Size = size
	f.Position = pos
	f.BackgroundColor3 = WHITE
	f.BorderSizePixel = 0
	f.Parent = parent
	corner(f, r or 12)
	stroke(f)
	gradient(f, c1, c2 or c1)
	if shiny then gloss(f, (r or 12) - 2) end
	return f
end
local function text(parent, str, size, pos, ts, color, ax)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = size
	l.Position = pos
	l.Font = FONT
	l.Text = str
	l.TextSize = ts
	l.TextColor3 = color or WHITE
	l.TextStrokeColor3 = DARK
	l.TextStrokeTransparency = 0
	l.TextXAlignment = ax or Enum.TextXAlignment.Center
	l.Parent = parent
	return l
end
local function bounce(sc, from)
	sc.Scale = from or 0.85
	TweenService:Create(sc, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end
local function popIn(obj)
	local sc = Instance.new("UIScale")
	sc.Scale = 0.6
	sc.Parent = obj
	TweenService:Create(sc, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end
local function button(parent, str, size, pos, c1, c2, ts, idle)
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Size = size
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.new(pos.X.Scale + size.X.Scale * 0.5, pos.X.Offset + size.X.Offset * 0.5, pos.Y.Scale + size.Y.Scale * 0.5, pos.Y.Offset + size.Y.Offset * 0.5)
	holder.Parent = parent
	local pop = Instance.new("UIScale")
	pop.Parent = holder
	local wrap = Instance.new("Frame")
	wrap.BackgroundTransparency = 1
	wrap.Size = UDim2.new(1, 0, 1, 0)
	wrap.Parent = holder
	if idle then
		local ps = Instance.new("UIScale")
		ps.Parent = wrap
		TweenService:Create(ps, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = 1.07 }):Play()
	end
	local vis = box(wrap, UDim2.new(1, 0, 1, 0), UDim2.new(0, 0, 0, 0), c1, c2, nil, true)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 1, 0)
	b.BackgroundTransparency = 1
	b.Font = FONT
	b.Text = str
	b.TextSize = ts or 22
	b.TextColor3 = WHITE
	b.TextStrokeColor3 = DARK
	b.TextStrokeTransparency = 0
	b.ZIndex = 2
	b.Parent = wrap
	b.Activated:Connect(function()
		sfx("click")
		bounce(pop, 0.85)
	end)
	return b, holder, vis
end
task.spawn(function()
	while true do
		task.wait(2.8)
		for i = #shines, 1, -1 do
			local s = shines[i]
			if not s:IsDescendantOf(game) then
				table.remove(shines, i)
			else
				task.delay(math.random() * 0.8, function()
					if s:IsDescendantOf(game) then
						s.Position = UDim2.new(-0.4, 0, -0.3, 0)
						TweenService:Create(s, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Position = UDim2.new(1.2, 0, -0.3, 0) }):Play()
					end
				end)
			end
		end
	end
end)

local root = player:WaitForChild("PlayerGui"):WaitForChild("LickUI"):WaitForChild("Root")
local oddsV = ReplicatedStorage:WaitForChild("LickSkinOdds")
local function quality() return player:GetAttribute("FxQuality") or 3 end

local RAR = {
	COMMON = { Color3.fromRGB(200, 205, 225), 10, 0.35 }, UNCOMMON = { Color3.fromRGB(110, 235, 120), 22, 0.5 },
	RARE = { Color3.fromRGB(80, 170, 255), 34, 0.8 }, EPIC = { Color3.fromRGB(190, 100, 255), 50, 1.1 },
	LEGENDARY = { Color3.fromRGB(255, 185, 40), 75, 1.5 }, MYTHICAL = { Color3.new(1, 1, 1), 110, 2.0 },
}
local COLS = { Color3.fromRGB(255, 90, 120), Color3.fromRGB(255, 225, 80), Color3.fromRGB(90, 220, 255), Color3.fromRGB(190, 110, 255), Color3.fromRGB(120, 255, 150), Color3.fromRGB(255, 160, 60) }

local function odds()
	local list = {}
	for id, name, rar, pct, hex in string.gmatch(oddsV.Value, "([^|;]+)|([^|;]+)|([^|;]+)|([^|;]+)|([^|;]+)") do
		list[#list + 1] = { id = id, name = name, rar = rar, pct = tonumber(pct) or 0, col = Color3.fromHex(hex) }
	end
	return list
end

local busy = false
local function sound(rar)
	if rar == "COMMON" then sfx("chime", 1, 0.8)
	elseif rar == "UNCOMMON" then sfx("chime", 1.15, 0.9) sfx("bell", 1.26, 0.7)
	elseif rar == "RARE" then
		for i, n in ipairs({ 1, 1.26, 1.5 }) do task.delay((i - 1) * 0.09, function() sfx("bell", n, 0.9) end) end
		task.delay(0.3, function() sfx("chime", 1.3, 1) end)
	elseif rar == "EPIC" then
		for i, n in ipairs({ 1, 1.26, 1.5, 2 }) do task.delay((i - 1) * 0.08, function() sfx("bell", n, 1) end) end
		task.delay(0.35, function() sfx("chime", 1.5, 1) sfx("goo", 1, 1) end)
	else
		local scale = { 1, 1.122, 1.26, 1.335, 1.498, 1.682, 1.888, 2 }
		for i, n in ipairs(scale) do task.delay((i - 1) * 0.07, function() sfx("bell", n, 1) end) end
		if rar == "MYTHICAL" then
			for i = 8, 1, -1 do task.delay(0.6 + (8 - i) * 0.07, function() sfx("bell", scale[i] * 1.5, 0.8) end) end
		end
		task.delay(0.6, function() sfx("chime", 1.5, 1) sfx("goo", 1.2, 1) end)
		task.delay(1.0, function() sfx("chime", 2, 1) end)
	end
end

local function confetti(parent, n)
	n = math.floor(n * quality() / 3)
	for i = 1, n do
		local c = Instance.new("Frame")
		local sz = math.random(8, 18)
		c.Size = UDim2.new(0, sz, 0, sz * 0.6)
		c.AnchorPoint = Vector2.new(0.5, 0.5)
		c.Position = UDim2.new(0.5, 0, 0.45, 0)
		c.Rotation = math.random(0, 360)
		c.BackgroundColor3 = COLS[math.random(#COLS)]
		c.BorderSizePixel = 0
		c.ZIndex = 58
		c.Parent = parent
		local a = math.random() * math.pi * 2
		local d = 120 + math.random() * 380
		local tw = TweenService:Create(c, TweenInfo.new(0.9 + math.random() * 0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, math.cos(a) * d, 0.45, math.sin(a) * d * 0.7 + 90), Rotation = c.Rotation + math.random(-500, 500), BackgroundTransparency = 1 })
		task.delay(i * 0.008, function() tw:Play() end)
		tw.Completed:Connect(function() c:Destroy() end)
	end
end

local function shake(amount, dur)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not hum or quality() &lt; 2 then return end
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 &lt; dur do
			local k = 1 - (os.clock() - t0) / dur
			hum.CameraOffset = Vector3.new((math.random() - 0.5) * amount * k, (math.random() - 0.5) * amount * k, 0)
			RunService.Heartbeat:Wait()
		end
		hum.CameraOffset = Vector3.new(0, 0, 0)
	end)
end

-- final result card (used by the roll and by every cosmetic reward)
local function showResult(bd, r)
	local info = RAR[r.rar] or RAR.COMMON
	local col = info[1]
	local card = box(bd, UDim2.new(0, 300, 0, 330), UDim2.new(0.5, 0, 0.5, 0), col:Lerp(WHITE, 0.15), col:Lerp(DARK, 0.5), 22, true)
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.ZIndex = 56
	popIn(card)
	local glow = card:FindFirstChildOfClass("UIStroke")
	glow.Thickness = 6
	glow.Color = col
	local swatch = box(card, UDim2.new(0, 130, 0, 130), UDim2.new(0.5, -65, 0, 36), r.swatch or col, (r.swatch or col):Lerp(DARK, 0.3), 65, true)
	swatch.ZIndex = 57
	local rl = text(card, r.rar, UDim2.new(1, 0, 0, 34), UDim2.new(0, 0, 0, 4), 26, col)
	rl.ZIndex = 58
	local nl = text(card, r.name, UDim2.new(1, -20, 0, 46), UDim2.new(0, 10, 0, 176), 34)
	nl.TextScaled = true
	nl.ZIndex = 58
	local cl = text(card, r.pct and ("Chance: " .. r.pct .. "%") or (r.slot and ("New " .. r.slot .. "!") or ""), UDim2.new(1, 0, 0, 24), UDim2.new(0, 0, 0, 226), 18)
	cl.ZIndex = 58
	if r.isNew then
		local n = text(card, "NEW!", UDim2.new(0, 80, 0, 28), UDim2.new(1, -80, 0, -8), 22, Color3.fromRGB(255, 240, 80))
		n.ZIndex = 59
		n.Rotation = 12
	end
	local ok = button(card, "COLLECT", UDim2.new(0, 200, 0, 46), UDim2.new(0.5, -100, 1, -64), GREEN1, GREEN2, 22)
	ok.ZIndex = 59
	ok.Activated:Connect(function() bd:Destroy() busy = false end)
	-- light rays behind the card for epic and above
	if info[2] &gt;= 50 and quality() &gt;= 2 then
		for i = 1, 8 do
			local ray = Instance.new("Frame")
			ray.AnchorPoint = Vector2.new(0.5, 0.5)
			ray.Position = UDim2.new(0.5, 0, 0.5, 0)
			ray.Size = UDim2.new(0, 36, 0, 700)
			ray.Rotation = i * 22.5
			ray.BackgroundColor3 = col
			ray.BackgroundTransparency = 0.8
			ray.BorderSizePixel = 0
			ray.ZIndex = 54
			ray.Parent = bd
		end
		task.spawn(function()
			while bd.Parent do
				for _, c in ipairs(bd:GetChildren()) do
					if c:IsA("Frame") and c.ZIndex == 54 then c.Rotation = c.Rotation + 0.6 end
				end
				if r.rar == "MYTHICAL" then
					local h = (os.clock() * 0.5) % 1
					glow.Color = Color3.fromHSV(h, 0.7, 1)
					for _, c in ipairs(bd:GetChildren()) do
						if c:IsA("Frame") and c.ZIndex == 54 then c.BackgroundColor3 = Color3.fromHSV((h + c.Rotation / 360) % 1, 0.7, 1) end
					end
				end
				RunService.RenderStepped:Wait()
			end
		end)
	end
	local fl = Instance.new("Frame")
	fl.Size = UDim2.new(1, 0, 1, 0)
	fl.BackgroundColor3 = r.rar == "MYTHICAL" and WHITE or col
	fl.BackgroundTransparency = 0.25
	fl.BorderSizePixel = 0
	fl.ZIndex = 60
	fl.Parent = bd
	TweenService:Create(fl, TweenInfo.new(0.7), { BackgroundTransparency = 1 }):Play()
	task.delay(0.7, function() fl:Destroy() end)
	confetti(bd, info[2])
	sound(r.rar)
	if info[2] &gt;= 75 then shake(info[2] &gt;= 110 and 1.2 or 0.7, 0.6) end
end

local function newBackdrop()
	local old = root:FindFirstChild("LickRoll")
	if old then old:Destroy() end
	local bd = Instance.new("TextButton")
	bd.Name = "LickRoll"
	bd.Size = UDim2.new(1, 0, 1, 0)
	bd.BackgroundColor3 = Color3.fromRGB(8, 4, 30)
	bd.BackgroundTransparency = 1
	bd.Text = ""
	bd.AutoButtonColor = false
	bd.ZIndex = 50
	bd.Parent = root
	TweenService:Create(bd, TweenInfo.new(0.3), { BackgroundTransparency = 0.25 }):Play()
	return bd
end

local function runRoll(win)
	local list = odds()
	if #list == 0 then return end
	local bd = newBackdrop()
	local VIEW, STRIDE, N, WIN = 480, 118, 46, 38
	local title = text(bd, "ROLLING...", UDim2.new(1, 0, 0, 40), UDim2.new(0, 0, 0.18, 0), 34, YELLOW1)
	title.ZIndex = 52
	local view = box(bd, UDim2.new(0, VIEW, 0, 134), UDim2.new(0.5, -VIEW / 2, 0.5, -67), Color3.fromRGB(30, 20, 80), Color3.fromRGB(12, 8, 45), 16)
	view.ClipsDescendants = true
	view.ZIndex = 52
	local strip = Instance.new("Frame")
	strip.BackgroundTransparency = 1
	strip.Size = UDim2.new(0, N * STRIDE, 1, 0)
	strip.ZIndex = 53
	strip.Parent = view
	local function pick()
		local t = math.random() * 100
		for _, it in ipairs(list) do
			t = t - it.pct
			if t &lt;= 0 then return it end
		end
		return list[1]
	end
	local winItem
	for _, it in ipairs(list) do if it.id == win.id then winItem = it end end
	winItem = winItem or list[1]
	for i = 1, N do
		local it = i == WIN and winItem or pick()
		local c = RAR[it.rar] or RAR.COMMON
		local f = box(strip, UDim2.new(0, STRIDE - 10, 0, 110), UDim2.new(0, (i - 1) * STRIDE + 5, 0, 12), it.col:Lerp(WHITE, 0.2), it.col:Lerp(DARK, 0.45), 14, true)
		f.ZIndex = 54
		f:FindFirstChildOfClass("UIStroke").Color = it.rar == "MYTHICAL" and WHITE or c[1]
		local nm = text(f, it.name, UDim2.new(1, -6, 0, 24), UDim2.new(0, 3, 1, -28), 14)
		nm.TextScaled = true
		nm.ZIndex = 56
	end
	local mk = text(bd, "v", UDim2.new(0, 50, 0, 30), UDim2.new(0.5, -25, 0.5, -102), 34, WHITE)
	mk.ZIndex = 57
	local mk2 = text(bd, "^", UDim2.new(0, 50, 0, 30), UDim2.new(0.5, -25, 0.5, 70), 34, WHITE)
	mk2.ZIndex = 57
	local skip = false
	bd.Activated:Connect(function() skip = true end)
	local x0 = VIEW / 2 - STRIDE / 2
	local S = (WIN - 1) * STRIDE
	local rar = RAR[win.rar] or RAR.COMMON
	local T = 4.3 + rar[3] * 0.8
	local t0, lastIdx = os.clock(), 0
	while not skip do
		local k = (os.clock() - t0) / T
		if k &gt;= 1 then break end
		local e = 1 - (1 - k) ^ 4
		local pos = S * e
		strip.Position = UDim2.new(0, x0 - pos, 0, 0)
		local idx = math.floor(pos / STRIDE)
		if idx &gt; lastIdx then
			lastIdx = idx
			sfx("click", 0.85 + 0.6 * k, 0.45)
		end
		RunService.RenderStepped:Wait()
	end
	strip.Position = UDim2.new(0, x0 - S, 0, 0)
	if not skip then
		-- the last moments: a held breath before the reveal (it stops exactly on the real result)
		title.Text = "..."
		local hold = rar[3]
		local t1 = os.clock()
		local beat = 0
		while os.clock() - t1 &lt; hold and not skip do
			beat = beat + 1
			sfx("bell", 0.5 + beat * 0.04, 0.35 + beat * 0.06)
			local sc = mk:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", mk)
			bounce(sc, 1.4)
			task.wait(math.max(0.18, hold / 4))
		end
	end
	view:Destroy()
	mk:Destroy()
	mk2:Destroy()
	title:Destroy()
	showResult(bd, { rar = win.rar, name = win.name, pct = win.pct, isNew = win.isNew, swatch = winItem.col })
end

remotes.Reveal.OnClientEvent:Connect(function(kind, id, rar, name, a, b)
	if kind == "roll" then
		if busy then return end
		busy = true
		runRoll({ id = id, rar = rar, name = name, pct = a, isNew = b })
	elseif kind == "cosmetic" then
		task.spawn(function()
			while busy do task.wait(0.5) end
			busy = true
			local bd = newBackdrop()
			local t = text(bd, "NEW REWARD!", UDim2.new(1, 0, 0, 44), UDim2.new(0, 0, 0.2, 0), 38, YELLOW1)
			t.ZIndex = 52
			local skip = false
			bd.Activated:Connect(function() skip = true end)
			local t0 = os.clock()
			while os.clock() - t0 &lt; (RAR[rar] or RAR.COMMON)[3] + 0.5 and not skip do
				sfx("bell", 0.6 + (os.clock() - t0) * 0.4, 0.4)
				task.wait(0.2)
			end
			t:Destroy()
			showResult(bd, { rar = rar, name = name, slot = a })
		end)
	end
end)
print("[LickRoll] ready")
</ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBX31">
          <Properties>
            <string name="Name">LickPanels</string>
            <ProtectedString name="Source">-- LICK PANELS (LocalScript)  Location: StarterPlayer &gt; StarterPlayerScripts &gt; LickPanels
-- Shop (upgrades + skin roll + odds), Rebirth and Daily login panels.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local function errBanner(msg)
	local pg = player:WaitForChild("PlayerGui")
	if pg:FindFirstChild("LickError") then return end
	local g = Instance.new("ScreenGui")
	g.Name = "LickError"
	g.ResetOnSpawn = false
	g.DisplayOrder = 500
	g.Parent = pg
	local t = Instance.new("TextLabel")
	t.Size = UDim2.new(0.8, 0, 0.3, 0)
	t.Position = UDim2.new(0.1, 0, 0.35, 0)
	t.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextScaled = true
	t.TextWrapped = true
	t.Font = Enum.Font.FredokaOne
	t.Text = msg
	t.Parent = g
end
