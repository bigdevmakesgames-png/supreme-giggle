local CFGF = ReplicatedStorage:WaitForChild("LickConfig")
local function csv(name)
	local t = {}
	for n in string.gmatch(CFGF:WaitForChild(name).Value, "[^,]+") do t[#t + 1] = tonumber(n) end
	return t
end
local COSTS, ZL, ZV = csv("LevelCosts"), csv("ZoneLevels"), csv("ZoneValues")
local ZN, WN = {}, {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
for n in string.gmatch(CFGF:WaitForChild("WorldNames").Value, "[^|]+") do WN[#WN + 1] = n end
local NW = #WN
local ZN = {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
local MAXLV = CFGF:GetAttribute("MaxLevel") or 400
local LPM = CFGF:GetAttribute("LPM") or 150
local function zoneOf(level)
	local z = 1
	for i = 1, #ZL do
		if level &gt;= ZL[i] then z = i end
	end
	return z
end
local function worldOf(x) return math.clamp(math.floor((x + 1000) / 2000) + 1, 1, NW) end
local function zoneAt(x, z)
	local w = worldOf(x)
	local col = math.clamp(math.floor((x - (w - 1) * 2000 + 640) / 320), 0, 3)
	local k = 8 - col
	if z &lt; 0 then k = col + 1 end
	return (w - 1) * 8 + k
end

local HttpService = game:GetService("HttpService")
local root = getRoot()
local menuEv = ReplicatedStorage:WaitForChild("LickMenu")
local sf = player:WaitForChild("LickState")
local FOODS = { "Sad Donut", "Ice Cream Cone", "Cherry Cupcake", "Rainbow Lollipop", "Gumball Machine", "Golden Cake", "Galaxy Jelly", "Mythic Burger", "Pizza Slice", "Crunchy Taco", "Golden Fries", "Hot Dog", "Popcorn Bucket", "Boba Tea", "Sushi Platter", "Mega Feast" }
local awards = {}
pcall(function() awards = HttpService:JSONDecode(ReplicatedStorage.LickConfig:WaitForChild("Awards").Value) end)
local function jd(name)
	local v = sf:FindFirstChild(name)
	local ok, t = pcall(function() return HttpService:JSONDecode(v and v.Value or "{}") end)
	return ok and type(t) == "table" and t or {}
end

local TABS = { { "d", "Daily" }, { "w", "Weekly" }, { "l", "Life" }, { "z", "Zones" }, { "e", "Event" }, { "a", "Awards" }, { "i", "Index" } }
local tab, page, PER, live = "d", 1, 5, {}

local function entries()
	local out = {}
	local q, a, idx = jd("Quests"), jd("Achv"), jd("Index")
	if tab == "a" then
		for _, e in ipairs(awards) do
			local n = a.n and a.n[e[3]] or 0
			local done = a.done and a.done[e[1]]
			out[#out + 1] = { title = e[2], n = math.min(n, e[4]), target = e[4], status = done and "DONE" or nil }
		end
	elseif tab == "i" then
		for _, f in ipairs(FOODS) do
			local c = idx[f]
			out[#out + 1] = { title = f, n = c or 0, target = 1000, sub = c == nil and "Not discovered yet" or ("Finished " .. c .. "x"), food = f, count = c or 0, claimed = q.i or {} }
		end
	else
		local c = q[tab]
		local list = c and c.list or {}
		local az = player:GetAttribute("BestZone") or 1
		for i, e in ipairs(list) do
			out[#out + 1] = { title = e.desc, n = e.n, target = e.target, claimed = e.claimed, id = tab .. i, locked = e.zone and e.zone &gt; az, sub = e.zone and (e.zone &gt; az and "Locked zone" or nil) }
		end
	end
	return out
end

local function build()
	local panel = modal(root, "QUESTS &amp; AWARDS", 700, 470, BLUE1, BLUE2)
	for i, t in ipairs(TABS) do
		local b = button(panel, t[2], UDim2.new(0, 88, 0, 34), UDim2.new(0, 10 + (i - 1) * 96, 0, 54), tab == t[1] and YELLOW1 or Color3.fromRGB(120, 130, 210), tab == t[1] and YELLOW2 or Color3.fromRGB(60, 65, 140), 16)
		b.Activated:Connect(function() tab = t[1] page = 1 build() end)
	end
	live = {}
	local list = entries()
	local pages = math.max(1, math.ceil(#list / PER))
	page = math.min(page, pages)
	if tab == "e" and #list == 0 then text(panel, "No event is running right now. Check back soon!", UDim2.new(1, 0, 0, 40), UDim2.new(0, 0, 0, 200), 22) end
	for i = 1, PER do
		local e = list[(page - 1) * PER + i]
		if e then
			local row = box(panel, UDim2.new(1, -24, 0, 62), UDim2.new(0, 12, 0, 100 + (i - 1) * 68), e.locked and Color3.fromRGB(130, 130, 160) or GREEN1:Lerp(BLUE1, 0.5), e.locked and Color3.fromRGB(70, 70, 100) or GREEN2:Lerp(BLUE2, 0.5), 10, true)
			text(row, e.title, UDim2.new(1, -200, 0, 24), UDim2.new(0, 10, 0, 4), 18, WHITE, Enum.TextXAlignment.Left).TextScaled = true
			local bg = box(row, UDim2.new(1, -210, 0, 16), UDim2.new(0, 10, 0, 34), Color3.fromRGB(25, 15, 70), Color3.fromRGB(25, 15, 70), 8)
			local fill = box(bg, UDim2.new(math.clamp(e.n / math.max(e.target, 1), 0, 1), 0, 1, 0), UDim2.new(0, 0, 0, 0), LIME1, LIME2, 8)
			text(bg, e.sub or (fmt(e.n) .. " / " .. fmt(e.target)), UDim2.new(1, 0, 1, 0), UDim2.new(0, 0, 0, 0), 12)
			if e.food then
				for r = 1, 3 do
					local need = ({ 10, 100, 1000 })[r]
					local done = e.claimed[e.food .. r]
					local can = e.count &gt;= need and not done
					local cb = button(row, done and "OK" or tostring(need), UDim2.new(0, 56, 0, 44), UDim2.new(1, -190 + (r - 1) * 60, 0, 9), can and GREEN1 or Color3.fromRGB(130, 130, 160), can and GREEN2 or Color3.fromRGB(70, 70, 100), 16)
					cb.Activated:Connect(function() if can then remotes.QuestClaim:FireServer("i:" .. e.food .. ":" .. r) task.delay(0.6, build) end end)
				end
			elseif e.id then
				local can = e.n &gt;= e.target and not e.claimed
				local cb = button(row, e.claimed and "CLAIMED" or "CLAIM", UDim2.new(0, 120, 0, 44), UDim2.new(1, -132, 0, 9), can and GREEN1 or Color3.fromRGB(130, 130, 160), can and GREEN2 or Color3.fromRGB(70, 70, 100), 18)
				cb.Activated:Connect(function() if can then remotes.QuestClaim:FireServer(e.id) task.delay(0.6, build) end end)
			else
				text(row, e.status or "", UDim2.new(0, 110, 1, 0), UDim2.new(1, -120, 0, 0), 20, YELLOW1)
			end
		end
	end
	if tab == "i" then
		local all = button(panel, "FOOD INDEX COMPLETE BONUS", UDim2.new(0, 300, 0, 36), UDim2.new(0.5, -150, 1, -46), PINK1, PINK2, 15)
		all.Activated:Connect(function() remotes.QuestClaim:FireServer("i:all") end)
	else
		local prev = button(panel, "&lt;", UDim2.new(0, 70, 0, 36), UDim2.new(0, 20, 1, -46), BLUE1, BLUE2, 22)
		prev.Activated:Connect(function() page = (page - 2) % pages + 1 build() end)
		local nx = button(panel, "&gt;", UDim2.new(0, 70, 0, 36), UDim2.new(1, -90, 1, -46), BLUE1, BLUE2, 22)
		nx.Activated:Connect(function() page = page % pages + 1 build() end)
		text(panel, "Page " .. page .. "/" .. pages, UDim2.new(0, 120, 0, 30), UDim2.new(0.5, -60, 1, -42), 16)
	end
end
menuEv.Event:Connect(function(name) if name == "quests" then build() end end)
print("[LickQuestUI] ready")
