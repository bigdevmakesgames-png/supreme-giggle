	local xb = button(head, "X", UDim2.new(0, 36, 0, 34), UDim2.new(1, -44, 0, 7), RED1, RED2, 20)
	xb.Activated:Connect(function() bd:Destroy() end)
	sfx("menu")
	return panel, bd
end

local MarketplaceService = game:GetService("MarketplaceService")
local HttpService = game:GetService("HttpService")
local root = getRoot()
local menuEv = ReplicatedStorage:WaitForChild("LickMenu")
local cfg = ReplicatedStorage:WaitForChild("LickConfig")
local prices = HttpService:JSONDecode(cfg:WaitForChild("Passes").Value)

local INFO = {
	{ "X2Goo", "x2 Goo", "Double goo from every lick" }, { "X3Goo", "x3 Goo", "Triple goo (replaces x2)" }, { "AutoLick", "Auto Lick", "Licks nearby food for you" },
	{ "FastLick", "Fast Lick", "Lick twice as fast" }, { "MegaReach", "Mega Reach", "+15 tongue reach" }, { "SuperSpeed", "Super Speed", "+8 walk speed" },
	{ "LuckyLicks", "Lucky Licks", "+10% double-goo chance" }, { "VIP", "VIP Mouth", "x1.25 goo, VIP tag, gold tongue" }, { "AutoUpgrade", "Auto Upgrade", "Buys levels for you" },
	{ "SuperRebirth", "Super Rebirth", "Rebirths give +100% goo" }, { "GiftBoost", "Gift Boost", "Free gift every 60s, gifts x2" }, { "RainbowTongue", "Rainbow Tongue", "A color-cycling tongue" },
	{ "GalaxyTongue", "Galaxy Tongue", "A sparkly galaxy tongue" }, { "Teleporter", "Zone Teleporter", "Teleport to unlocked zones" }, { "StarterPack", "Starter Pack", "One-time bundle: goo, boost, rolls" },
}
local PRODUCTS = {
	{ 3730209921, "Goo Pack 1", "15 minutes of goo income" }, { 3730210052, "Goo Pack 2", "1 hour of goo income" }, { 3730210119, "Goo Pack 3", "3 hours of goo income" },
	{ 3730210205, "Goo Pack 4", "10 hours of goo income" }, { 3730210305, "x2 Goo Boost", "15 minutes of double goo" },
}
local items = {}
for _, p in ipairs(INFO) do items[#items + 1] = { "pass", p[1], p[2], p[3] } end
for _, p in ipairs(PRODUCTS) do items[#items + 1] = { "product", p[1], p[2], p[3] } end
local robuxOf = {}
task.spawn(function()
	for _, p in ipairs(PRODUCTS) do
		local ok, info = pcall(function() return MarketplaceService:GetProductInfo(p[1], Enum.InfoType.Product) end)
		if ok and info then robuxOf[p[1]] = info.PriceInRobux end
	end
end)

local PER, page, live = 4, 1, {}
local function owned(name) return player:GetAttribute("Pass_" .. name) == true, player:GetAttribute("GooPass_" .. name) == true end

local function open(p)
	page = p
	local pages = math.ceil(#items / PER)
	local panel = modal(root, "PASSES &amp; PACKS  " .. page .. "/" .. pages, 660, 460, YELLOW1, YELLOW2)
	live = {}
	for i = 1, PER do
		local it = items[(page - 1) * PER + i]
		if it then
			local row = box(panel, UDim2.new(1, -24, 0, 74), UDim2.new(0, 12, 0, 58 + (i - 1) * 80), it[1] == "pass" and ORANGE1 or CYAN1, it[1] == "pass" and ORANGE2 or CYAN2, 12, true)
			text(row, it[3], UDim2.new(0, 250, 0, 28), UDim2.new(0, 12, 0, 6), 24, WHITE, Enum.TextXAlignment.Left)
			text(row, it[4], UDim2.new(0, 250, 0, 34), UDim2.new(0, 12, 0, 34), 14, YELLOW1, Enum.TextXAlignment.Left).TextWrapped = true
			local rb = button(row, "", UDim2.new(0, 150, 0, 50), UDim2.new(1, -330, 0, 12), GREEN1, GREEN2, 17)
			local gb = it[1] == "pass" and button(row, "", UDim2.new(0, 160, 0, 50), UDim2.new(1, -170, 0, 12), PURPLE1, PURPLE2, 16) or nil
			local armed = false
			rb.Activated:Connect(function()
				if it[1] == "pass" then
					local r, g = owned(it[2])
					if not r and not g then MarketplaceService:PromptGamePassPurchase(player, prices[it[2]][1]) end
				else
					MarketplaceService:PromptProductPurchase(player, it[2])
				end
			end)
			if gb then
				gb.Activated:Connect(function()
					local r, g = owned(it[2])
					if r or g then return end
					if not armed then
						armed = true
						gb.Text = "TAP TO CONFIRM"
						task.delay(3, function() armed = false end)
					else
						armed = false
						local ok, msg = remotes.BuyGooPass:InvokeServer(it[2])
						gb.Text = ok and "UNLOCKED" or tostring(msg)
					end
				end)
			end
			live[#live + 1] = { it, rb, gb }
		end
	end
	local prev = button(panel, "&lt; PREV", UDim2.new(0, 130, 0, 44), UDim2.new(0, 20, 1, -56), BLUE1, BLUE2, 20)
	prev.Activated:Connect(function() open((page - 2) % pages + 1) end)
	local nxt = button(panel, "NEXT &gt;", UDim2.new(0, 130, 0, 44), UDim2.new(1, -150, 1, -56), BLUE1, BLUE2, 20)
	nxt.Activated:Connect(function() open(page % pages + 1) end)
	text(panel, "Goo unlocks are separate in-game unlocks. Robux buys the real Roblox pass.", UDim2.new(0, 330, 0, 36), UDim2.new(0.5, -165, 1, -58), 12).TextWrapped = true
end

task.spawn(function()
	while true do
		task.wait(0.5)
		for _, l in ipairs(live) do
			local it, rb, gb = l[1], l[2], l[3]
			if rb.Parent then
				if it[1] == "pass" then
					local r, g = owned(it[2])
					local pr = prices[it[2]]
					rb.Text = r and "OWNED" or (g and "OWNED (Goo)" or ("R$ " .. pr[2]))
					if gb and gb.Text ~= "TAP TO CONFIRM" and gb.Text ~= "UNLOCKED" and not gb.Text:find("goo") then
						gb.Text = g and "OWNED (Goo)" or (r and "OWNED" or ("G " .. fmt(pr[3])))
					end
				else
					rb.Text = robuxOf[it[2]] and ("R$ " .. robuxOf[it[2]]) or "BUY"
				end
			end
		end
	end
end)
menuEv.Event:Connect(function(name) if name == "passes" then open(1) end end)
print("[LickPassUI] ready")
