local bodyL = text(card, "", UDim2.new(1, -20, 0, 50), UDim2.new(0, 10, 0, 58), 16, WHITE, Enum.TextXAlignment.Left)
bodyL.TextWrapped = true
bodyL.TextYAlignment = Enum.TextYAlignment.Top
