local anchorPart = Instance.new("Part")
anchorPart.Anchored, anchorPart.CanCollide, anchorPart.CanQuery, anchorPart.CanTouch, anchorPart.Transparency = true, false, false, false, 1
anchorPart.Size = Vector3.new(1, 1, 1)
anchorPart.Parent = gfx
bb.Adornee = anchorPart

local target = nil -- Vector3 the arrows point to
local function hide3d()
	target = nil
	hl.Enabled = false
	hl.Adornee = nil
	bb.Enabled = false
	beacon.Transparency = 1
	for _, pair in ipairs(chev) do pair[1].Transparency, pair[2].Transparency = 1, 1 end
end
local function setModel(m)
	if not m then hide3d() return end
	local c = m:GetAttribute("Center") or m:GetPivot().Position
	target = Vector3.new(c.X, 0, c.Z)
	hl.Adornee = m
	hl.Enabled = true
	anchorPart.Position = c + Vector3.new(0, (m:GetAttribute("Radius") or 3) + 5, 0)
	bb.Enabled = true
	beacon.CFrame = CFrame.new(c.X, 35, c.Z) * CFrame.Angles(0, 0, math.rad(90))
	beacon.Transparency = 0.7
end
local function setPos(v)
	target = Vector3.new(v.X, 0, v.Z)
	hl.Enabled = false
	anchorPart.Position = v + Vector3.new(0, 14, 0)
	bb.Enabled = true
	beacon.CFrame = CFrame.new(v.X, 35, v.Z) * CFrame.Angles(0, 0, math.rad(90))
	beacon.Transparency = 0.7
end

RunService.RenderStepped:Connect(function()
	local t = os.clock()
	if bb.Enabled then
		bb.StudsOffset = Vector3.new(0, math.sin(t * 4) * 1.2, 0)
	end
	if beacon.Transparency &lt; 1 then beacon.Transparency = 0.65 + 0.12 * math.sin(t * 3) end
	local p = myPos()
	if not target or not p then return end
	local from = Vector3.new(p.X, p.Y - 2.8, p.Z)
	local flat = Vector3.new(target.X - from.X, 0, target.Z - from.Z)
	local dist = flat.Magnitude
	if dist &lt; 9 then
		for _, pair in ipairs(chev) do pair[1].Transparency, pair[2].Transparency = 1, 1 end
		return
	end
	local dir = flat.Unit
	local flow = (t * 9) % 5
	for i, pair in ipairs(chev) do
		local d = 5 + (i - 1) * 5 + flow
		if d &lt; dist - 4 and d &lt; 90 then
			local pos = from + dir * d
			local base = CFrame.lookAt(pos, pos + dir)
			local fade = math.clamp(1 - d / 90, 0.1, 1)
			pair[1].CFrame = base * CFrame.new(-0.95, 0, 0.55) * CFrame.Angles(0, math.rad(40), 0)
			pair[2].CFrame = base * CFrame.new(0.95, 0, 0.55) * CFrame.Angles(0, math.rad(-40), 0)
			pair[1].Transparency, pair[2].Transparency = 1 - fade * 0.9, 1 - fade * 0.9
		else
			pair[1].Transparency, pair[2].Transparency = 1, 1
		end
	end
end)

local pointer
local function clearPointer()
	if pointer then pointer:Destroy() pointer = nil end
end
local function pointAt(name)
	clearPointer()
	local h = root:FindFirstChild(name, true)
	if not h then return end
	pointer = Instance.new("Frame")
	pointer.BackgroundTransparency = 1
	pointer.Size = UDim2.new(1.3, 0, 1.3, 0)
	pointer.Position = UDim2.new(-0.15, 0, -0.15, 0)
	pointer.ZIndex = 25
	pointer.Parent = h
	corner(pointer, 24)
	local s = Instance.new("UIStroke")
	s.Color = Color3.fromRGB(255, 235, 60)
	s.Thickness = 6
	s.Parent = pointer
	TweenService:Create(s, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Thickness = 2 }):Play()
	local a = text(pointer, "v", UDim2.new(0, 44, 0, 40), UDim2.new(0.5, -22, 0, -46), 40, Color3.fromRGB(255, 235, 60))
	a.ZIndex = 26
end

