			local s = shines[i]
			if not s:IsDescendantOf(game) then
				table.remove(shines, i)
			else
				task.delay(math.random() * 0.8, function()
					if s:IsDescendantOf(game) then
						s.Position = UDim2.new(-0.4, 0, -0.3, 0)
						TweenService:Create(s, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Position = UDim2.new(1.2, 0, -0.3, 0) }):Play()
					end
				end)
			end
		end
	end
end)
local function getRoot()
	return player:WaitForChild("PlayerGui"):WaitForChild("LickUI"):WaitForChild("Root")
end
local function modal(root, titleStr, w, h, c1, c2)
	local old = root:FindFirstChild("LickModal")
	if old then old:Destroy() end
	local bd = Instance.new("TextButton")
	bd.Name = "LickModal"
	bd.Size = UDim2.new(1, 0, 1, 0)
	bd.BackgroundColor3 = Color3.new(0, 0, 0)
	bd.BackgroundTransparency = 0.5
	bd.Text = ""
	bd.AutoButtonColor = false
	bd.ZIndex = 10
	bd.Parent = root
	bd.Activated:Connect(function() bd:Destroy() end)
	local panel = box(bd, UDim2.new(0, w, 0, h), UDim2.new(0.5, 0, 0.5, 0), Color3.fromRGB(70, 100, 230), Color3.fromRGB(30, 40, 130), 16)
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Active = true
	popIn(panel)
	local head = box(panel, UDim2.new(1, 0, 0, 48), UDim2.new(0, 0, 0, 0), c1 or YELLOW1, c2 or YELLOW2, 16, true)
	text(head, titleStr, UDim2.new(1, -70, 1, 0), UDim2.new(0, 16, 0, 0), 28, WHITE, Enum.TextXAlignment.Left)
	local xb = button(head, "X", UDim2.new(0, 36, 0, 34), UDim2.new(1, -44, 0, 7), RED1, RED2, 20)
	xb.Activated:Connect(function() bd:Destroy() end)
	sfx("menu")
	return panel, bd
end

local CFGF = ReplicatedStorage:WaitForChild("LickConfig")
local function csv(name)
	local t = {}
	for n in string.gmatch(CFGF:WaitForChild(name).Value, "[^,]+") do t[#t + 1] = tonumber(n) end
	return t
end
local COSTS, ZL, ZV = csv("LevelCosts"), csv("ZoneLevels"), csv("ZoneValues")
local ZN, WN = {}, {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
for n in string.gmatch(CFGF:WaitForChild("WorldNames").Value, "[^|]+") do WN[#WN + 1] = n end
local NW = #WN
local ZN = {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
local MAXLV = CFGF:GetAttribute("MaxLevel") or 400
local LPM = CFGF:GetAttribute("LPM") or 150
local function zoneOf(level)
	local z = 1
	for i = 1, #ZL do
		if level &gt;= ZL[i] then z = i end
	end
	return z
end
local function worldOf(x) return math.clamp(math.floor((x + 1000) / 2000) + 1, 1, NW) end
local function zoneAt(x, z)
	local w = worldOf(x)
	local col = math.clamp(math.floor((x - (w - 1) * 2000 + 640) / 320), 0, 3)
	local k = 8 - col
	if z &lt; 0 then k = col + 1 end
	return (w - 1) * 8 + k
end

local root = getRoot()
local menuEv = ReplicatedStorage:WaitForChild("LickMenu")
local sf = player:WaitForChild("LickState")
local stats = player:WaitForChild("leaderstats")
local live = {}

local function rows(panel, defs, y0)
	live = {}
	for i, d in ipairs(defs) do
		local y = y0 + (i - 1) * 70
		local row = box(panel, UDim2.new(1, -24, 0, 62), UDim2.new(0, 12, 0, y), d.c1, d.c2, 10, true)
		text(row, d.icon, UDim2.new(0, 56, 1, 0), UDim2.new(0, 6, 0, 0), 34)
		text(row, d.title, UDim2.new(1, -230, 0, 26), UDim2.new(0, 66, 0, 5), 22, YELLOW1, Enum.TextXAlignment.Left)
		local desc = text(row, d.desc(), UDim2.new(1, -230, 0, 20), UDim2.new(0, 66, 0, 34), 14, WHITE, Enum.TextXAlignment.Left)
		local buy = button(row, d.cost(), UDim2.new(0, 140, 0, 44), UDim2.new(1, -152, 0, 9), GREEN1, GREEN2, 20)
		buy.Activated:Connect(d.buy)
		live[#live + 1] = { desc, buy, d }
	end
end
task.spawn(function()
	while true do
		task.wait(0.4)
		for _, l in ipairs(live) do
			if l[1].Parent then
				l[1].Text = l[3].desc()
				l[2].Text = l[3].cost()
			end
		end
	end
end)

local function upRow(icon, title, attr, key, blurb, c1, c2)
	return { icon = icon, title = title, c1 = c1, c2 = c2,
		desc = function() return blurb .. "  Lv " .. (player:GetAttribute(attr .. "Lvl") or 0) .. "/" .. (player:GetAttribute("UpgradeCap") or 10) end,
		cost = function()
			if (player:GetAttribute(attr .. "Lvl") or 0) &gt;= (player:GetAttribute("UpgradeCap") or 10) then return "MAX" end
			return "G " .. fmt(player:GetAttribute(attr .. "Cost") or 0)
		end,
		buy = function() remotes.BuyUpgrade:FireServer(key) end }
end

local function openOdds()
	local panel = modal(root, "SKIN ODDS", 560, 470, BLUE1, BLUE2)
	text(panel, "Every roll is random. Your exact chance to get:", UDim2.new(1, -20, 0, 22), UDim2.new(0, 10, 0, 54), 16)
	local i = 0
	for id, name, rar, pct, hex in string.gmatch(ReplicatedStorage:WaitForChild("LickSkinOdds").Value, "([^|;]+)|([^|;]+)|([^|;]+)|([^|;]+)|([^|;]+)") do
		i = i + 1
		local col, row = (i - 1) % 2, math.floor((i - 1) / 2)
		local f = box(panel, UDim2.new(0, 262, 0, 40), UDim2.new(0, 12 + col * 270, 0, 82 + row * 46), Color3.fromHex(hex):Lerp(WHITE, 0.2), Color3.fromHex(hex):Lerp(DARK, 0.45), 10)
		text(f, name, UDim2.new(0.6, 0, 0.6, 0), UDim2.new(0, 8, 0, 0), 16, WHITE, Enum.TextXAlignment.Left).TextScaled = true
		text(f, rar, UDim2.new(0.6, 0, 0.4, 0), UDim2.new(0, 8, 0.58, 0), 11, YELLOW1, Enum.TextXAlignment.Left)
		text(f, pct .. "%", UDim2.new(0.38, 0, 1, 0), UDim2.new(0.6, 0, 0, 0), 22, WHITE, Enum.TextXAlignment.Right)
	end
end

local function openShop()
	local panel = modal(root, "SHOP", 620, 440, RED1, RED2)
	rows(panel, {
		upRow("W", "Walk Speed", "Speed", "speed", "Run faster", BLUE1, BLUE2),
		upRow("L", "Lick Speed", "LickSpeed", "lickspeed", "Lick faster", ORANGE1, ORANGE2),
		upRow("*", "Lucky Lick", "Lucky", "lucky", "Chance for double goo", PINK1, PINK2),
		{ icon = "?", title = "Skin Roll", c1 = PURPLE1, c2 = PURPLE2,
			desc = function()
				local fr = player:GetAttribute("FreeRolls") or 0
				return fr &gt; 0 and (fr .. " free roll(s) ready!") or "Roll a random tongue skin"
			end,
			cost = function()
				if (player:GetAttribute("FreeRolls") or 0) &gt; 0 then return "FREE" end
				return "G " .. fmt(player:GetAttribute("FreeCost") or 0)
			end,
			buy = function() remotes.BuySkin:FireServer() end },
		{ icon = "%", title = "Skin Odds", c1 = CYAN1, c2 = CYAN2, desc = function() return "See the exact chance of every skin" end, cost = function() return "SEE ALL" end, buy = openOdds },
	}, 58)
end

local function openRebirth()
	local panel = modal(root, "REBIRTH", 520, 420, PINK1, PINK2)
	local R = stats.Rebirths.Value
	local need = math.min(MAXLV, 100 + 10 * R)
	local bonus = (player:GetAttribute("RebirthBonus") or 0.5) * 100
	local lines = { "Rebirths so far: " .. R, "Goo bonus: +" .. math.floor(R * bonus) .. "% (+" .. bonus .. "% per rebirth)", "Next rebirth needs Level " .. need .. "  (you are Level " .. stats.Tongue.Value .. ")", "Resets your level and goo. You KEEP zones, upgrades, skins, cosmetics, passes and quests." }
	for i, l in ipairs(lines) do
		local r = box(panel, UDim2.new(1, -24, 0, 54), UDim2.new(0, 12, 0, 58 + (i - 1) * 60), i % 2 == 1 and GREEN1 or BLUE1, i % 2 == 1 and GREEN2 or BLUE2, 10, true)
		local t = text(r, l, UDim2.new(1, -16, 1, 0), UDim2.new(0, 8, 0, 0), 18)
		t.TextScaled = true
		t.TextWrapped = true
	end
	local armed = false
	local b = button(panel, stats.Tongue.Value &gt;= need and "REBIRTH NOW" or ("NEED LEVEL " .. need), UDim2.new(0, 280, 0, 52), UDim2.new(0.5, -140, 1, -66), PINK1, PINK2, 24)
	b.Activated:Connect(function()
		if stats.Tongue.Value &lt; need then return end
		if not armed then
			armed = true
			b.Text = "TAP AGAIN TO CONFIRM"
			task.delay(4, function() armed = false if b.Parent then b.Text = "REBIRTH NOW" end end)
		else
			remotes.Rebirth:FireServer()
			local m = root:FindFirstChild("LickModal")
			if m then m:Destroy() end
		end
	end)
end

local function jd(name)
	local v = sf:FindFirstChild(name)
	local ok, t = pcall(function() return game:GetService("HttpService"):JSONDecode(v and v.Value or "{}") end)
	return ok and type(t) == "table" and t or {}
end
local function openDaily()
	local panel = modal(root, "DAILY LOGIN", 600, 330, YELLOW1, YELLOW2)
	local d = jd("Login")
	local today = math.floor(os.time() / 86400)
	local streak = d.streak or 0
	local can = d.last ~= today
	text(panel, "Streak: " .. streak .. " day(s)", UDim2.new(1, 0, 0, 30), UDim2.new(0, 0, 0, 54), 24)
	local cyc = (can and streak or streak - 1) % 7
	if not can then cyc = (streak - 1) % 7 + 1 end
	for i = 1, 7 do
		local done = (can and i &lt;= cyc) or (not can and i &lt;= cyc)
		local f = box(panel, UDim2.new(0, 76, 0, 100), UDim2.new(0, 14 + (i - 1) * 82, 0, 96), done and GREEN1 or Color3.fromRGB(150, 140, 200), done and GREEN2 or Color3.fromRGB(70, 60, 130), 12, true)
		text(f, "Day " .. i, UDim2.new(1, 0, 0, 24), UDim2.new(0, 0, 0, 4), 16)
		text(f, i == 7 and "BIG!" or ((i == 4 or i == 6) and "+" or "G"), UDim2.new(1, 0, 0, 40), UDim2.new(0, 0, 0, 34), 28)
	end
	local b = button(panel, can and "CLAIM TODAY'S REWARD" or "COME BACK TOMORROW", UDim2.new(0, 340, 0, 52), UDim2.new(0.5, -170, 1, -66), can and GREEN1 or Color3.fromRGB(130, 130, 160), can and GREEN2 or Color3.fromRGB(70, 70, 100), 20)
	b.Activated:Connect(function()
		if can then
			remotes.ClaimLogin:FireServer()
			local m = root:FindFirstChild("LickModal")
			if m then m:Destroy() end
		end
	end)
end

menuEv.Event:Connect(function(name)
	if name == "shop" then openShop() elseif name == "rebirth" then openRebirth() elseif name == "daily" then openDaily() end
end)
remotes.OpenShop.OnClientEvent:Connect(openShop)
print("[LickPanels] ready")
