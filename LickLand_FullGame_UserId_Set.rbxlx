lbl.BackgroundTransparency = 1
lbl.Font = Enum.Font.FredokaOne
lbl.TextScaled = true
lbl.TextColor3 = Color3.new(1, 1, 1)
lbl.TextStrokeColor3 = Color3.fromRGB(25, 12, 60)
lbl.TextStrokeTransparency = 0
lbl.Parent = gui
