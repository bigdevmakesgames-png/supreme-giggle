            <string name="Name">LickAudio</string>
            <ProtectedString name="Source">-- LICK AUDIO (LocalScript)  Location: StarterPlayer &gt; StarterPlayerScripts &gt; LickAudio
-- The ONE place that plays sound. Uses ONLY your approved sound IDs. Do-Re-Mi combo, voice limiter, loading check.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local ContentProvider = game:GetService("ContentProvider")
local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("LickRemotes")

local IDS = { click = 113397864512278, bell = 8863377426, chime = 158050602, squish = 9120583506, goo = 6787582810, menu = 9119642864 }
local BASE = { click = 0.5, bell = 0.7, chime = 0.7, squish = 0.8, goo = 0.7, menu = 0.7 }
local HIGH = { chime = true, goo = true, bell = false }
local MAX_VOICES = 7
local SCALE = { 1, 1.122, 1.26, 1.335, 1.498, 1.682, 1.888, 2 } -- Do Re Mi Fa Sol La Ti Do

local ev = Instance.new("BindableEvent") -- other scripts fire this: sfx(key, speed, volume)
ev.Name = "LickSfx"
ev.Parent = ReplicatedStorage
local comboEv = Instance.new("BindableEvent") -- tells the HUD which note you are on
comboEv.Name = "LickCombo"
comboEv.Parent = ReplicatedStorage

local pools = {}
local all = {}
for key, id in pairs(IDS) do
	pools[key] = {}
	for i = 1, 3 do
		local s = Instance.new("Sound")
		s.Name = "Lick_" .. key
		s.SoundId = "rbxassetid://" .. id
		s.Volume = BASE[key]
		s.Parent = SoundService
		pools[key][i] = s
		all[#all + 1] = s
	end
end

-- check the approved sounds actually load (the result is printed in Output so you can see it)
task.spawn(function()
	pcall(function() ContentProvider:PreloadAsync(all) end)
	task.wait(1)
	local failed = {}
	for key, p in pairs(pools) do
		if not (p[1].IsLoaded and p[1].TimeLength &gt; 0) then failed[#failed + 1] = key end
	end
	if #failed == 0 then
		print("[LickAudio] all 6 approved sounds loaded")
	else
		warn("[LickAudio] these sounds did NOT load: " .. table.concat(failed, ", ") .. " (check the audio permissions in Creator Hub)")
	end
end)

local function master()
	return player:GetAttribute("SfxVol") or 1
end

local function play(key, speed, vol)
	local pool = pools[key]
	if not pool then return end
	local active = 0
	for _, s in ipairs(all) do
		if s.Playing then active = active + 1 end
	end
	if active &gt;= MAX_VOICES and not HIGH[key] then return end
	local s
	for _, c in ipairs(pool) do
		if not c.Playing then
			s = c
			break
		end
	end
	s = s or pool[1]
	s.PlaybackSpeed = speed or 1
	s.Volume = (vol or 1) * BASE[key] * master()
	s:Play()
end
ev.Event:Connect(play)

local function arpeggio(key, notes, gap, vol)
	task.spawn(function()
		for _, n in ipairs(notes) do
			play(key, SCALE[n], vol)
			task.wait(gap)
		end
	end)
end

-- ===== Do-Re-Mi: every bite in a row climbs the scale =====
local note, lastBite = 0, 0
remotes.Eat.OnClientEvent:Connect(function(model, bite, total, finished, gain, lucky)
	local now = os.clock()
	if now - lastBite &gt; 1.6 then note = 0 end
	lastBite = now
	note = math.min(note + 1, #SCALE)
	comboEv:Fire(note)
	play("squish", 0.92 + math.random() * 0.2, 0.7)
	play("bell", SCALE[note], 0.9)
	if finished then
		task.delay(0.12, function() play("goo", 1 + note * 0.03, 1) end)
		arpeggio("bell", { 3, 5, 8 }, 0.09, 0.8)
	end
	if lucky then task.delay(0.2, function() play("chime", 1.4, 0.9) end) end
end)

-- other players nearby: one very quiet tick
local lastTick = 0
remotes.LickFx.OnClientEvent:Connect(function()
	if os.clock() - lastTick &gt; 0.35 then
		lastTick = os.clock()
		play("squish", 1.1, 0.25)
	end
end)

-- text messages from the server carry a sound name
local MAP = { error = { "click", 0.7, 0.8 }, click = { "click", 1, 1 }, chime = { "chime", 1.1, 0.8 }, claim = { "goo", 1, 1 }, upgrade = { "chime", 1.25, 0.9 }, unlock = { "chime", 1.5, 1 }, lick = { "bell", 1, 0.4 } }
remotes.Notify.OnClientEvent:Connect(function(text, key)
	local m = key and MAP[key]
	if m then play(m[1], m[2], m[3]) end
end)

-- celebrations: bigger achievements = more notes and higher pitch
remotes.Celebrate.OnClientEvent:Connect(function(kind, a, b)
	if kind == "level" then
		arpeggio("bell", { 1, 3, 5 }, 0.08, 0.9)
		play("goo", 1.1, 0.7)
	elseif kind == "reward" then
		play("goo", 1, math.clamp(0.5 + (tonumber(a) or 0) / 1e9, 0.5, 1))
	elseif kind == "quest" or kind == "achievement" or kind == "flavor" then
		arpeggio("chime", { 1, 3, 5 }, 0.1, 0.9)
	elseif kind == "zone" or kind == "world" or kind == "feature" then
		arpeggio("bell", { 1, 3, 5, 8 }, 0.1, 1)
		task.delay(0.5, function() play("chime", 1.5, 1) end)
	elseif kind == "rebirth" then
		arpeggio("bell", { 1, 2, 3, 4, 5, 6, 7, 8 }, 0.07, 1)
		task.delay(0.7, function() play("chime", 2, 1) play("goo", 1.3, 1) end)
	elseif kind == "announce" then
		play("chime", 1.3, 0.6)
	end
end)
print("[LickAudio] ready")
