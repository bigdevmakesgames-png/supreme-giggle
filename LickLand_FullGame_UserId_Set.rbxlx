            <ProtectedString name="Source">-- LICK MENUS (LocalScript)  Location: StarterPlayer &gt; StarterPlayerScripts &gt; LickMenus
-- Redeem Codes, Settings, and the global Leaderboards + Top Donators screen.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local function errBanner(msg)
	local pg = player:WaitForChild("PlayerGui")
	if pg:FindFirstChild("LickError") then return end
	local g = Instance.new("ScreenGui")
	g.Name = "LickError"
	g.ResetOnSpawn = false
	g.DisplayOrder = 500
	g.Parent = pg
	local t = Instance.new("TextLabel")
	t.Size = UDim2.new(0.8, 0, 0.3, 0)
	t.Position = UDim2.new(0.1, 0, 0.35, 0)
	t.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextScaled = true
	t.TextWrapped = true
	t.Font = Enum.Font.FredokaOne
	t.Text = msg
	t.Parent = g
end
local remotes = ReplicatedStorage:WaitForChild("LickRemotes", 20)
if not remotes then
	errBanner("LICK ERROR: the LickData script is not running. It must be a Script in ServerScriptService. Check the Output window.")
	return
end
local sfxEv = ReplicatedStorage:WaitForChild("LickSfx", 20)
if not sfxEv then
	errBanner("LICK ERROR: the LickAudio LocalScript is missing (StarterPlayer &gt; StarterPlayerScripts).")
	return
end
local function sfx(key, speed, vol) sfxEv:Fire(key, speed, vol) end
local FONT = Enum.Font.FredokaOne
local WHITE = Color3.new(1, 1, 1)
local DARK = Color3.fromRGB(10, 10, 40)
local BLUE1, BLUE2 = Color3.fromRGB(60, 160, 255), Color3.fromRGB(20, 80, 200)
local GREEN1, GREEN2 = Color3.fromRGB(90, 230, 90), Color3.fromRGB(30, 150, 40)
local ORANGE1, ORANGE2 = Color3.fromRGB(255, 190, 60), Color3.fromRGB(230, 110, 20)
local PINK1, PINK2 = Color3.fromRGB(255, 110, 200), Color3.fromRGB(190, 40, 150)
local PURPLE1, PURPLE2 = Color3.fromRGB(170, 90, 255), Color3.fromRGB(90, 40, 200)
local RED1, RED2 = Color3.fromRGB(255, 90, 90), Color3.fromRGB(190, 30, 30)
local YELLOW1, YELLOW2 = Color3.fromRGB(255, 240, 100), Color3.fromRGB(240, 165, 20)
local CYAN1, CYAN2 = Color3.fromRGB(100, 255, 240), Color3.fromRGB(20, 160, 190)
local LIME1, LIME2 = Color3.fromRGB(180, 255, 100), Color3.fromRGB(60, 170, 40)
local function fmt(n)
	n = math.floor(n or 0)
	if n &lt; 1000 then return tostring(n) end
	local suf = { "K", "M", "B", "T", "Qa", "Qi" }
	local i, v = 0, n
	while v &gt;= 1000 and i &lt; #suf do
		v = v / 1000
		i = i + 1
	end
	if v &lt; 10 then return string.format("%.2f%s", v, suf[i]) end
	if v &lt; 100 then return string.format("%.1f%s", v, suf[i]) end
	return string.format("%.0f%s", v, suf[i])
end
local function corner(p, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 12)
	c.Parent = p
end
local function stroke(p, color, th)
	local s = Instance.new("UIStroke")
	s.Color = color or DARK
	s.Thickness = th or 3
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = p
end
local function gradient(p, c1, c2, rot)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(c1, c2)
	g.Rotation = rot or 90
	g.Parent = p
	return g
end
local shines = {}
local function gloss(f, r)
	local g = Instance.new("Frame")
	g.Size = UDim2.new(1, -8, 0.48, 0)
	g.Position = UDim2.new(0, 4, 0, 3)
	g.BackgroundColor3 = WHITE
	g.BorderSizePixel = 0
	g.Parent = f
	corner(g, r or 10)
	local gr = Instance.new("UIGradient")
	gr.Rotation = 90
	gr.Transparency = NumberSequence.new(0.35, 0.85)
	gr.Parent = g
	local dot = Instance.new("Frame")
	dot.Size = UDim2.new(0, 7, 0, 7)
	dot.Position = UDim2.new(0, 10, 0, 7)
	dot.BackgroundColor3 = WHITE
	dot.BackgroundTransparency = 0.15
	dot.BorderSizePixel = 0
	dot.Parent = f
	corner(dot, 4)
	local clip = Instance.new("Frame")
	clip.Size = UDim2.new(1, 0, 1, 0)
	clip.BackgroundTransparency = 1
	clip.ClipsDescendants = true
	clip.Parent = f
	local st = Instance.new("Frame")
	st.Size = UDim2.new(0.18, 0, 1.6, 0)
	st.Position = UDim2.new(-0.4, 0, -0.3, 0)
	st.Rotation = 20
	st.BackgroundColor3 = WHITE
	st.BackgroundTransparency = 0.7
	st.BorderSizePixel = 0
	st.Parent = clip
	shines[#shines + 1] = st
end
local function box(parent, size, pos, c1, c2, r, shiny)
	local f = Instance.new("Frame")
	f.Size = size
	f.Position = pos
	f.BackgroundColor3 = WHITE
	f.BorderSizePixel = 0
	f.Parent = parent
	corner(f, r or 12)
	stroke(f)
	gradient(f, c1, c2 or c1)
	if shiny then gloss(f, (r or 12) - 2) end
	return f
end
local function text(parent, str, size, pos, ts, color, ax)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = size
	l.Position = pos
	l.Font = FONT
	l.Text = str
	l.TextSize = ts
	l.TextColor3 = color or WHITE
	l.TextStrokeColor3 = DARK
	l.TextStrokeTransparency = 0
	l.TextXAlignment = ax or Enum.TextXAlignment.Center
	l.Parent = parent
	return l
end
local function bounce(sc, from)
	sc.Scale = from or 0.85
	TweenService:Create(sc, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end
local function popIn(obj)
	local sc = Instance.new("UIScale")
	sc.Scale = 0.6
	sc.Parent = obj
	TweenService:Create(sc, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end
local function button(parent, str, size, pos, c1, c2, ts, idle)
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Size = size
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.new(pos.X.Scale + size.X.Scale * 0.5, pos.X.Offset + size.X.Offset * 0.5, pos.Y.Scale + size.Y.Scale * 0.5, pos.Y.Offset + size.Y.Offset * 0.5)
	holder.Parent = parent
	local pop = Instance.new("UIScale")
	pop.Parent = holder
	local wrap = Instance.new("Frame")
	wrap.BackgroundTransparency = 1
	wrap.Size = UDim2.new(1, 0, 1, 0)
	wrap.Parent = holder
	if idle then
		local ps = Instance.new("UIScale")
		ps.Parent = wrap
		TweenService:Create(ps, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = 1.07 }):Play()
	end
	local vis = box(wrap, UDim2.new(1, 0, 1, 0), UDim2.new(0, 0, 0, 0), c1, c2, nil, true)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 1, 0)
	b.BackgroundTransparency = 1
	b.Font = FONT
	b.Text = str
	b.TextSize = ts or 22
	b.TextColor3 = WHITE
	b.TextStrokeColor3 = DARK
	b.TextStrokeTransparency = 0
	b.ZIndex = 2
	b.Parent = wrap
	b.Activated:Connect(function()
		sfx("click")
		bounce(pop, 0.85)
	end)
	return b, holder, vis
end
task.spawn(function()
	while true do
		task.wait(2.8)
		for i = #shines, 1, -1 do
			local s = shines[i]
			if not s:IsDescendantOf(game) then
				table.remove(shines, i)
			else
				task.delay(math.random() * 0.8, function()
					if s:IsDescendantOf(game) then
						s.Position = UDim2.new(-0.4, 0, -0.3, 0)
						TweenService:Create(s, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Position = UDim2.new(1.2, 0, -0.3, 0) }):Play()
					end
				end)
			end
		end
	end
end)
local function getRoot()
	return player:WaitForChild("PlayerGui"):WaitForChild("LickUI"):WaitForChild("Root")
end
local function modal(root, titleStr, w, h, c1, c2)
	local old = root:FindFirstChild("LickModal")
	if old then old:Destroy() end
	local bd = Instance.new("TextButton")
	bd.Name = "LickModal"
	bd.Size = UDim2.new(1, 0, 1, 0)
	bd.BackgroundColor3 = Color3.new(0, 0, 0)
	bd.BackgroundTransparency = 0.5
	bd.Text = ""
	bd.AutoButtonColor = false
	bd.ZIndex = 10
	bd.Parent = root
	bd.Activated:Connect(function() bd:Destroy() end)
	local panel = box(bd, UDim2.new(0, w, 0, h), UDim2.new(0.5, 0, 0.5, 0), Color3.fromRGB(70, 100, 230), Color3.fromRGB(30, 40, 130), 16)
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Active = true
	popIn(panel)
	local head = box(panel, UDim2.new(1, 0, 0, 48), UDim2.new(0, 0, 0, 0), c1 or YELLOW1, c2 or YELLOW2, 16, true)
	text(head, titleStr, UDim2.new(1, -70, 1, 0), UDim2.new(0, 16, 0, 0), 28, WHITE, Enum.TextXAlignment.Left)
	local xb = button(head, "X", UDim2.new(0, 36, 0, 34), UDim2.new(1, -44, 0, 7), RED1, RED2, 20)
	xb.Activated:Connect(function() bd:Destroy() end)
	sfx("menu")
	return panel, bd
end

local CFGF = ReplicatedStorage:WaitForChild("LickConfig")
local function csv(name)
	local t = {}
	for n in string.gmatch(CFGF:WaitForChild(name).Value, "[^,]+") do t[#t + 1] = tonumber(n) end
	return t
end
local COSTS, ZL, ZV = csv("LevelCosts"), csv("ZoneLevels"), csv("ZoneValues")
local ZN, WN = {}, {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
for n in string.gmatch(CFGF:WaitForChild("WorldNames").Value, "[^|]+") do WN[#WN + 1] = n end
local NW = #WN
local ZN = {}
for n in string.gmatch(CFGF:WaitForChild("ZoneNames").Value, "[^|]+") do ZN[#ZN + 1] = n end
local MAXLV = CFGF:GetAttribute("MaxLevel") or 400
local LPM = CFGF:GetAttribute("LPM") or 150
local function zoneOf(level)
	local z = 1
	for i = 1, #ZL do
		if level &gt;= ZL[i] then z = i end
	end
	return z
end
local function worldOf(x) return math.clamp(math.floor((x + 1000) / 2000) + 1, 1, NW) end
local function zoneAt(x, z)
	local w = worldOf(x)
	local col = math.clamp(math.floor((x - (w - 1) * 2000 + 640) / 320), 0, 3)
	local k = 8 - col
	if z &lt; 0 then k = col + 1 end
	return (w - 1) * 8 + k
end

local HttpService = game:GetService("HttpService")
local root = getRoot()
local menuEv = ReplicatedStorage:WaitForChild("LickMenu")
local sf = player:WaitForChild("LickState")

local settings = { sfx = 1, fx = 3 }
task.spawn(function()
	local v = sf:WaitForChild("Settings", 10)
	if v then
		local ok, t = pcall(function() return HttpService:JSONDecode(v.Value) end)
		if ok and type(t) == "table" then
			settings.sfx = t.sfx or 1
			settings.fx = t.fx or 3
		end
	end
	player:SetAttribute("SfxVol", settings.sfx)
	player:SetAttribute("FxQuality", settings.fx)
end)
local function applySettings()
	player:SetAttribute("SfxVol", settings.sfx)
	player:SetAttribute("FxQuality", settings.fx)
	remotes.SaveSettings:FireServer(HttpService:JSONEncode(settings))
end

local function openSettings()
	local panel = modal(root, "SETTINGS", 520, 440, LIME1, LIME2)
	local function row(i, label, getter, onTap)
		local r = box(panel, UDim2.new(1, -24, 0, 54), UDim2.new(0, 12, 0, 58 + (i - 1) * 62), BLUE1, BLUE2, 10, true)
		text(r, label, UDim2.new(0.5, 0, 1, 0), UDim2.new(0, 12, 0, 0), 20, WHITE, Enum.TextXAlignment.Left)
		local b = button(r, getter(), UDim2.new(0, 190, 0, 40), UDim2.new(1, -202, 0, 7), GREEN1, GREEN2, 18)
		b.Activated:Connect(function() onTap() b.Text = getter() end)
	end
	row(1, "Sound volume", function() return ({ [1] = "Loud", [0.6] = "Medium", [0.3] = "Quiet", [0] = "Off" })[settings.sfx] or "Loud" end, function()
		settings.sfx = ({ [1] = 0.6, [0.6] = 0.3, [0.3] = 0, [0] = 1 })[settings.sfx] or 1
		applySettings()
	end)
	row(2, "Effects quality", function() return ({ "Low", "Medium", "High" })[settings.fx] end, function()
		settings.fx = settings.fx % 3 + 1
		applySettings()
	end)
	row(3, "Tutorial", function() return "SHOW AGAIN" end, function() remotes.TutorialAction:FireServer("replay") end)
	local ls = player:GetAttribute("LastSave") or os.time()
	text(panel, "Saved " .. math.max(0, os.time() - ls) .. "s ago  |  " .. (player:GetAttribute("SaveOk") == false and "SAVE PROBLEM" or "Data OK"), UDim2.new(1, -20, 0, 24), UDim2.new(0, 10, 0, 250), 16, Color3.fromRGB(190, 255, 200))
	text(panel, "Controls: tap food, hold the LICK button, or press E.\nUse the side buttons for Shop, Quests, Codes and more.\nTutorial: tap SHOW AGAIN, then rejoin.", UDim2.new(1, -30, 0, 80), UDim2.new(0, 15, 0, 285), 15).TextWrapped = true
end

local function openCodes()
	local panel = modal(root, "REDEEM CODE", 520, 300, PURPLE1, PURPLE2)
	text(panel, "Type a code from our updates:", UDim2.new(1, 0, 0, 26), UDim2.new(0, 0, 0, 60), 20)
	local tb = Instance.new("TextBox")
	tb.Size = UDim2.new(0, 400, 0, 52)
	tb.Position = UDim2.new(0.5, -200, 0, 96)
	tb.BackgroundColor3 = WHITE
	tb.Font = FONT
	tb.TextSize = 26
	tb.PlaceholderText = "ENTER CODE"
	tb.Text = ""
	tb.TextColor3 = DARK
	tb.ClearTextOnFocus = false
	tb.Parent = panel
	corner(tb, 12)
	stroke(tb)
	local msg = text(panel, "", UDim2.new(1, -20, 0, 28), UDim2.new(0, 10, 0, 156), 18)
	local go = button(panel, "REDEEM", UDim2.new(0, 220, 0, 52), UDim2.new(0.5, -110, 0, 200), GREEN1, GREEN2, 26)
	go.Activated:Connect(function()
		local ok, good, m = pcall(function() return remotes.RedeemCode:InvokeServer(tb.Text) end)
		if not ok then msg.Text = "Could not reach the server." msg.TextColor3 = RED1 return end
		msg.Text = m or ""
		msg.TextColor3 = good and Color3.fromRGB(120, 255, 150) or Color3.fromRGB(255, 130, 130)
		if good then tb.Text = "" end
	end)
end

local BT = { { "goo", "Goo" }, { "licks", "Licks" }, { "level", "Level" }, { "rebirths", "Rebirths" }, { "quests", "Quests" }, { "donors", "Donators" } }
local cur = "goo"
local function openBoards()
	local panel = modal(root, "GLOBAL LEADERBOARDS", 700, 480, ORANGE1, ORANGE2)
	for i, t in ipairs(BT) do
		local b = button(panel, t[2], UDim2.new(0, 104, 0, 34), UDim2.new(0, 10 + (i - 1) * 110, 0, 54), cur == t[1] and YELLOW1 or Color3.fromRGB(120, 130, 210), cur == t[1] and YELLOW2 or Color3.fromRGB(60, 65, 140), 16)
		b.Activated:Connect(function() cur = t[1] openBoards() end)
	end
	local status = text(panel, "Loading...", UDim2.new(1, 0, 0, 24), UDim2.new(0, 0, 0, 96), 16)
	task.spawn(function()
		local ok, data = pcall(function() return remotes.BoardData:InvokeServer(cur) end)
		if not panel.Parent then return end
		if not ok or not data then status.Text = "Board is not ready yet. Try again in a moment." return end
		local unit = cur == "donors" and " R$" or ""
		status.Text = (cur == "donors" and "Total Robux donated. " or "") .. "You: " .. fmt(data.mine or 0) .. unit .. (data.rank and ("   (rank #" .. data.rank .. ")") or "") .. (data.updated &gt; 0 and ("   updated " .. math.max(0, os.time() - data.updated) .. "s ago") or "")
		for i = 1, 7 do
			local e = data.list[i]
			local gold = i == 1 and Color3.fromRGB(255, 215, 0) or i == 2 and Color3.fromRGB(215, 215, 235) or i == 3 and Color3.fromRGB(230, 150, 90) or nil
			local row = box(panel, UDim2.new(1, -24, 0, 46), UDim2.new(0, 12, 0, 124 + (i - 1) * 50), gold and gold:Lerp(WHITE, 0.2) or BLUE1, gold and gold:Lerp(DARK, 0.3) or BLUE2, 10, true)
			text(row, (i == 1 and "1st" or i == 2 and "2nd" or i == 3 and "3rd" or ("#" .. i)), UDim2.new(0, 56, 1, 0), UDim2.new(0, 6, 0, 0), i &lt;= 3 and 22 or 18, i &lt;= 3 and DARK or WHITE)
			if e then
				local img = Instance.new("ImageLabel")
				img.Size = UDim2.new(0, 38, 0, 38)
				img.Position = UDim2.new(0, 64, 0, 4)
				img.BackgroundColor3 = DARK
				img.Parent = row
				corner(img, 19)
				task.spawn(function()
					local okI, url = pcall(function() return Players:GetUserThumbnailAsync(e.id, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100) end)
					if okI and img.Parent then img.Image = url end
				end)
				text(row, e.name, UDim2.new(0.5, -60, 1, 0), UDim2.new(0, 110, 0, 0), 20, i &lt;= 3 and DARK or WHITE, Enum.TextXAlignment.Left).TextScaled = true
				text(row, fmt(e.value) .. unit, UDim2.new(0.3, 0, 1, 0), UDim2.new(0.7, -10, 0, 0), 22, i &lt;= 3 and DARK or YELLOW1, Enum.TextXAlignment.Right)
			else
				text(row, "---", UDim2.new(0.5, 0, 1, 0), UDim2.new(0, 110, 0, 0), 18, Color3.fromRGB(190, 190, 230), Enum.TextXAlignment.Left)
			end
		end
	end)
end

menuEv.Event:Connect(function(name)
	if name == "settings" then openSettings() elseif name == "codes" then openCodes() elseif name == "boards" then openBoards() end
end)
print("[LickMenus] ready")
</ProtectedString>
