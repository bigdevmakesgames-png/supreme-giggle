local YELLOW1, YELLOW2 = Color3.fromRGB(255, 240, 100), Color3.fromRGB(240, 165, 20)
local CYAN1, CYAN2 = Color3.fromRGB(100, 255, 240), Color3.fromRGB(20, 160, 190)
