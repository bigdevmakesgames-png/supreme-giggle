local function setBadge(f, l, str, ok)
	l.Text = str
	f:FindFirstChildOfClass("UIGradient").Color = ColorSequence.new(ok and GREEN1 or RED1, ok and GREEN2 or RED2)
end
local function refresh()
	local lv, goo = Tongue.Value, Goo.Value
	gooLbl.Text = fmt(goo)
	lvLbl.Text = "Level " .. lv
	if lv &gt;= MAXLV then
		fill.Size = UDim2.new(1, 0, 1, 0)
		costLbl.Text = "MAX LEVEL"
		setBadge(bd1, bl1, "MAX", true) setBadge(bd5, bl5, "MAX", true) setBadge(bdm, blm, "MAX", true)
		return
	end
	local c = COSTS[lv]
	fill.Size = UDim2.new(math.clamp(goo / c, 0, 1), 0, 1, 0)
	costLbl.Text = fmt(goo) .. " / " .. fmt(c)
	local sum, l = 0, lv
	for _ = 1, 5 do
		if l &gt;= MAXLV then break end
		sum = sum + COSTS[l]
		l = l + 1
	end
	local g, ml, n = goo, lv, 0
	while ml &lt; MAXLV and n &lt; 100 and g &gt;= COSTS[ml] do
		g = g - COSTS[ml]
		ml = ml + 1
		n = n + 1
	end
	setBadge(bd1, bl1, fmt(c), goo &gt;= c)
	setBadge(bd5, bl5, fmt(sum), goo &gt;= sum)
	setBadge(bdm, blm, "x" .. n, n &gt; 0)
end
Goo.Changed:Connect(refresh)
Tongue.Changed:Connect(refresh)
refresh()

